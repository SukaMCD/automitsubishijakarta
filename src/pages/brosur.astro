---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { carsData } from '../data/cars';
import { salesData, getWhatsAppLink } from '../data/sales';

const passengerCars = carsData.filter(c => c.segment === 'passenger');
const lcvCars = carsData.filter(c => c.segment === 'lcv');
const commercialCars = carsData.filter(c => c.segment === 'commercial');

const waGeneralBrochure = getWhatsAppLink(
  'Halo Kanhadi, saya ingin meminta katalog e-brochure PDF resmi mobil Mitsubishi Jakarta beserta update pricelist & promo diskon terbaru.'
);
---

<Layout
  title="Unduh E-Brochure Mobil & Truk Mitsubishi Jakarta 2026 | Kanhadi"
  description="Download e-brochure PDF resmi mobil Mitsubishi Jakarta 2026. Xpander, Pajero Sport, Xforce, Destinator, Triton, L300, dan Truk Canter Fuso. Dapatkan katalog spesifikasi lengkap & promo."
  currentPath="/brosur"
>
  <!-- Hero Section -->
  <section class="bg-[#1A1C1E] text-white py-12 md:py-18 border-b border-white/10">
    <div class="max-w-360 mx-auto px-4 sm:px-6">
      
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-wider text-[#A6A9AB] mb-4">
        <a href="/" class="hover:text-white transition-colors">Beranda</a>
        <span>/</span>
        <span class="text-brand-red">Unduh Brosur</span>
      </nav>

      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="max-w-3xl">
          <span class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-red block mb-2">
            E-Brochure &amp; Katalog Resmi 2026
          </span>
          <h1 class="text-3xl md:text-5xl font-black tracking-tight leading-tight">
            Unduh Brosur Mobil &amp; Truk Mitsubishi
          </h1>
          <p class="text-[#A6A9AB] text-sm md:text-base leading-relaxed mt-3">
            Dapatkan katalog e-brochure resmi format PDF berkualitas tinggi lengkap dengan spesifikasi teknis, fitur keselamatan, interior-eksterior, varian warna, dan paket cicilan resmi dari dealer PT Lautan Berlian Kebon Jeruk.
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <a
            href={waGeneralBrochure}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-brand-red hover:bg-brand-red-dark text-white font-bold text-xs uppercase tracking-wider px-5 py-3 transition-colors shadow-lg"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            Minta Semua Brosur
          </a>
          <a
            href="/pricelist"
            class="inline-flex items-center gap-2 border border-white/30 hover:border-white text-white font-bold text-xs uppercase tracking-wider px-5 py-3 transition-colors"
          >
            Lihat Daftar Harga
          </a>
        </div>
      </div>

      <!-- Controls: Search & Category Tabs -->
      <div class="mt-8 pt-6 border-t border-white/10 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
        <!-- Filter Tabs -->
        <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-2">
          <button
            type="button"
            class="brochure-tab-btn active px-4 py-2.5 text-xs font-bold uppercase tracking-wider transition-all bg-brand-red text-white cursor-pointer text-center"
            data-filter="all"
          >
            Semua ({carsData.length})
          </button>
          <button
            type="button"
            class="brochure-tab-btn px-4 py-2.5 text-xs font-bold uppercase tracking-wider transition-all bg-anthracite text-[#A6A9AB] hover:text-white cursor-pointer text-center"
            data-filter="passenger"
          >
            Mobil Penumpang ({passengerCars.length})
          </button>
          <button
            type="button"
            class="brochure-tab-btn px-4 py-2.5 text-xs font-bold uppercase tracking-wider transition-all bg-anthracite text-[#A6A9AB] hover:text-white cursor-pointer text-center"
            data-filter="lcv"
          >
            Niaga Ringan ({lcvCars.length})
          </button>
          <button
            type="button"
            class="brochure-tab-btn px-4 py-2.5 text-xs font-bold uppercase tracking-wider transition-all bg-anthracite text-[#A6A9AB] hover:text-white cursor-pointer text-center"
            data-filter="commercial"
          >
            Truk &amp; Bus ({commercialCars.length})
          </button>
        </div>

        <!-- Search Input -->
        <div class="relative w-full md:w-72">
          <input
            type="text"
            id="brochure-search"
            placeholder="Cari model mobil..."
            class="w-full bg-[#111315] border border-white/20 focus:border-brand-red text-white placeholder-[#777] text-xs px-4 py-2.5 pr-9 outline-none transition-colors"
          />
          <svg class="w-4 h-4 text-[#777] absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
      </div>

    </div>
  </section>

  <!-- Brochure Grid Section -->
  <main class="py-10 sm:py-16 md:py-20 bg-off-white">
    <div class="max-w-360 mx-auto px-4 sm:px-6">

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8" id="brochure-grid">
        {carsData.map((car, idx) => {
          const carWaUrl = getWhatsAppLink(
            `Halo Kanhadi, saya ingin meminta e-brochure PDF resmi Mitsubishi ${car.name}. Boleh tolong dikirimkan ke nomor ini beserta info promo terbarunya? Terima kasih!`
          );

          return (
            <article
              class="brochure-card group bg-white border border-concrete hover:border-brand-red transition-all duration-300 flex flex-col justify-between overflow-hidden shadow-sm hover:shadow-md"
              data-segment={car.segment}
              data-name={car.name.toLowerCase()}
              data-category={car.category.toLowerCase()}
            >
              <!-- Card Top -->
              <div>
                <!-- Top Badges -->
                <div class="p-4 sm:p-5 pb-3 flex items-center justify-between border-b border-[#F0F0F0]">
                  <span class={`text-[10px] font-black uppercase tracking-wider ${car.segment === 'commercial' ? 'text-[#D97706]' : 'text-cold-grey'}`}>
                    {car.category}
                  </span>
                  {car.badge ? (
                    <span class={`text-[10px] font-bold px-2 py-0.5 leading-none text-white ${car.segment === 'commercial' ? 'bg-anthracite' : 'bg-brand-red'}`}>
                      {car.badge}
                    </span>
                  ) : (
                    <span class="text-[10px] font-semibold text-[#888] bg-[#F3F4F6] px-2 py-0.5 rounded">
                      EDISI 2026
                    </span>
                  )}
                </div>

                <!-- Car Image Showcase -->
                <div class="p-4 sm:p-6 bg-[#FAFAFA] flex items-center justify-center border-b border-[#F0F0F0] relative overflow-hidden">
                  <div class="h-36 sm:h-44 w-full flex items-center justify-center">
                    <Image
                      src={car.image}
                      alt={`Brosur ${car.name}`}
                      width={380}
                      height={200}
                      loading={idx < 3 ? 'eager' : 'lazy'}
                      fetchpriority={idx < 3 ? 'high' : 'auto'}
                      decoding="async"
                      class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300 pointer-events-none select-none drop-shadow-sm"
                    />
                  </div>

                  <!-- PDF Indicator Badge -->
                  <div class="absolute bottom-2.5 right-3 bg-black/75 backdrop-blur-sm text-white text-[9.5px] font-bold px-2 py-0.5 rounded flex items-center gap-1">
                    <svg class="w-3 h-3 text-brand-red" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M10 12h4m-4 4h4"/>
                    </svg>
                    PDF E-Brochure
                  </div>
                </div>

                <!-- Car Meta & Specs -->
                <div class="p-4 sm:p-5">
                  <h2 class="text-base sm:text-lg font-black text-anthracite group-hover:text-brand-red transition-colors tracking-tight">
                    {car.name}
                  </h2>
                  <p class="text-xs text-[#686D71] mt-1 line-clamp-1 italic">
                    &ldquo;{car.tagline}&rdquo;
                  </p>

                  <!-- Specs Badges -->
                  <div class="mt-3 pt-3 border-t border-[#F0F0F0] grid grid-cols-2 gap-2 text-[11px] text-[#555]">
                    <div class="flex items-center gap-1.5 truncate">
                      <span class="text-[#999]">Mesin:</span>
                      <strong class="font-semibold text-anthracite truncate">{car.keySpecs.engine || '-'}</strong>
                    </div>
                    <div class="flex items-center gap-1.5 truncate">
                      <span class="text-[#999]">Transmisi:</span>
                      <strong class="font-semibold text-anthracite truncate">{car.keySpecs.transmission || '-'}</strong>
                    </div>
                    <div class="flex items-center gap-1.5 truncate">
                      <span class="text-[#999]">Kapasitas:</span>
                      <strong class="font-semibold text-anthracite truncate">{car.keySpecs.seating || '-'}</strong>
                    </div>
                    <div class="flex items-center gap-1.5 truncate">
                      <span class="text-[#999]">Mulai:</span>
                      <strong class="font-semibold text-brand-red truncate">{car.startingPrice}</strong>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Card Action Buttons -->
              <div class="p-4 sm:p-5 pt-0 flex flex-col gap-2">
                <a
                  href={`/brochures/${car.slug}.pdf`}
                  download={`Brosur-Mitsubishi-${car.name.replace(/\s+/g, '-')}-2026.pdf`}
                  class="flex items-center justify-center gap-2 bg-brand-red hover:bg-brand-red-dark text-white text-xs font-bold uppercase tracking-wider py-3 px-4 transition-colors duration-200 shadow-sm"
                >
                  <svg class="w-4 h-4 fill-none stroke-current stroke-2 shrink-0" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                  </svg>
                  <span>Unduh Brosur (PDF)</span>
                </a>

                <a
                  href={`/model/${car.slug}`}
                  class="flex items-center justify-center gap-1.5 border border-[#E0E0E0] hover:border-black text-anthracite hover:text-black text-xs font-bold uppercase tracking-wider py-2.5 px-4 transition-colors"
                >
                  <span>Spesifikasi Lengkap</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <!-- No Results State -->
      <div id="no-brochure" class="hidden py-16 text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-[#EBEBEB] text-cold-grey mb-4">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-anthracite">Brosur Tidak Ditemukan</h3>
        <p class="text-sm text-cold-grey mt-1 max-w-md mx-auto">
          Tidak ada mobil yang cocok dengan pencarian Anda. Silakan coba kata kunci lain atau hubungi sales konsultan kami.
        </p>
        <button
          type="button"
          id="reset-filter-btn"
          class="mt-4 inline-flex items-center gap-2 bg-brand-red text-white text-xs font-bold uppercase tracking-wider px-5 py-2.5 transition-colors cursor-pointer"
        >
          Reset Filter &amp; Tampilkan Semua
        </button>
      </div>

      <!-- Information & FAQs Section -->
      <section class="mt-16 sm:mt-24 pt-12 border-t border-concrete">
        <div class="max-w-3xl mx-auto">
          <div class="text-center mb-10">
            <span class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-red block mb-2">Panduan E-Brochure</span>
            <h2 class="text-2xl sm:text-3xl font-black text-anthracite tracking-tight">
              Kenapa Meminta E-Brochure via Kanhadi?
            </h2>
            <p class="text-sm text-[#686D71] mt-2">
              Layanan cepat, akurat, dan langsung terhubung dengan Senior Certified Sales Consultant.
            </p>
          </div>

          <div class="space-y-4">
            <div class="bg-white border border-concrete p-5 shadow-sm">
              <h3 class="font-bold text-anthracite text-sm flex items-center gap-2">
                <span class="text-brand-red font-black">01.</span>
                Apakah E-Brochure ini gratis dan resmi?
              </h3>
              <p class="text-xs sm:text-sm text-[#666] leading-relaxed mt-2 pl-6">
                Ya, 100% gratis. Seluruh file PDF e-brochure merupakan dokumen resmi yang diterbitkan oleh PT Mitsubishi Motors Krama Yudha Sales Indonesia (MMKSI) dan PT Krama Yudha Tiga Berlian Motors (KTB).
              </p>
            </div>

            <div class="bg-white border border-concrete p-5 shadow-sm">
              <h3 class="font-bold text-anthracite text-sm flex items-center gap-2">
                <span class="text-brand-red font-black">02.</span>
                Apa saja yang terdapat di dalam brosur?
              </h3>
              <p class="text-xs sm:text-sm text-[#666] leading-relaxed mt-2 pl-6">
                Brosur memuat dimensi kendaraan, detail kapasitas mesin, transmisi, fitur keselamatan aktif (seperti Diamond Sense / ADAS), pilihan warna, perbandingan fitur per varian, hingga kapasitas muatan untuk segmen komersial.
              </p>
            </div>

            <div class="bg-white border border-concrete p-5 shadow-sm">
              <h3 class="font-bold text-anthracite text-sm flex items-center gap-2">
                <span class="text-brand-red font-black">03.</span>
                Bisakah sekaligus meminta simulasi hitungan cicilan?
              </h3>
              <p class="text-xs sm:text-sm text-[#666] leading-relaxed mt-2 pl-6">
                Tentu saja! Ketika menghubungi Kanhadi di WhatsApp, Anda cukup menyebutkan tipe mobil yang diinginkan serta budget DP atau angsuran per bulan yang direncanakan. Kanhadi akan membuatkan paket simulasi kredit terbaik dari berbagai leasing resmi rekanan.
              </p>
            </div>
          </div>

          <!-- Bottom Contact Box -->
          <div class="mt-10 bg-[#1A1C1E] text-white p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl">
            <div>
              <div class="text-[10px] font-black uppercase tracking-widest text-brand-red mb-1">KONSULTASI LANGSUNG</div>
              <h3 class="text-lg sm:text-xl font-black">Butuh Brosur Cetak / Test Drive ke Rumah?</h3>
              <p class="text-xs sm:text-sm text-[#A6A9AB] mt-1">
                Kanhadi siap membawakan brosur fisik dan unit test drive langsung ke alamat rumah atau kantor Anda.
              </p>
            </div>
            <a
              href={salesData.whatsapp ? getWhatsAppLink('Halo Kanhadi, saya ingin meminta brosur cetak dan konsultasi test drive mobil Mitsubishi ke rumah.') : '#'}
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 inline-flex items-center gap-2 bg-brand-red hover:bg-white hover:text-black text-white font-bold text-xs uppercase tracking-wider px-6 py-3.5 transition-colors"
            >
              Hubungi Kanhadi
            </a>
          </div>

        </div>
      </section>

    </div>
  </main>

  <!-- Client-side Interactive Filter & Search Script -->
  <script>
    function setupBrochureFilter() {
      const tabBtns = document.querySelectorAll<HTMLButtonElement>('.brochure-tab-btn');
      const searchInput = document.getElementById('brochure-search') as HTMLInputElement | null;
      const cards = document.querySelectorAll<HTMLElement>('.brochure-card');
      const noResults = document.getElementById('no-brochure');
      const resetBtn = document.getElementById('reset-filter-btn');

      let currentSegment = 'all';
      let searchQuery = '';

      function filterCards() {
        let visibleCount = 0;

        cards.forEach(card => {
          const cardSegment = card.getAttribute('data-segment') || '';
          const cardName = card.getAttribute('data-name') || '';
          const cardCat = card.getAttribute('data-category') || '';

          const matchesSegment = currentSegment === 'all' || cardSegment === currentSegment;
          const matchesSearch = !searchQuery || cardName.includes(searchQuery) || cardCat.includes(searchQuery);

          if (matchesSegment && matchesSearch) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      }

      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          tabBtns.forEach(b => {
            b.classList.remove('active', 'bg-brand-red', 'text-white');
            b.classList.add('bg-anthracite', 'text-[#A6A9AB]');
          });

          btn.classList.add('active', 'bg-brand-red', 'text-white');
          btn.classList.remove('bg-anthracite', 'text-[#A6A9AB]');

          currentSegment = btn.getAttribute('data-filter') || 'all';
          filterCards();
        });
      });

      searchInput?.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
        filterCards();
      });

      resetBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        currentSegment = 'all';

        tabBtns.forEach((b, idx) => {
          if (idx === 0) {
            b.classList.add('active', 'bg-brand-red', 'text-white');
            b.classList.remove('bg-anthracite', 'text-[#A6A9AB]');
          } else {
            b.classList.remove('active', 'bg-brand-red', 'text-white');
            b.classList.add('bg-anthracite', 'text-[#A6A9AB]');
          }
        });

        filterCards();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupBrochureFilter);
    } else {
      setupBrochureFilter();
    }
  </script>
</Layout>
