---
import Layout from '../../layouts/Layout.astro';
import { carsData, getCarBySlug } from '../../data/cars';
import { salesData, getWhatsAppLink } from '../../data/sales';

export function getStaticPaths() {
  return carsData.map(car => ({
    params: { slug: car.slug },
    props: { car },
  }));
}

const { car } = Astro.props;
const waMessage = `Halo Om Hadi, saya tertarik dengan ${car.name}. Bisa info promo dan simulasi kredit terbaru? Terima kasih!`;
const waUrl = getWhatsAppLink(waMessage);
const waTestDrive = getWhatsAppLink(`Halo Om Hadi, saya ingin jadwalkan test drive ${car.name}. Bisa ke rumah/kantor. Terima kasih!`);

// Format price to million
function toMillion(num: number): string {
  return (num / 1000000).toFixed(0) + ' Jt';
}
---

<Layout
  title={`${car.name} Jakarta 2026 | Harga OTR, DP & Cicilan - Om Hadi Mitsubishi`}
  description={`${car.name} harga OTR Jakarta mulai ${car.startingPrice}. DP ${car.dpStart}, cicilan ${car.cicilanStart}. Test drive ke rumah. Hubungi Om Hadi, sales resmi Mitsubishi Jakarta.`}
  currentPath={`/model/${car.slug}`}
  ogImage={car.image}
>

  <!-- ─── HERO ─────────────────────────────────────────────── -->
  <section class="model-hero">
    <div class="model-hero-bg" style={`background-image: url(${car.image})`}></div>
    <div class="model-hero-overlay"></div>
    <div class="model-hero-content">
      {car.badge && <div class="model-badge">{car.badge}</div>}
      <div class="model-category">{car.category}</div>
      <h1 class="model-hero-name">{car.name}</h1>
      <p class="model-hero-tagline">{car.tagline}</p>
      <div class="model-hero-specs">
        <div class="model-spec-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/></svg>
          {car.keySpecs.seating}
        </div>
        <div class="model-spec-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          {car.keySpecs.power}
        </div>
        <div class="model-spec-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/></svg>
          {car.keySpecs.transmission}
        </div>
        <div class="model-spec-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
          GC {car.keySpecs.groundClearance}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── WARNA + GAMBAR UTAMA ──────────────────────────────── -->
  <section class="model-config">
    <div class="model-config-inner">

      <!-- Color picker kiri -->
      <div class="model-color-panel">
        <div class="model-color-label">Pilihan Warna</div>
        <div class="model-colors" id="colorPicker">
          {car.colors.map((color, i) => (
            <button
              class={`model-color-swatch${i === 0 ? ' active' : ''}`}
              style={`background: ${color.hex}`}
              data-color={color.name}
              data-index={i}
              title={color.name}
            ></button>
          ))}
        </div>
        <div class="model-color-name" id="colorName">{car.colors[0].name}</div>
      </div>

      <!-- Gambar mobil tengah -->
      <div class="model-car-image">
        <img src={car.image} alt={car.name} id="carMainImage" />
        <div class="model-price-tag">
          <div class="model-price-from">Mulai dari</div>
          <div class="model-price-num">{car.startingPrice}</div>
          <div class="model-price-note">Harga OTR Jakarta 2026</div>
        </div>
      </div>

      <!-- Info kanan -->
      <div class="model-side-info">
        <div class="model-finance-box">
          <div class="model-finance-row">
            <span class="model-finance-label">DP Mulai</span>
            <span class="model-finance-val">{car.dpStart}</span>
          </div>
          <div class="model-finance-row">
            <span class="model-finance-label">Cicilan Mulai</span>
            <span class="model-finance-val model-finance-val--red">{car.cicilanStart}</span>
          </div>
          <div class="model-finance-note">*Simulasi 60 bulan, DP min. Syarat & ketentuan berlaku.</div>
        </div>
        <a href={waUrl} target="_blank" rel="noopener noreferrer" class="model-cta-primary">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Tanya Harga & Promo
        </a>
        <a href={waTestDrive} target="_blank" rel="noopener noreferrer" class="model-cta-secondary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
          Test Drive ke Rumah
        </a>
      </div>

    </div>
  </section>

  <!-- ─── DESKRIPSI ─────────────────────────────────────────── -->
  <section class="model-desc-section">
    <div class="model-section-inner">
      <p class="model-desc-text">{car.description}</p>
    </div>
  </section>

  <!-- ─── KEY SPECS ─────────────────────────────────────────── -->
  <section class="model-specs-section">
    <div class="model-section-inner">
      <div class="model-section-header">
        <div class="model-section-eyebrow">Spesifikasi</div>
        <h2 class="model-section-title">Performa & Teknis</h2>
      </div>
      <div class="model-specs-grid">
        <div class="model-spec-card">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/></svg>
          <div class="model-spec-card-val">{car.keySpecs.seating}</div>
          <div class="model-spec-card-label">Kapasitas</div>
        </div>
        <div class="model-spec-card">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/></svg>
          <div class="model-spec-card-val" style="font-size:13px">{car.keySpecs.engine}</div>
          <div class="model-spec-card-label">Mesin</div>
        </div>
        <div class="model-spec-card">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          <div class="model-spec-card-val" style="font-size:13px">{car.keySpecs.power}</div>
          <div class="model-spec-card-label">Tenaga Maks</div>
        </div>
        <div class="model-spec-card">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/></svg>
          <div class="model-spec-card-val" style="font-size:13px">{car.keySpecs.transmission}</div>
          <div class="model-spec-card-label">Transmisi</div>
        </div>
        <div class="model-spec-card">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          <div class="model-spec-card-val">{car.keySpecs.groundClearance}</div>
          <div class="model-spec-card-label">Ground Clearance</div>
        </div>
        <div class="model-spec-card">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>
          <div class="model-spec-card-val" style="font-size:13px">{car.keySpecs.fuelType}</div>
          <div class="model-spec-card-label">Bahan Bakar</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── HIGHLIGHTS ────────────────────────────────────────── -->
  <section class="model-highlights-section">
    <div class="model-section-inner">
      <div class="model-section-header">
        <div class="model-section-eyebrow">Keunggulan</div>
        <h2 class="model-section-title">Yang Membuat Berbeda</h2>
      </div>
      <div class="model-highlights-list">
        {car.highlights.map((h, i) => (
          <div class="model-highlight-item">
            <div class="model-highlight-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="model-highlight-text">{h}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── VARIAN & HARGA ────────────────────────────────────── -->
  <section class="model-variants-section">
    <div class="model-section-inner">
      <div class="model-section-header">
        <div class="model-section-eyebrow">Pilihan Varian</div>
        <h2 class="model-section-title">Daftar Harga OTR Jakarta 2026</h2>
      </div>
      <div class="model-variants-table">
        {car.variants.map((v, i) => (
          <div class={`model-variant-row${i === 0 ? ' model-variant-row--first' : ''}`}>
            <div class="model-variant-info">
              <div class="model-variant-name">{v.name}</div>
              <div class="model-variant-trans">{v.transmission}</div>
            </div>
            <div class="model-variant-right">
              <div class="model-variant-price">{v.priceFormatted}</div>
              <a href={getWhatsAppLink(`Halo Om Hadi, saya tertarik dengan ${v.name} (${v.priceFormatted}). Bisa info DP, cicilan, dan promo terbaru?`)}
                target="_blank" rel="noopener noreferrer" class="model-variant-cta">
                Tanya Harga
              </a>
            </div>
          </div>
        ))}
      </div>
      <p class="model-variants-note">* Harga OTR Jakarta. Hubungi kami untuk harga terbaru, promo, dan simulasi kredit.</p>
    </div>
  </section>

  <!-- ─── CTA AKHIR ─────────────────────────────────────────── -->
  <section class="model-final-cta">
    <div class="model-section-inner model-final-cta-inner">
      <div>
        <h2 class="model-final-cta-title">Tertarik dengan {car.name}?</h2>
        <p class="model-final-cta-sub">Konsultasi gratis, data dibantu, DP fleksibel. Om Hadi siap melayani hari ini.</p>
      </div>
      <div class="model-final-cta-btns">
        <a href={waUrl} target="_blank" rel="noopener noreferrer" class="model-cta-primary">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Chat WhatsApp Sekarang
        </a>
        <a href={`tel:${salesData.phone.replace(/[\s-]/g, '')}`} class="model-cta-secondary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          {salesData.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- ─── MODEL LAINNYA ─────────────────────────────────────── -->
  <section class="model-others-section">
    <div class="model-section-inner">
      <div class="model-section-header">
        <div class="model-section-eyebrow">Lineup</div>
        <h2 class="model-section-title">Model Mitsubishi Lainnya</h2>
      </div>
      <div class="model-others-grid">
        {carsData.filter(c => c.slug !== car.slug).slice(0, 4).map(other => (
          <a href={`/model/${other.slug}`} class="model-other-card">
            <div class="model-other-img">
              <img src={other.image} alt={other.name} loading="lazy" />
            </div>
            <div class="model-other-info">
              {other.badge && <div class="model-other-badge">{other.badge}</div>}
              <div class="model-other-name">{other.name}</div>
              <div class="model-other-price">{other.cicilanStart}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Shared ── */
  .model-section-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media (max-width: 640px) {
    .model-section-inner { padding: 0 20px; }
  }

  .model-section-header {
    margin-bottom: 40px;
  }

  .model-section-eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #E60012;
    margin-bottom: 8px;
  }

  .model-section-title {
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 800;
    color: #0a0a0a;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  /* ── Hero ── */
  .model-hero {
    position: relative;
    height: clamp(420px, 60vh, 600px);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .model-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transform: scale(1.05);
  }

  .model-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.2) 60%, rgba(0,0,0,0.3) 100%);
  }

  .model-hero-content {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    padding: 48px 40px;
    color: #fff;
  }

  @media (max-width: 640px) {
    .model-hero-content { padding: 32px 20px; }
  }

  .model-badge {
    display: inline-block;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: #E60012;
    color: #fff;
    padding: 3px 10px;
    margin-bottom: 8px;
  }

  .model-category {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    margin-bottom: 6px;
  }

  .model-hero-name {
    font-size: clamp(28px, 5vw, 52px);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 8px;
  }

  .model-hero-tagline {
    font-size: 14px;
    color: rgba(255,255,255,0.6);
    margin-bottom: 24px;
    max-width: 500px;
  }

  .model-hero-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .model-spec-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 500;
    color: rgba(255,255,255,0.85);
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.15);
    padding: 6px 12px;
    backdrop-filter: blur(4px);
  }

  .model-spec-pill svg { width: 13px; height: 13px; flex-shrink: 0; }

  /* ── Config section ── */
  .model-config {
    background: #f5f5f5;
    padding: 60px 0;
    border-bottom: 1px solid #e5e5e5;
  }

  .model-config-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 160px 1fr 220px;
    gap: 40px;
    align-items: center;
  }

  @media (max-width: 900px) {
    .model-config-inner {
      grid-template-columns: 1fr;
      padding: 0 20px;
    }
  }

  /* Color panel */
  .model-color-panel {}

  .model-color-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 14px;
  }

  .model-colors {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 10px;
  }

  .model-color-swatch {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid transparent;
    outline: 2px solid transparent;
    cursor: pointer;
    transition: outline-color 0.15s, transform 0.15s;
  }

  .model-color-swatch:hover { transform: scale(1.15); }
  .model-color-swatch.active { outline-color: #0a0a0a; outline-offset: 3px; }

  .model-color-name {
    font-size: 12px;
    color: #555;
    font-weight: 500;
  }

  /* Car image */
  .model-car-image {
    text-align: center;
    position: relative;
  }

  .model-car-image img {
    max-height: 320px;
    width: 100%;
    object-fit: contain;
    transition: opacity 0.3s;
  }

  .model-price-tag {
    margin-top: 20px;
    text-align: center;
  }

  .model-price-from {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #aaa;
    margin-bottom: 2px;
  }

  .model-price-num {
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 900;
    color: #0a0a0a;
    letter-spacing: -0.03em;
  }

  .model-price-note {
    font-size: 11px;
    color: #aaa;
    margin-top: 2px;
  }

  /* Side info */
  .model-side-info {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .model-finance-box {
    background: #fff;
    border: 1px solid #e5e5e5;
    padding: 20px;
  }

  .model-finance-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 8px 0;
    border-bottom: 1px solid #f0f0f0;
  }

