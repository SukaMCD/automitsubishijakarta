  }

  .model-highlight-text {
    font-size: 13.5px;
    color: #334155;
    line-height: 1.6;
    margin: 0;
    font-weight: 500;
  }


  /* ── Final CTA ── */
  .model-final-cta {
    padding: 64px 0;
    background: #0a0a0a;
    color: #fff;
  }

  .model-final-cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }

  .model-final-cta-title {
    font-size: clamp(20px, 3vw, 28px);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 6px;
    color: #fff;
  }

  .model-final-cta-sub {
    font-size: 13px;
    color: #777;
    max-width: 400px;
  }

  .model-final-cta-btns {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .model-cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #16a34a;
    color: #ffffff;
    font-size: 13.5px;
    font-weight: 700;
    text-decoration: none;
    padding: 12px 22px;
    border-radius: 8px;
    transition: background-color 0.18s, transform 0.15s;
    white-space: nowrap;
  }

  .model-cta-primary:hover {
    background: #15803d;
    transform: translateY(-1px);
  }

  .model-cta-primary svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .model-cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.05);
    color: #e2e8f0;
    border: 1px solid #334155;
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    padding: 12px 22px;
    border-radius: 8px;
    transition: all 0.18s;
    white-space: nowrap;
  }

  .model-cta-secondary:hover {
    border-color: #94a3b8;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-1px);
  }

  .model-cta-secondary svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* ── Others ── */
  .model-others-section {
    padding: 64px 0;
    background: #fafafa;
  }

  .model-others-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  @media (max-width: 900px) { .model-others-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .model-others-grid { grid-template-columns: 1fr; } }

  .model-other-card {
    text-decoration: none;
    background: #fff;
