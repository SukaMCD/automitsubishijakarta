    overflow: hidden;
  }

  .model-others-track {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  @media (max-width: 900px) { .model-others-track { grid-template-columns: repeat(3, 1fr); } }

  @media (max-width: 640px) {
    .model-others-track {
      display: flex;
      flex-direction: row;
      overflow-x: auto;
      gap: 14px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin: 0 -20px;
      padding: 4px 11vw 16px;
    }
    .model-others-track::-webkit-scrollbar { display: none; }
    .model-others-track .model-other-card {
      flex: 0 0 78vw;
      width: 78vw;
      scroll-snap-align: center;
      scroll-snap-stop: always;
    }
  }

  .model-other-card {
    text-decoration: none;
    background: #fff;
    border: 1px solid #ececec;
    overflow: hidden;
    transition: transform 0.15s;
    display: block;
  }

  .model-other-card:hover { transform: translateY(-2px); }

  .model-other-img {
    background: #f5f5f5;
    padding: 20px;
    aspect-ratio: 16/9;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .model-other-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transition: transform 0.3s;
  }

  .model-other-card:hover .model-other-img img { transform: scale(1.04); }

  .model-other-info {
    padding: 16px;
    border-top: 1px solid #f0f0f0;
  }

  .model-other-badge {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #E60012;
    margin-bottom: 4px;
  }

  .model-other-name {
    font-size: 13px;
    font-weight: 700;
    color: #0a0a0a;
    margin-bottom: 4px;
  }

  .model-other-price {
    font-size: 12px;
    color: #aaa;
    font-weight: 500;
  }
</style>

<script>
  function formatRupiah(num: number): string {
    return 'Rp ' + num.toLocaleString('id-ID');
  }

  const swatches = document.querySelectorAll<HTMLButtonElement>('.model-color-swatch');
  const colorName = document.getElementById('colorName');
  const variantItems = document.querySelectorAll<HTMLButtonElement>('.model-editorial-item');
  const carPriceLabel = document.getElementById('carPriceLabel');
  const carPriceVal = document.getElementById('carPriceVal');
  const sideWaBtn = document.getElementById('sideWaBtn') as HTMLAnchorElement | null;
  const sideWaBtnText = document.getElementById('sideWaBtnText');
  const pkgSwitchWrap = document.getElementById('pkgSwitchWrap');
  const pkgSwitch = document.getElementById('pkgSwitch');

  function updateActivePrice() {
    const activeVariant = document.querySelector<HTMLButtonElement>('.model-editorial-item.active');
    const activeSwatch = document.querySelector<HTMLButtonElement>('.model-color-swatch.active:not(.is-hidden)') 
      || document.querySelector<HTMLButtonElement>('.model-color-swatch.active');
    if (!activeVariant) return;

    const isComm = activeVariant.dataset.commercial === 'true';

    if (!isComm) {
      const basePriceNum = Number(activeVariant.dataset.priceNum || 0);
      const extraNum = activeSwatch ? Number(activeSwatch.dataset.extraNum || 0) : 0;
      const finalPriceNum = basePriceNum + extraNum;
      const finalPriceFormatted = finalPriceNum > 0 ? formatRupiah(finalPriceNum) : (activeVariant.dataset.price || '');

      if (carPriceVal) {
        carPriceVal.textContent = finalPriceFormatted;
      }

      const priceSpan = activeVariant.querySelector<HTMLElement>('.model-editorial-price');
      if (priceSpan) {
        priceSpan.textContent = finalPriceFormatted;
      }
    }

    const cName = activeSwatch ? activeSwatch.dataset.color || '' : '';
    if (colorName) {
      colorName.textContent = cName;
    }

    if (sideWaBtn) {
      const vName = activeVariant.dataset.name || '';
      if (isComm) {
        const msg = `Halo Kanhadi, saya tertarik dengan armada ${vName}. Bisa minta info spesifikasi karoseri dan penawaran terbaiknya? Terima kasih!`;
        sideWaBtn.href = `https://wa.me/6287808097263?text=${encodeURIComponent(msg)}`;
      } else {
        const basePriceNum = Number(activeVariant.dataset.priceNum || 0);
        const extraNum = activeSwatch ? Number(activeSwatch.dataset.extraNum || 0) : 0;
        const finalPriceNum = basePriceNum + extraNum;
        const finalPriceFormatted = finalPriceNum > 0 ? formatRupiah(finalPriceNum) : (activeVariant.dataset.price || '');
        const colorText = cName ? ` warna ${cName}` : '';
        const msg = `Halo Kanhadi, saya tertarik dengan ${vName}${colorText} (${finalPriceFormatted}). Bisa minta info diskon promo dan hitungan simulasi kreditnya?`;
        sideWaBtn.href = `https://wa.me/6287808097263?text=${encodeURIComponent(msg)}`;
      }
    }

    updateActiveCarImage();
  }

  function updateActiveCarImage() {
    const carMainImg = document.getElementById('carMainImage') as HTMLImageElement | null;
    if (!carMainImg) return;

    const activeVariant = document.querySelector<HTMLButtonElement>('.model-editorial-item.active');
    const activeSwatch = document.querySelector<HTMLButtonElement>('.model-color-swatch.active:not(.is-hidden)') 
      || document.querySelector<HTMLButtonElement>('.model-color-swatch.active');
    const defaultImg = (document.querySelector('.model-car-image') as HTMLElement)?.dataset.defaultImage;

    const variantImage = activeVariant?.dataset.image;
    const swatchImage = activeSwatch?.dataset.image;
    const imageTiers = activeSwatch?.dataset.imageTiers;
    const currentTier = activeVariant?.dataset.tier || '';

    let target = '';
    if (variantImage) {
      target = variantImage;
    } else if (activeSwatch) {
      const rawTierImages = activeSwatch.dataset.tierImages;
      if (rawTierImages) {
        try {
          const tierMap = JSON.parse(rawTierImages);
          if (currentTier && tierMap[currentTier]) {
            target = tierMap[currentTier];
          }
        } catch (e) {}
      }
      if (!target && swatchImage) {
        if (!imageTiers || (currentTier && imageTiers.split(',').map(s => s.trim()).includes(currentTier))) {
          target = swatchImage;
        }
      }
    }

    if (!target) {
      target = defaultImg || '';
    }

    if (target) {
      carMainImg.src = target;
    }
  }

  function attachPkgListeners() {
    const pkgBtns = document.querySelectorAll<HTMLButtonElement>('.model-pkg-btn');
    pkgBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        pkgBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const activeVariant = document.querySelector<HTMLButtonElement>('.model-editorial-item.active');
        if (!activeVariant) return;

        const pkgName = btn.dataset.pkgName || '';
        const pkgLabel = btn.dataset.pkgLabel || '';
        const pkgPrice = btn.dataset.pkgPrice || '';
        const pkgPriceNum = Number(btn.dataset.pkgPriceNum || 0);
        const pkgDp = btn.dataset.pkgDp || '';
        const pkgCicilan = btn.dataset.pkgCicilan || '';

        activeVariant.dataset.basePrice = pkgPrice;
        activeVariant.dataset.price = pkgPrice;
        activeVariant.dataset.priceNum = pkgPriceNum.toString();
        activeVariant.dataset.name = pkgName;
        activeVariant.dataset.cleanName = pkgLabel;
        if (pkgDp) activeVariant.dataset.dp = pkgDp;
        if (pkgCicilan) activeVariant.dataset.cicilan = pkgCicilan;

        if (carPriceLabel) carPriceLabel.textContent = pkgName;

        const dpVal = document.getElementById('dpVal');
        const cicilanVal = document.getElementById('cicilanVal');
        if (dpVal && pkgDp) dpVal.textContent = pkgDp;
        if (cicilanVal && pkgCicilan) cicilanVal.textContent = pkgCicilan;

        if (sideWaBtnText) {
          sideWaBtnText.textContent = `Minta Simulasi & Promo ${pkgLabel}`;
        }

        const priceSpan = activeVariant.querySelector<HTMLElement>('.model-editorial-price');
        if (priceSpan) {
          priceSpan.textContent = pkgPrice;
        }

        updateActivePrice();

        const highlightVariantTitle = document.getElementById('highlightVariantTitle');
        if (highlightVariantTitle) {
          highlightVariantTitle.textContent = pkgLabel;
        }
        const allGrids = document.querySelectorAll<HTMLElement>('.model-highlights-grid');
        allGrids.forEach(g => g.classList.remove('is-active'));
        const targetGrid = document.querySelector<HTMLElement>(`.model-highlights-grid[data-variant-key="${pkgLabel}"]`);
        if (targetGrid) {
          targetGrid.classList.add('is-active');
        } else if (allGrids.length > 0) {
          allGrids[0].classList.add('is-active');
        }
      });
    });
  }

  swatches.forEach(swatch => {
    swatch.addEventListener('click', () => {
      swatches.forEach(s => s.classList.remove('active'));
      swatch.classList.add('active');
      updateActivePrice();
    });
  });

  variantItems.forEach(item => {
    item.addEventListener('click', () => {
      variantItems.forEach(v => {
        v.classList.remove('active');
        const priceSpan = v.querySelector<HTMLElement>('.model-editorial-price');
        if (priceSpan && v.dataset.origPrice) {
          priceSpan.textContent = v.dataset.origPrice;
          v.dataset.basePrice = v.dataset.origPrice;
          v.dataset.price = v.dataset.origPrice;
          if (v.dataset.origPriceNum) {
            v.dataset.priceNum = v.dataset.origPriceNum;
          }
        }
      });
      item.classList.add('active');

      const name = item.dataset.name || '';
      const cleanName = item.dataset.cleanName || name;
      const dp = item.dataset.dp || '';
      const cicilan = item.dataset.cicilan || '';
      const tier = item.dataset.tier || '';

      if (carPriceLabel) carPriceLabel.textContent = name;

      if (item.dataset.packages) {
        try {
          const pkgs = JSON.parse(item.dataset.packages);
          if (Array.isArray(pkgs) && pkgs.length > 0 && pkgSwitch && pkgSwitchWrap) {
            pkgSwitchWrap.classList.remove('is-hidden');
            const existingBtns = pkgSwitch.querySelectorAll<HTMLButtonElement>('.model-pkg-btn');
            const matchesExisting = existingBtns.length === pkgs.length &&
              Array.from(existingBtns).every((b, i) => b.dataset.pkgLabel === pkgs[i].label);

            if (!matchesExisting) {
              pkgSwitch.innerHTML = pkgs.map((pkg: any, idx: number) => `
                <button
                  type="button"
                  class="model-pkg-btn${idx === 0 ? ' active' : ''}"
                  data-pkg-name="${pkg.name}"
                  data-pkg-label="${pkg.label}"
                  data-pkg-price="${pkg.priceFormatted}"
                  data-pkg-price-num="${pkg.price}"
                  data-pkg-dp="${pkg.dpEstimate || ''}"
                  data-pkg-cicilan="${pkg.cicilanEstimate || ''}"
                  data-pkg-highlights='${JSON.stringify(pkg.highlights || [])}'
                  data-pkg-tooltip="${pkg.featuresTooltip || ''}"
                >
                  <span>${pkg.label}</span>
                  ${pkg.featuresTooltip ? `
                    <span class="model-pkg-info">
                      <svg viewBox="0 0 24 24" width="13" height="13" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="16" x2="12" y2="12" />
                        <line x1="12" y1="8" x2="12.01" y2="8" />
                      </svg>
                      <span class="model-pkg-tooltip">${pkg.featuresTooltip}</span>
                    </span>
                  ` : ''}
                </button>
              `).join('');
              attachPkgListeners();
            } else {
              existingBtns.forEach((b, idx) => {
                if (idx === 0) b.classList.add('active');
                else b.classList.remove('active');
              });
            }
          } else if (pkgSwitchWrap) {
            pkgSwitchWrap.classList.add('is-hidden');
          }
        } catch (e) {
          if (pkgSwitchWrap) pkgSwitchWrap.classList.add('is-hidden');
        }
      } else if (pkgSwitchWrap) {
        pkgSwitchWrap.classList.add('is-hidden');
      }

      if (tier) {
        let activeHidden = false;
        swatches.forEach(swatch => {
          const rawVariants = swatch.dataset.variants || '';
          if (rawVariants) {
            const allowed = rawVariants.split(',').map(s => s.trim());
            if (allowed.includes(tier)) {
              swatch.classList.remove('is-hidden');
            } else {
              swatch.classList.add('is-hidden');
              if (swatch.classList.contains('active')) {
                activeHidden = true;
                swatch.classList.remove('active');
              }
            }
          } else {
            swatch.classList.remove('is-hidden');
          }
        });

        if (activeHidden) {
          const firstVisible = Array.from(swatches).find(s => !s.classList.contains('is-hidden'));
          if (firstVisible) {
            swatches.forEach(s => s.classList.remove('active'));
            firstVisible.classList.add('active');
          }
        }
      } else {
        swatches.forEach(swatch => {
          swatch.classList.remove('is-hidden');
        });
      }

      updateActivePrice();

      const dpVal = document.getElementById('dpVal');
      const cicilanVal = document.getElementById('cicilanVal');
      if (dpVal) dpVal.textContent = dp || 'Mulai 20%';
      if (cicilanVal) cicilanVal.textContent = cicilan || 'Konsultasi';

      if (sideWaBtnText) {
        if (item.dataset.commercial === 'true') {
          sideWaBtnText.textContent = `Minta Penawaran ${cleanName}`;
        } else {
          sideWaBtnText.textContent = `Minta Simulasi & Promo ${cleanName}`;
        }
      }

      const engine = item.dataset.engine;
      const power = item.dataset.power;
      const transDetail = item.dataset.transDetail;
      const gc = item.dataset.groundClearance;
      const specEngineVal = document.getElementById('specEngineVal');
      const specPowerVal = document.getElementById('specPowerVal');
      const specTransVal = document.getElementById('specTransVal');
      const specGcVal = document.getElementById('specGcVal');
      if (specEngineVal && engine) specEngineVal.textContent = engine;
      if (specPowerVal && power) specPowerVal.textContent = power;
      if (specTransVal && transDetail) specTransVal.textContent = transDetail;
      if (specGcVal && gc) specGcVal.textContent = gc;

      const highlightVariantTitle = document.getElementById('highlightVariantTitle');
      if (highlightVariantTitle) {
        highlightVariantTitle.textContent = cleanName;
      }

      const allGrids = document.querySelectorAll<HTMLElement>('.model-highlights-grid');
      allGrids.forEach(g => g.classList.remove('is-active'));
      const targetGrid = document.querySelector<HTMLElement>(`.model-highlights-grid[data-variant-key="${cleanName}"]`);
      if (targetGrid) {
        targetGrid.classList.add('is-active');
      } else if (allGrids.length > 0) {
        allGrids[0].classList.add('is-active');
      }
    });
  });

  attachPkgListeners();

  try {
    const configEl = document.querySelector('.model-config') as HTMLElement | null;
    if (configEl && configEl.dataset.preload) {
      const preloadList = JSON.parse(configEl.dataset.preload) as string[];
      preloadList.forEach(url => {
        const img = new Image();
        img.src = url;
      });
    }
  } catch (e) {}

  const commTabBtns = document.querySelectorAll<HTMLButtonElement>('.comm-tab-btn');
  const commSpecBoxes = document.querySelectorAll<HTMLElement>('.comm-spec-box');

  commTabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      commTabBtns.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const group = btn.dataset.group || 'all';

      commSpecBoxes.forEach(box => {
        if (group === 'all' || box.dataset.catGroup === group) {
          box.style.display = '';
        } else {
          box.style.display = 'none';
        }
      });
    });
  });

  updateActivePrice();
</script>
