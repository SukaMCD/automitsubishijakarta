<script>
  // Color picker interactivity
  const swatches = document.querySelectorAll<HTMLButtonElement>('.model-color-swatch');
  const colorName = document.getElementById('colorName');

  swatches.forEach(swatch => {
    swatch.addEventListener('click', () => {
      swatches.forEach(s => s.classList.remove('active'));
      swatch.classList.add('active');
      const cName = swatch.dataset.color || '';
      if (colorName) colorName.textContent = cName;
    });
  });

  // Variant selector interactivity
  const variantItems = document.querySelectorAll<HTMLButtonElement>('.model-editorial-item');
  const carPriceLabel = document.getElementById('carPriceLabel');
  const carPriceVal = document.getElementById('carPriceVal');
  const sideWaBtn = document.getElementById('sideWaBtn') as HTMLAnchorElement | null;
  const sideWaBtnText = document.getElementById('sideWaBtnText');

  variantItems.forEach(item => {
    item.addEventListener('click', () => {
      variantItems.forEach(v => v.classList.remove('active'));
      item.classList.add('active');

      const name = item.dataset.name || '';
      const cleanName = item.dataset.cleanName || name.replace(/^New Mitsubishi\s+|^Mitsubishi\s+|^Xpander\s+/, '');
      const price = item.dataset.price || '';
      const dp = item.dataset.dp || '';
      const cicilan = item.dataset.cicilan || '';
      const tier = item.dataset.tier || '';

      if (carPriceLabel) carPriceLabel.textContent = name;
      if (carPriceVal) carPriceVal.textContent = price;

      // Filter color swatches berdasarkan ketersediaan varian (tier)
      if (tier) {
        let activeHidden = false;
        swatches.forEach(swatch => {
          const rawVariants = swatch.dataset.variants || '';
          if (rawVariants) {
            const allowed = rawVariants.split(',').map(s => s.trim());
            if (allowed.includes(tier)) {
              swatch.classList.remove('is-hidden');
            } else {
              swatch.classList.add('is-hidden');
              if (swatch.classList.contains('active')) {
                activeHidden = true;
                swatch.classList.remove('active');
              }
            }
          } else {
            swatch.classList.remove('is-hidden');
          }
        });

        // Jika swatch aktif yang sedang dipilih disembunyikan di tipe ini, ganti ke swatch pertama yang visible
        if (activeHidden) {
          const firstVisible = Array.from(swatches).find(s => !s.classList.contains('is-hidden'));
          if (firstVisible) {
            firstVisible.click();
          }
        }
      } else {
        swatches.forEach(swatch => {
          swatch.classList.remove('is-hidden');
        });
      }

      const dpVal = document.getElementById('dpVal');
      const cicilanVal = document.getElementById('cicilanVal');
      if (dpVal) dpVal.textContent = dp || 'Mulai 20%';
      if (cicilanVal) cicilanVal.textContent = cicilan || 'Konsultasi';

      if (sideWaBtn) {
        const msg = `Halo Kanhadi, saya tertarik dengan ${name} (${price}). Bisa minta info diskon promo dan hitungan simulasi kreditnya?`;
        sideWaBtn.href = `https://wa.me/6287808097263?text=${encodeURIComponent(msg)}`;
      }
      if (sideWaBtnText) {
        sideWaBtnText.textContent = `Minta Simulasi & Promo ${cleanName}`;
      }
    });
  });
</script>
