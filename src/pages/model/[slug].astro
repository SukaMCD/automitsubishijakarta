---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { carsData, getCarBySlug } from '../../data/cars';
import { salesData, getWhatsAppLink } from '../../data/sales';
import { getCommercialSpec } from '../../data/commercialSpecs';

export function getStaticPaths() {
  return carsData.map(car => ({
    params: { slug: car.slug },
    props: { car },
  }));
}

const { car } = Astro.props;
const isCommercial = car.segment === 'commercial';
const commSpec = isCommercial ? getCommercialSpec(car.slug) : undefined;
const waMessage = isCommercial
  ? `Halo Kanhadi, saya tertarik dengan armada ${car.name}. Bisa minta info spesifikasi karoseri dan penawaran terbaiknya? Terima kasih!`
  : `Halo Kanhadi, saya tertarik dengan ${car.name}. Bisa info promo dan simulasi kredit terbaru? Terima kasih!`;
const waUrl = getWhatsAppLink(waMessage);
const waTestDrive = getWhatsAppLink(isCommercial
  ? `Halo Kanhadi, saya ingin konsultasi spesifikasi karoseri & armada ${car.name}. Terima kasih!`
  : `Halo Kanhadi, saya ingin jadwalkan test drive ${car.name}. Bisa ke rumah/kantor. Terima kasih!`);

function toMillion(num: number): string {
  return (num / 1000000).toFixed(0) + ' Jt';
}

const shortCarName = car.name.replace(/^All-New\s+|^New Mitsubishi\s+|^Mitsubishi\s+|^All New\s+|^New\s+/i, '');
const cleanVariantName = (name: string) => {
  const prefixes = [
    'New Mitsubishi',
    'Mitsubishi',
    car.name,
    shortCarName,
    'All-New Destinator',
    'Destinator',
    'Xpander Cross',
    'Xpander',
    'Pajero Sport',
    'New Xforce',
    'Xforce',
    'XForce',
    'Triton',
    'Colt L300',
    'L300',
    'Canter Extra Long Bus',
    'Canter Bus',
    'Canter FE 84G BC',
    'Canter FE 84',
    'Canter FE 71L BCL',
    'Canter FE 71L BC',
    'Canter FE 71L',
    'Canter FE 71 BC',
    'Canter FE 71',
    'Canter FE 74 HDS',
    'Canter FE 74 HD',
    'Canter FE 74L',
    'Canter FE 74',
    'Canter FE SHDX',
    'Canter'
  ].sort((a, b) => b.length - a.length);
  const escaped = prefixes.map(p => p.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
  const pattern = new RegExp(`^(${escaped})(?:\\s+|$)`, 'i');
  const cleaned = name.replace(pattern, '').trim();
  return cleaned || name;
};
const whitePearlColor = car.colors.find(c => {
  const n = c.name.toLowerCase();
  return n.includes('quartz white pearl') || n.includes('white diamond');
});

const allPreloadImages = Array.from(new Set([
  car.heroImage,
  car.image,
  ...(car.galleryImages || []),
  ...car.variants.map(v => v.image).filter(Boolean),
  ...car.colors.map(c => c.image).filter(Boolean),
  ...car.colors.flatMap(c => c.tierImages ? Object.values(c.tierImages) : []).filter(Boolean)
])).filter(Boolean);

const getRelatedCars = () => {
  if (car.segment === 'passenger') {
    return carsData.filter(c => c.segment === 'passenger' && c.slug !== car.slug).slice(0, 4);
  }
  
  if (car.segment === 'commercial') {
    const isBus = car.category === 'Bus' || car.category === 'Bus Chassis';
    const sameCommercial = carsData.filter(c => c.segment === 'commercial' && c.slug !== car.slug);
    if (isBus) {
      const otherBuses = sameCommercial.filter(c => c.category === 'Bus' || c.category === 'Bus Chassis');
      const otherTrucks = sameCommercial.filter(c => c.category === 'Truk');
      return [...otherBuses, ...otherTrucks].slice(0, 4);
    } else {
      const otherTrucks = sameCommercial.filter(c => c.category === 'Truk');
      const otherBuses = sameCommercial.filter(c => c.category === 'Bus' || c.category === 'Bus Chassis');
      return [...otherTrucks, ...otherBuses].slice(0, 4);
    }
  }

  const otherLcv = carsData.filter(c => c.segment === 'lcv' && c.slug !== car.slug);
  const commercialFallbacks = carsData.filter(c => c.segment === 'commercial');
  return [...otherLcv, ...commercialFallbacks].slice(0, 4);
};

const relatedCars = getRelatedCars();
const relatedSectionTitle = car.segment === 'passenger'
  ? 'Mobil Penumpang Lainnya'
  : car.segment === 'commercial'
    ? 'Truk & Bus Fuso Lainnya'
    : 'Model Niaga Ringan Lainnya';
const productSchema = {
  "@context": "https://schema.org",
  "@type": isCommercial ? "Vehicle" : "Car",
  "name": car.name,
  "description": car.tagline || car.description,
  "image": car.image.startsWith('http') ? car.image : `https://automitsubishijakarta.com${car.image}`,
  "brand": {
    "@type": "Brand",
    "name": isCommercial ? "Mitsubishi Fuso" : "Mitsubishi Motors"
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "IDR",
    "lowPrice": car.variants[0]?.price || 0,
    "highPrice": car.variants[car.variants.length - 1]?.price || car.variants[0]?.price || 0,
    "offerCount": car.variants.length,
    "priceValidUntil": "2026-12-31",
    "seller": {
      "@type": "AutoDealer",
      "name": "PT Lautan Berlian Utama Motor - Kebon Jeruk",
      "telephone": salesData.phone
    }
  }
};
---

<Layout
  title={isCommercial
    ? `${car.name} Jakarta 2026 | Info Karoseri & Spesifikasi Armada - Kanhadi Mitsubishi`
    : `${car.name} Jakarta 2026 | Harga OTR, DP & Cicilan - Kanhadi Mitsubishi`}
  description={isCommercial
    ? `${car.name} armada komersial Mitsubishi Fuso Jakarta. Spesifikasi karoseri lengkap, layanan fleet & penawaran terbaik. Hubungi Kanhadi, sales resmi Mitsubishi Fuso Jakarta.`
    : `${car.name} harga OTR Jakarta mulai ${car.startingPrice}. DP ${car.dpStart}, cicilan ${car.cicilanStart}. Test drive ke rumah. Hubungi Kanhadi, sales resmi Mitsubishi Jakarta.`}
  currentPath={`/model/${car.slug}`}
  ogImage={car.image || car.heroImage}
  schema={productSchema}
>

  <!-- Hero -->
  <section class="model-hero">
    <div class="model-hero-bg" style={`background-image: url(${car.heroImage || car.image})`}></div>
    <div class="model-hero-overlay"></div>
    <div class="model-hero-content">
      {car.badge && !isCommercial && <div class="model-badge">{car.badge}</div>}
      <h1 class="model-hero-name">
        {car.logo ? (
          <Image
            src={car.logoWhite || car.logo}
            alt={car.name}
            class="model-hero-brand-logo"
            width={180}
            height={46}
            loading="eager"
            decoding="async"
          />
        ) : (
          car.name
        )}
        <span class="sr-only">{car.name}</span>
      </h1>
      <p class="model-hero-tagline">{car.tagline}</p>
      <div class="model-hero-features">
        {(car.heroFeatures || [
          { label: car.keySpecs.seating, icon: 'interior' },
          { label: car.keySpecs.power, icon: 'engine' },
          { label: car.keySpecs.transmission, icon: 'transmission' },
          { label: `GC ${car.keySpecs.groundClearance}`, icon: 'suspension' }
        ]).map((feat) => (
          <div class="model-hero-feature-item">
            <div class="model-hero-feature-icon">
              {feat.icon === 'hybrid' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 13h3v-3h3V7h12v3h3v3h3v8h-3v3h-3v3H10v-3H7v-3H4v-8z"/>
                  <path d="M17 10l-3 6h4l-3 6"/>
                </svg>
              )}
              {feat.icon === 'engine' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 13h3v-3h3V7h12v3h3v3h3v8h-3v3h-3v3H10v-3H7v-3H4v-8z"/>
                  <circle cx="16" cy="16" r="3.5"/>
                </svg>
              )}
              {feat.icon === 'roof' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="7" y="4" width="18" height="24" rx="6"/>
                  <line x1="7" y1="10" x2="25" y2="10"/>
                  <line x1="7" y1="22" x2="25" y2="22"/>
                  <rect x="11" y="12" width="10" height="8" rx="1.5"/>
                </svg>
              )}
              {feat.icon === 'drive' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 15l2.5-7h15L26 15v8a2 2 0 01-2 2h-1a2 2 0 01-2-2v-1H11v1a2 2 0 01-2 2H8a2 2 0 01-2-2v-8z"/>
                  <circle cx="10" cy="18" r="2"/>
                  <circle cx="22" cy="18" r="2"/>
                  <path d="M13 18h6"/>
                  <path d="M4 27h24"/>
                </svg>
              )}
              {feat.icon === 'suspension' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 6l-2-2-2 2"/>
                  <line x1="19" y1="5" x2="16" y2="8"/>
                  <path d="M18 7l-7 7M15 6l-7 7M20 11l-7 7M17 10l-7 7M22 15l-7 7M19 14l-7 7"/>
                  <line x1="13" y1="23" x2="10" y2="26"/>
                  <circle cx="9" cy="27" r="2"/>
                </svg>
              )}
              {feat.icon === 'car-front' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 13l2.5-6h13L25 13v8a2 2 0 01-2 2h-1a2 2 0 01-2-2v-1H12v1a2 2 0 01-2 2H9a2 2 0 01-2-2v-8z"/>
                  <line x1="6" y1="13" x2="26" y2="13"/>
                  <path d="M12 18h8"/>
                  <line x1="14" y1="18" x2="16" y2="13"/>
                </svg>
              )}
              {feat.icon === 'car-seat' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="4" width="3.5" height="6" rx="1.5"/>
                  <path d="M11 11v8a2 2 0 002 2h8a1.5 1.5 0 001.5-1.5v-1.5l-6-2V11H11z"/>
                </svg>
              )}
              {feat.icon === 'bulb-spark' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 20c-2.5-2-4.5-4.8-4.5-8a8.5 8.5 0 0113.8-6.5"/>
                  <path d="M17.5 16.5c.8 1.1 1.5 2.3 1.5 3.5H11"/>
                  <path d="M12 23h6"/>
                  <path d="M13 26h4"/>
                  <path d="M24 3l1.2 3.2L28.5 7.5l-3.3 1.2L24 12l-1.2-3.3L19.5 7.5l3.3-1.3L24 3z" stroke-width="1.6"/>
                </svg>
              )}
              {feat.icon === 'car-radar' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 11l2.5-5h13L25 11v6a2 2 0 01-2 2h-1a2 2 0 01-2-2v-1H12v1a2 2 0 01-2 2H9a2 2 0 01-2-2v-6z"/>
                  <line x1="6" y1="11" x2="26" y2="11"/>
                  <path d="M12 15h8"/>
                  <path d="M12 21a6 6 0 008 0"/>
                  <path d="M9 25a11 11 0 0014 0"/>
                </svg>
              )}
              {feat.icon === 'steering' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="16" cy="16" r="13"/>
                  <circle cx="16" cy="16" r="3.5"/>
                  <line x1="3" y1="16" x2="12.5" y2="16"/>
                  <line x1="19.5" y1="16" x2="29" y2="16"/>
                  <line x1="16" y1="19.5" x2="16" y2="29"/>
                </svg>
              )}
              {feat.icon === 'stars' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 6l2 7 7 2-7 2-2 7-2-7-7-2 7-2 2-7z" stroke-width="1.8"/>
                  <path d="M23 4l1.2 3.8L28 9l-3.8 1.2L23 14l-1.2-3.8L18 9l3.8-1.2L23 4z" stroke-width="1.5"/>
                  <path d="M23 20l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8.8-2.2z" stroke-width="1.3"/>
                </svg>
              )}
              {feat.icon === 'shield' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 28s10-5 10-13V6l-10-3-10 3v9c0 8 10 13 10 13z"/>
                  <path d="M12 15l3 3 5-5"/>
                </svg>
              )}
              {feat.icon === 'chassis' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 18l4-8h18l4 8M5 18h22a2 2 0 012 2v2H3v-2a2 2 0 012-2z"/>
                  <circle cx="9" cy="22" r="2.5"/>
                  <circle cx="23" cy="22" r="2.5"/>
                </svg>
              )}
              {feat.icon === 'cargo' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 11h24v13a2 2 0 01-2 2H6a2 2 0 01-2-2V11z"/>
                  <path d="M4 11l4-5h16l4 5"/>
                  <line x1="16" y1="11" x2="16" y2="26"/>
                  <line x1="4" y1="18" x2="28" y2="18"/>
                </svg>
              )}
              {feat.icon === 'interior' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 24h14a2 2 0 002-2v-5a2 2 0 00-2-2h-1V7a2 2 0 00-2-2H12a2 2 0 00-2 2v8H9a2 2 0 00-2 2v5a2 2 0 002 2z"/>
                  <path d="M7 28h18"/>
                </svg>
              )}
              {feat.icon === 'transmission' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="16" cy="7" r="3.5"/>
                  <path d="M16 10.5v14M11 20h10M11 20v4M21 20v4"/>
                </svg>
              )}
              {feat.icon === 'tech' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="6" width="24" height="16" rx="2"/>
                  <line x1="12" y1="26" x2="20" y2="26"/>
                  <line x1="16" y1="22" x2="16" y2="26"/>
                </svg>
              )}
              {feat.icon === 'sound' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 9L8 14H4v4h4l6 5V9z"/>
                  <path d="M19 11a7 7 0 010 10"/>
                  <path d="M23 7a12 12 0 010 18"/>
                </svg>
              )}
              {feat.icon === 'connect' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="5" width="14" height="22" rx="2.5"/>
                  <circle cx="16" cy="23" r="1" fill="currentColor"/>
                  <path d="M5 12a10 10 0 010 8"/>
                  <path d="M27 12a10 10 0 000 8"/>
                </svg>
              )}
              {feat.icon === 'climb' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 25l24-12"/>
                  <path d="M19 7h7v7"/>
                  <path d="M26 7l-9 9"/>
                </svg>
              )}
              {feat.icon === 'terrain' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 24l8-11 5 6 6-8 7 13H3z"/>
                  <circle cx="22" cy="8" r="2.5"/>
                </svg>
              )}
              {feat.icon === 'maintenance' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21.5 6.5a4 4 0 00-5.3.4l-8.7 8.7a2 2 0 002.8 2.8l8.7-8.7a4 4 0 002.5-3.2z"/>
                  <path d="M17.5 7.5l3.5 3.5"/>
                  <path d="M7 25l3-3"/>
                </svg>
              )}
              {feat.icon === 'sparepart' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="16" cy="16" r="4.5"/>
                  <path d="M16 4v3m0 18v3M4 16h3m18 0h3m-3.5-8.5l-2.1 2.1m-12.8 12.8l-2.1 2.1m0-17l2.1 2.1m12.8 12.8l2.1 2.1"/>
                </svg>
              )}
            </div>
            <span class="model-hero-feature-text">{feat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Konfigurasi Model -->
  <section class="model-config" data-preload={JSON.stringify(allPreloadImages)}>
    <div class={`model-config-inner${isCommercial ? ' is-commercial' : ''}`}>

      {!isCommercial && (
        <div class="model-color-panel">
          <div class="model-color-label">Pilihan Warna</div>
          <div class="model-colors" id="colorPicker">
            {car.colors.map((color, i) => {
              const isInitialHidden = color.availableVariants && car.variants[0]?.tier && !color.availableVariants.includes(car.variants[0].tier);
              return (
                <button
                  class={`model-color-swatch${i === 0 ? ' active' : ''}${isInitialHidden ? ' is-hidden' : ''}`}
                  style={`background: ${color.hex};`}
                  data-color={color.name}
                  data-extra={color.extraPriceFormatted || ''}
                  data-extra-num={color.extraPriceNum || (color.extraPriceFormatted ? Number(color.extraPriceFormatted.replace(/[^0-9]/g, '')) : 0)}
                  data-variants={color.availableVariants ? color.availableVariants.join(',') : ''}
                  data-image={color.image || ''}
                  data-image-tiers={color.imageTiers ? color.imageTiers.join(',') : ''}
                  data-tier-images={color.tierImages ? JSON.stringify(color.tierImages) : ''}
                  data-index={i}
                  title={color.name}
                ></button>
              );
            })}
          </div>
          <div class="model-color-name" id="colorName">{car.colors[0]?.name}</div>
        </div>
      )}

      {
        (() => {
          const initV = car.variants[0];
          const initC = car.colors[0];
          let initImg = car.image;
          if (initV?.image) {
            initImg = initV.image;
          } else if (initC?.tierImages && initV?.tier && initC.tierImages[initV.tier]) {
            initImg = initC.tierImages[initV.tier];
          } else if (initC?.image && (!initC.imageTiers || (initV?.tier && initC.imageTiers.includes(initV.tier)))) {
            initImg = initC.image;
          }
          return (
            <div class="model-car-image" data-default-image={initImg}>
              <Image src={initImg} alt={car.name} id="carMainImage" width={900} height={500} loading="eager" fetchpriority="high" decoding="async" />

              <div
                class={`model-pkg-switch-wrap${initV?.packages && initV.packages.length > 0 ? '' : ' is-hidden'}`}
                id="pkgSwitchWrap"
              >
                <div class="model-pkg-switch" id="pkgSwitch">
                  {initV?.packages?.map((pkg, pIdx) => (
                    <button
                      type="button"
                      class={`model-pkg-btn${pIdx === 0 ? ' active' : ''}`}
                      data-pkg-name={pkg.name}
                      data-pkg-label={pkg.label}
                      data-pkg-price={pkg.priceFormatted}
                      data-pkg-price-num={pkg.price}
                      data-pkg-dp={pkg.dpEstimate || ''}
                      data-pkg-cicilan={pkg.cicilanEstimate || ''}
                      data-pkg-highlights={JSON.stringify(pkg.highlights || [])}
                      data-pkg-tooltip={pkg.featuresTooltip || ''}
                    >
                      <span>{pkg.label}</span>
                      {pkg.featuresTooltip && (
                        <span class="model-pkg-info">
                          <svg viewBox="0 0 24 24" width="13" height="13" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="16" x2="12" y2="12" />
                            <line x1="12" y1="8" x2="12.01" y2="8" />
                          </svg>
                          <span class="model-pkg-tooltip">{pkg.featuresTooltip}</span>
                        </span>
                      )}
                    </button>
                  ))}
                </div>
              </div>

              <div class={`model-price-tag${isCommercial ? ' is-commercial' : ''}`}>
                <div class="model-price-from" id="carPriceLabel">{car.variants[0]?.name || car.name}</div>
                {!isCommercial && (
                  <>
                    <div class="model-price-num" id="carPriceVal">{car.variants[0]?.priceFormatted || car.startingPrice}</div>
                    <div class="model-price-note">Harga OTR Jakarta 2026</div>
                  </>
                )}
              </div>
            </div>
          );
        })()
      }

      <div class="model-side-info">
        <div class="model-editorial-panel">
          <div class="model-editorial-header">
            <span class="model-editorial-title">{isCommercial ? 'Pilihan Karoseri' : 'Pilihan Varian'}</span>
            {!isCommercial && <span class="model-editorial-sub">OTR Jakarta 2026</span>}
          </div>

          <div class="model-editorial-list">
            {car.variants.map((v, i) => {
              const cleanVName = cleanVariantName(v.name);
              return (
                <button
                  type="button"
                  class={`model-editorial-item${i === 0 ? ' active' : ''}${isCommercial ? ' is-commercial' : ''}`}
                  data-commercial={isCommercial ? 'true' : 'false'}
                  data-name={v.name}
                  data-clean-name={cleanVName}
                  data-image={v.image || ''}
                  data-price={v.priceFormatted}
                  data-base-price={v.priceFormatted}
                  data-orig-price={v.priceFormatted}
                  data-price-num={v.price}
                  data-orig-price-num={v.price}
                  data-trans={v.transmission}
                  data-dp={v.dpEstimate || ''}
                  data-cicilan={v.cicilanEstimate || ''}
                  data-tier={v.tier || ''}
                  data-trans-detail={v.transmissionDetail || (v.transmission === 'CVT' ? 'CVT Otomatis' : v.transmission === 'MT' ? '5-Speed Manual (M/T)' : v.transmission)}
                  data-ground-clearance={v.groundClearance || car.keySpecs.groundClearance}
                  data-engine={v.engine || car.keySpecs.engine}
                  data-power={v.power || car.keySpecs.power}
                  data-highlights={JSON.stringify(v.highlights || car.highlights)}
                  data-packages={v.packages ? JSON.stringify(v.packages) : ''}
                >
                  <span class="model-editorial-name">{cleanVName}</span>
                  {!isCommercial && <span class="model-editorial-price">{v.priceFormatted}</span>}
                </button>
              );
            })}
          </div>

          {!isCommercial && (
            <div class="model-editorial-finance">
              <div class="model-finance-row">
                <span class="model-finance-item">DP mulai <strong id="dpVal">{car.variants[0]?.dpEstimate || '20%'}</strong></span>
                <span class="model-finance-bullet">·</span>
                <span class="model-finance-item">Cicilan <strong id="cicilanVal">{car.variants[0]?.cicilanEstimate || 'Konsultasi'}</strong></span>
              </div>
              <p class="model-finance-note">*Promo bunga ringan &amp; tenor kredit s/d 6 tahun via dealer resmi</p>
            </div>
          )}

          <div class="model-editorial-actions">
            <a href={waUrl} target="_blank" rel="noopener noreferrer" class="model-editorial-wa-btn" id="sideWaBtn">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              <span id="sideWaBtnText">
                {isCommercial
                  ? `Minta Penawaran ${cleanVariantName(car.variants[0]?.name || car.name)}`
                  : `Minta Simulasi & Promo ${cleanVariantName(car.variants[0]?.name || car.name)}`}
              </span>
            </a>
            <a href={waTestDrive} target="_blank" rel="noopener noreferrer" class="model-editorial-testdrive-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"/>
                <circle cx="12" cy="12" r="3"/>
                <path d="M12 3v6m-9 3h6m6 0h6m-3.5 6.5L14 14.5M6.5 18.5L9.5 14.5"/>
              </svg>
              <span>{isCommercial ? 'Konsultasi Karoseri & Armada' : 'Jadwalkan Test Drive ke Rumah'}</span>
            </a>
          </div>
        </div>
      </div>

    </div>

    <div class="model-disclaimer-wrap">
      <div class="model-disclaimer-inner">
        {isCommercial ? (
          <>
            <p>*Spesifikasi karoseri, rancang bangun (SRUT), dan harga paket armada dapat disesuaikan dengan kebutuhan operasional bisnis Anda</p>
            <p>*Tersedia program pembiayaan fleet khusus, bunga kompetitif, dan paket perawatan berkala</p>
            <p>*Untuk informasi teknis karoseri & penawaran resmi dapat menghubungi tim sales Mitsubishi Fuso</p>
          </>
        ) : (
          <>
            <p>*Harga OTR Jabodetabek</p>
            {whitePearlColor?.extraPriceFormatted && (
              <p>*Harga {shortCarName} pilihan warna {whitePearlColor.name} lebih tinggi {whitePearlColor.extraPriceFormatted.replace('+', '')}</p>
            )}
            <p>*Untuk informasi harga terkini dapat menghubungi dealer Mitsubishi Motors terdekat</p>
            <p>*Ketersediaan varian dan warna dapat berbeda-beda tergantung stok yang tersedia di dealer dan PT MMKSI</p>
          </>
        )}
        <div class="model-disclaimer-line"></div>
      </div>
    </div>
  </section>

  <!-- Deskripsi -->
  <section class="model-desc-section">
    <div class="model-section-inner">
      <p class="model-desc-text">{car.description}</p>
    </div>
  </section>

  <!-- Spesifikasi -->
  {isCommercial && commSpec ? (
    <section class="comm-specs-section" id="commercialSpecs">
      <div class="model-section-inner">
        <div class="model-section-header">
          <div class="model-section-eyebrow">Spesifikasi</div>
          <h2 class="model-section-title">Spesifikasi Teknis</h2>
        </div>

        <div class="comm-spec-tabs" role="tablist">
          <button type="button" class="comm-tab-btn is-active" data-group="all">Semua</button>
          <button type="button" class="comm-tab-btn" data-group="dimensi">Dimensi & Berat</button>
          <button type="button" class="comm-tab-btn" data-group="mesin">Mesin & Transmisi</button>
          <button type="button" class="comm-tab-btn" data-group="sasis">Kaki-Kaki & Rem</button>
          <button type="button" class="comm-tab-btn" data-group="kelistrikan">Kemudi & Kelistrikan</button>
        </div>

        <div class="comm-specs-grid" id="commSpecsGrid">
          {commSpec.categories.map((cat) => (
            <div class="comm-spec-box" data-cat-id={cat.id} data-cat-group={cat.group}>
              <div class="comm-spec-box-header">
                <h3>{cat.title}</h3>
              </div>
              <table class="comm-spec-table">
                <tbody>
                  {cat.items.map((item) => (
                    <tr class="comm-spec-row">
                      <td class="comm-spec-key">{item.label}</td>
                      <td class="comm-spec-val">{item.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
        </div>

        <p class="comm-spec-disclaimer">
          * Seluruh data spesifikasi teknis mengacu pada data resmi PT Krama Yudha Tiga Berlian Motors (KTB Fuso Indonesia). Untuk konsultasi kebutuhan karoseri dan rekomendasi armada fleet, hubungi Sales Consultant kami.
        </p>
      </div>
    </section>
  ) : (
    <section class="model-specs-section">
      <div class="model-section-inner">
        <div class="model-section-header">
          <div class="model-section-eyebrow">Spesifikasi</div>
          <h2 class="model-section-title">Performa & Teknis</h2>
        </div>
        <div class="model-specs-grid">
          <div class="model-spec-card">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/></svg>
            <div class="model-spec-card-val">{car.keySpecs.seating}</div>
            <div class="model-spec-card-label">Kapasitas</div>
          </div>
          <div class="model-spec-card">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/></svg>
            <div class="model-spec-card-val" style="font-size:13px" id="specEngineVal">{car.variants[0]?.engine || car.keySpecs.engine}</div>
            <div class="model-spec-card-label">Mesin</div>
          </div>
          <div class="model-spec-card">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <div class="model-spec-card-val" style="font-size:13px" id="specPowerVal">{car.variants[0]?.power || car.keySpecs.power}</div>
            <div class="model-spec-card-label">Tenaga Maks</div>
          </div>
          <div class="model-spec-card">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/></svg>
            <div class="model-spec-card-val" style="font-size:13px" id="specTransVal">{car.variants[0]?.transmissionDetail || car.keySpecs.transmission}</div>
            <div class="model-spec-card-label">Transmisi</div>
          </div>
          <div class="model-spec-card">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            <div class="model-spec-card-val" id="specGcVal">{car.variants[0]?.groundClearance || car.keySpecs.groundClearance}</div>
            <div class="model-spec-card-label">Ground Clearance</div>
          </div>
          <div class="model-spec-card">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>
            <div class="model-spec-card-val" style="font-size:13px">{car.keySpecs.fuelType}</div>
            <div class="model-spec-card-label">Bahan Bakar</div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Keunggulan -->
  <section class="model-highlights-section" id="modelHighlightsSection">
    <div class="model-section-inner">
      <div class="model-section-header">
        <div class="model-section-eyebrow">Keunggulan</div>
        <h2 class="model-section-title">
          Yang Membuat Beda di {shortCarName} <span id="highlightVariantTitle" class="model-highlight-title-variant">{car.variants[0]?.name ? cleanVariantName(car.variants[0].name) : ''}</span>
        </h2>
      </div>
      <div class="model-highlights-container">
        {car.variants.map((v, vIdx) => {
          if (v.packages && v.packages.length > 0) {
            return v.packages.map((pkg, pIdx) => {
              const items = pkg.highlights || v.highlights || car.highlights;
              return (
                <div
                  class={`model-highlights-grid${vIdx === 0 && pIdx === 0 ? ' is-active' : ''}`}
                  data-variant-key={pkg.label}
                >
                  {items.map((h, i) => (
                    <div class="model-highlight-card">
                      <div class="model-highlight-num">{String(i + 1).padStart(2, '0')}</div>
                      <p class="model-highlight-text">{h}</p>
                    </div>
                  ))}
                </div>
              );
            });
          }
          const cleanKey = cleanVariantName(v.name);
          const rawItems = v.highlights || car.highlights;
          const items = isCommercial ? rawItems.slice(0, 3) : rawItems;
          return (
            <div
              class={`model-highlights-grid${vIdx === 0 ? ' is-active' : ''}`}
              data-variant-key={cleanKey}
            >
              {items.map((h, i) => (
                <div class="model-highlight-card">
                  <div class="model-highlight-num">{String(i + 1).padStart(2, '0')}</div>
                  <p class="model-highlight-text">{h}</p>
                </div>
              ))}
            </div>
          );
        })}
      </div>
    </div>
  </section>


  <!-- CTA -->
  <section class="model-final-cta">
    <div class="model-section-inner model-final-cta-inner">
      <div class="model-final-cta-text">
        <span class="model-final-cta-eyebrow">Konsultasi &amp; Penawaran Terbaik</span>
        <h2 class="model-final-cta-title">Tertarik dengan {car.name}?</h2>
        <p class="model-final-cta-sub">Konsultasi gratis, data dibantu hingga approve, DP fleksibel. Hubungi sales kami sekarang.</p>
      </div>
      <div class="model-final-cta-btns">
        <a href={waUrl} target="_blank" rel="noopener noreferrer" class="model-cta-primary">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          <span>Chat WhatsApp</span>
        </a>
        <a href={`tel:${salesData.phone.replace(/[\s-]/g, '')}`} class="model-cta-secondary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <span>Telepon Langsung</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Model Lainnya -->
  <section class="model-others-section">
    <div class="model-section-inner">
      <div class="model-section-header">
        <div class="model-section-eyebrow">Lineup</div>
        <h2 class="model-section-title">{relatedSectionTitle}</h2>
      </div>
      <div class="model-others-track">
        {relatedCars.map(other => (
          <a href={`/model/${other.slug}`} class="model-other-card">
            <div class="model-other-img">
              <Image src={other.image} alt={other.name} width={400} height={225} loading="lazy" decoding="async" />
            </div>
            <div class="model-other-info">
              {other.badge && other.segment !== 'commercial' && <div class="model-other-badge">{other.badge}</div>}
              <div class="model-other-name">{other.name}</div>
              <div class="model-other-price">{other.segment === 'commercial' ? 'Konsultasi Fleet' : other.cicilanStart}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Shared */
  .model-section-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media (max-width: 640px) {
    .model-section-inner { padding: 0 20px; }
  }

  .model-section-header {
    margin-bottom: 40px;
  }

  .model-section-eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #E60012;
    margin-bottom: 8px;
  }

  .model-section-title {
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 800;
    color: #0a0a0a;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  /* Hero */
  .model-hero {
    position: relative;
    height: clamp(420px, 60vh, 600px);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .model-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center center;
    transform: scale(1.02);
  }

  .model-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.5) 45%, rgba(0,0,0,0.3) 100%);
  }

  .model-hero-content {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    padding: 48px 40px;
    color: #fff;
  }

  @media (max-width: 640px) {
    .model-hero-content { padding: 32px 20px; }
  }

  .model-badge {
    display: inline-block;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: #E60012;
    color: #fff;
    padding: 3px 10px;
    margin-bottom: 8px;
  }

  .model-category {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    margin-bottom: 6px;
  }

  .model-hero-name {
    font-size: clamp(28px, 5vw, 52px);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 4px;
  }

  .model-hero-brand-logo {
    height: clamp(34px, 4.5vw, 48px);
    width: auto;
    max-width: 320px;
    object-fit: contain;
    display: block;
    margin: 4px 0 8px;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.7));
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .model-hero-tagline {
    font-size: clamp(22px, 3.5vw, 42px);
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.03em;
    margin-top: 4px;
    margin-bottom: 28px;
    max-width: 800px;
    line-height: 1.12;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
  }

  .model-hero-features {
    display: flex;
    align-items: center;
    gap: 40px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .model-hero-feature-item {
    display: flex;
    align-items: center;
    gap: 14px;
    color: #ffffff;
  }

  .model-hero-feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    color: #ffffff;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.6));
  }

  .model-hero-feature-icon svg {
    width: 100%;
    height: 100%;
    stroke: #ffffff;
  }

  .model-hero-feature-text {
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.25;
    max-width: 160px;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
  }

  @media (max-width: 992px) {
    .model-hero-features {
      gap: 24px;
      margin-top: 24px;
    }
    .model-hero-feature-icon {
      width: 32px;
      height: 32px;
    }
    .model-hero-feature-text {
      font-size: 13.5px;
      max-width: 130px;
    }
  }

  @media (max-width: 640px) {
    .model-hero-features {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px 20px;
      margin-top: 20px;
    }
    .model-hero-feature-item {
      gap: 10px;
    }
    .model-hero-feature-icon {
      width: 28px;
      height: 28px;
    }
    .model-hero-feature-text {
      font-size: 12.5px;
      max-width: 100%;
    }
  }

  /* Config */
  .model-config {
    background: #f5f5f5;
    padding: 60px 0;
    border-bottom: 1px solid #e5e5e5;
  }

  .model-config-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
    display: grid;
    grid-template-columns: 140px 1fr 345px;
    gap: 32px;
    align-items: start;
  }

  .model-config-inner.is-commercial {
    grid-template-columns: 1fr 345px;
    gap: 48px;
  }

  @media (max-width: 900px) {
    .model-config-inner {
      grid-template-columns: 1fr;
      padding: 0 20px;
    }

    .model-config-inner.is-commercial {
      grid-template-columns: 1fr;
