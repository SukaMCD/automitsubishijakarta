  @media (max-width: 900px) { .model-specs-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 500px) { .model-specs-grid { grid-template-columns: repeat(2, 1fr); } }

  .model-spec-card {
    display: flex;
    flex-direction: column;
    align-items: center;
