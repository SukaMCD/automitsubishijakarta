---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { carsData } from '../data/cars';
import { salesData, getWhatsAppLink } from '../data/sales';

const passengerCars = carsData.filter(c => c.segment === 'passenger');
const lcvCars = carsData.filter(c => c.segment === 'lcv');
const commercialCars = carsData.filter(c => c.segment === 'commercial');

const waGeneral = getWhatsAppLink('Halo Kanhadi, saya ingin minta info daftar harga OTR terbaru dan promo diskon Mitsubishi Jakarta.');
---

<Layout
  title="Daftar Harga Mobil Mitsubishi Jakarta 2026 | Pricelist OTR Terbaru - Kanhadi"
  description="Daftar harga OTR resmi mobil Mitsubishi Jakarta 2026. Xpander, Pajero Sport, Xforce, Destinator, Triton, L300, dan Truk Canter. Promo diskon, DP ringan dan bunga 0%."
  currentPath="/pricelist"
>
  <!-- Hero Section -->
  <section class="bg-[#1A1C1E] text-white py-12 md:py-16 border-b border-white/10">
    <div class="max-w-[1440px] mx-auto px-6">
      
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-wider text-[#A6A9AB] mb-4">
        <a href="/" class="hover:text-white transition-colors">Beranda</a>
        <span>/</span>
        <span class="text-[#E60012]">Daftar Harga</span>
      </nav>

      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="max-w-3xl">
          <span class="text-[10px] font-black uppercase tracking-[0.2em] text-[#E60012] block mb-2">
            Pricelist Resmi OTR Jakarta 2026
          </span>
          <h1 class="text-3xl md:text-5xl font-black tracking-tight leading-tight">
            Daftar Harga Mobil Mitsubishi Jakarta
          </h1>
          <p class="text-[#A6A9AB] text-sm md:text-base leading-relaxed mt-3">
            Pilih model kendaraan di bawah untuk melihat rincian harga OTR seluruh tipe dan varian resmi. Harga belum termasuk potongan cashback diskon spesial bulan ini.
          </p>
        </div>

        <div class="flex items-center gap-3 flex-shrink-0">
          <a
            href={waGeneral}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#E60012] hover:bg-[#B3000E] text-white font-bold text-xs uppercase tracking-wider px-5 py-3 transition-colors"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            Minta Diskon
          </a>
          <a
            href="/#simulasi-kredit"
            class="inline-flex items-center gap-2 border border-white/30 hover:border-white text-white font-bold text-xs uppercase tracking-wider px-5 py-3 transition-colors"
          >
            Simulasi Kredit
          </a>
        </div>
      </div>

      <!-- Segment Tabs -->
      <div class="mt-8 flex flex-wrap gap-2 border-t border-white/10 pt-6">
        <button
          type="button"
          class="seg-btn active px-4 py-2 text-xs font-bold uppercase tracking-wider transition-all bg-[#E60012] text-white cursor-pointer"
          data-segment="passenger"
        >
          Mobil Penumpang ({passengerCars.length})
        </button>
        <button
          type="button"
          class="seg-btn px-4 py-2 text-xs font-bold uppercase tracking-wider transition-all bg-[#2B2E30] text-[#A6A9AB] hover:text-white cursor-pointer"
          data-segment="lcv"
        >
          Niaga Ringan ({lcvCars.length})
        </button>
        <button
          type="button"
          class="seg-btn px-4 py-2 text-xs font-bold uppercase tracking-wider transition-all bg-[#2B2E30] text-[#A6A9AB] hover:text-white cursor-pointer"
          data-segment="commercial"
        >
          Truk &amp; Bus Fuso ({commercialCars.length})
        </button>
      </div>
    </div>
  </section>

  <!-- Interactive Model Selector -->
  <section class="bg-white border-b border-[#E3E5E6] sticky top-16 md:top-20 z-20 shadow-sm">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 py-2.5">
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1" id="model-tabs-container">
        {carsData.map((car, idx) => (
          <button
            type="button"
            class={`model-tab-btn px-4 py-2 text-xs font-bold whitespace-nowrap transition-all border cursor-pointer flex items-center gap-2 ${
              idx === 0
                ? 'active bg-[#1F2421] text-white border-[#1F2421] shadow-sm'
                : 'bg-[#F6F6F6] text-[#2B2E30] border-[#E3E5E6] hover:border-black'
            } ${car.segment !== 'passenger' ? 'hidden' : ''}`}
            data-slug={car.slug}
            data-segment={car.segment}
          >
            <span>{car.name.replace('Mitsubishi ', '')}</span>
            {car.badge && (
              <span class={`text-[9px] font-bold px-1.5 py-0.2 ${idx === 0 ? 'bg-[#E60012] text-white' : 'bg-[#E3E5E6] text-[#2B2E30]'}`}>
                {car.badge}
              </span>
            )}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Active Model Display Container -->
  <main class="py-8 md:py-12 bg-[#F6F6F6] min-h-[500px]">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6">

      {carsData.map((car, idx) => {
        const isCommercial = car.segment === 'commercial';
        const carWaUrl = getWhatsAppLink(`Halo Kanhadi, saya ingin info diskon dan penawaran harga OTR terbaik untuk Mitsubishi ${car.name}.`);

        return (
          <article
            id={`panel-${car.slug}`}
            class={`model-panel bg-white border border-[#E3E5E6] shadow-sm transition-all duration-200 ${idx === 0 ? '' : 'hidden'}`}
            data-slug={car.slug}
            data-segment={car.segment}
          >
            <!-- Model Header Info -->
            <div class="p-6 md:p-8 border-b border-[#E3E5E6] flex flex-col md:flex-row md:items-center justify-between gap-6 bg-gradient-to-r from-white via-white to-[#FAFAFA]">
              <div class="flex items-center gap-5">
                <div class="w-24 h-16 md:w-32 md:h-20 flex-shrink-0 flex items-center justify-center p-1 bg-[#FAFAFA] border border-[#E3E5E6]">
                  <Image
                    src={car.image}
                    alt={car.name}
                    width={200}
                    height={120}
                    loading="lazy"
                    decoding="async"
                    class="max-h-full max-w-full object-contain"
                  />
                </div>
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span class={`text-[10px] font-black uppercase tracking-wider px-2 py-0.5 ${isCommercial ? 'bg-[#2B2E30] text-white' : 'bg-[#E60012] text-white'}`}>
                      {car.category}
                    </span>
                    {car.badge && (
                      <span class="text-[10px] font-bold text-[#686D71] border border-[#E3E5E6] px-2 py-0.5 uppercase tracking-wider">
                        {car.badge}
                      </span>
                    )}
                  </div>
                  <h2 class="text-xl md:text-2xl font-black text-[#1F2421] tracking-tight">
                    {car.name}
                  </h2>
                  <p class="text-xs text-[#686D71] mt-0.5 line-clamp-1 max-w-xl">
                    {car.tagline}
                  </p>
                </div>
              </div>

              <!-- Price & CTA -->
              <div class="flex items-center gap-4 flex-wrap md:flex-nowrap">
                <div class="text-left md:text-right">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-[#686D71] block">
                    {isCommercial ? 'Estimasi Harga' : 'Harga Mulai'}
                  </span>
                  <span class="text-lg md:text-xl font-black text-[#E60012]">
                    {isCommercial ? 'Hubungi Sales' : car.startingPrice}
                  </span>
                </div>
                <div class="flex items-center gap-2">
                  <a
                    href={`/model/${car.slug}`}
                    class="px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-[#2B2E30] border border-[#2B2E30] hover:bg-[#2B2E30] hover:text-white transition-colors"
                  >
                    Detail Model
                  </a>
                  <a
                    href={carWaUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-4 py-2.5 text-xs font-bold uppercase tracking-wider bg-[#E60012] hover:bg-[#B3000E] text-white transition-colors"
                  >
                    Minta Penawaran
                  </a>
                </div>
              </div>
            </div>

            <!-- Variants Table (Desktop) -->
            <div class="hidden md:block overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="bg-[#F6F6F6] border-b border-[#E3E5E6] text-[11px] font-bold uppercase tracking-wider text-[#686D71]">
                    <th class="py-3.5 px-6">Tipe &amp; Varian</th>
                    <th class="py-3.5 px-4">Transmisi</th>
                    <th class="py-3.5 px-6">Harga OTR Jakarta</th>
                    {!isCommercial && <th class="py-3.5 px-6">Estimasi DP</th>}
                    {!isCommercial && <th class="py-3.5 px-6">Estimasi Angsuran</th>}
                    <th class="py-3.5 px-6 text-right">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[#E3E5E6] text-sm">
                  {car.variants && car.variants.length > 0 ? (
                    car.variants.map((v) => {
                      const variantWaUrl = getWhatsAppLink(`Halo Kanhadi, saya ingin konsultasi penawaran harga OTR dan diskon cashback untuk varian: ${car.name} - ${v.name}.`);

                      return (
                        <tr class="hover:bg-[#FAFAFA] transition-colors">
                          <td class="py-4 px-6 font-semibold text-[#1F2421]">
                            {v.name}
                          </td>
                          <td class="py-4 px-4">
                            <span class="inline-block text-[11px] font-bold px-2 py-0.5 bg-[#E3E5E6] text-[#2B2E30]">
                              {v.transmission}
                            </span>
                          </td>
                          <td class="py-4 px-6 font-bold text-[#1F2421]">
                            {isCommercial ? (
                              <span class="text-xs font-bold text-[#686D71]">Hubungi Sales / Karoseri Khusus</span>
                            ) : (
                              v.priceFormatted
                            )}
                          </td>
                          {!isCommercial && (
                            <td class="py-4 px-6 text-[#686D71] text-xs">
                              {v.dpEstimate || car.dpStart || '-'}
                            </td>
                          )}
                          {!isCommercial && (
                            <td class="py-4 px-6 text-[#686D71] text-xs">
                              {v.cicilanEstimate || car.cicilanStart || '-'}
                            </td>
                          )}
                          <td class="py-4 px-6 text-right">
                            <a
                              href={variantWaUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="inline-block text-xs font-bold text-[#E60012] hover:text-[#B3000E] border border-[#E60012] hover:bg-[#E60012] hover:text-white px-3 py-1.5 transition-colors uppercase tracking-wider"
                            >
                              Minta Diskon
                            </a>
                          </td>
                        </tr>
                      );
                    })
                  ) : (
                    <tr>
                      <td colspan={isCommercial ? 4 : 6} class="py-6 px-6 text-center text-[#686D71] text-sm">
                        Hubungi Kanhadi via WhatsApp untuk rincian tipe dan penawaran OTR resmi {car.name}.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>

            <!-- Variants Card List (Mobile) -->
            <div class="block md:hidden divide-y divide-[#E3E5E6]">
              {car.variants && car.variants.length > 0 ? (
                car.variants.map((v) => {
                  const variantWaUrl = getWhatsAppLink(`Halo Kanhadi, saya ingin konsultasi penawaran harga OTR dan diskon cashback untuk varian: ${car.name} - ${v.name}.`);

                  return (
                    <div class="p-5 space-y-3">
                      <div class="flex items-start justify-between gap-3">
                        <div class="font-bold text-sm text-[#1F2421] leading-snug">
                          {v.name}
                        </div>
                        <span class="inline-block text-[10px] font-bold px-2 py-0.5 bg-[#E3E5E6] text-[#2B2E30] flex-shrink-0">
                          {v.transmission}
                        </span>
                      </div>

                      <div class="flex items-baseline justify-between pt-1">
                        <span class="text-xs text-[#686D71]">Harga OTR:</span>
                        <span class="text-sm font-black text-[#1F2421]">
                          {isCommercial ? 'Hubungi Sales' : v.priceFormatted}
                        </span>
                      </div>

                      {!isCommercial && (
                        <div class="grid grid-cols-2 gap-2 text-xs bg-[#FAFAFA] p-2.5 border border-[#E3E5E6]">
                          <div>
                            <span class="text-[#686D71] block text-[10px] uppercase">Estimasi DP</span>
                            <span class="font-bold text-[#2B2E30]">{v.dpEstimate || car.dpStart || '-'}</span>
                          </div>
                          <div>
                            <span class="text-[#686D71] block text-[10px] uppercase">Estimasi Cicilan</span>
                            <span class="font-bold text-[#2B2E30]">{v.cicilanEstimate || car.cicilanStart || '-'}</span>
                          </div>
                        </div>
                      )}

                      <a
                        href={variantWaUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-full text-center block text-xs font-bold bg-[#E60012] text-white py-2.5 uppercase tracking-wider hover:bg-[#B3000E] transition-colors"
                      >
                        Minta Penawaran Varian Ini
                      </a>
                    </div>
                  );
                })
              ) : (
                <div class="p-6 text-center text-xs text-[#686D71]">
                  Hubungi Kanhadi via WhatsApp untuk rincian varian {car.name}.
                </div>
              )}
            </div>
          </article>
        );
      })}

    </div>
  </main>

  <!-- Terms & Price Notes Section -->
  <section class="bg-white border-t border-[#E3E5E6] py-12">
    <div class="max-w-[1440px] mx-auto px-6">
      <div class="border border-[#E3E5E6] p-6 md:p-8 bg-[#FAFAFA]">
        <span class="text-[10px] font-black uppercase tracking-[0.2em] text-[#E60012] block mb-1">
          Ketentuan &amp; Informasi Pembelian
        </span>
        <h3 class="text-lg md:text-xl font-black text-[#1F2421] tracking-tight mb-3">
          Catatan Daftar Harga OTR Mitsubishi Jakarta
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-[#686D71] leading-relaxed">
          <ul class="space-y-2 list-disc list-inside">
            <li>Harga yang tercantum adalah tarif resmi On The Road (OTR) wilayah DKI Jakarta (Plat B).</li>
            <li>Untuk wilayah Bodetabek (Bogor, Depok, Tangerang, Bekasi) terdapat sedikit penyesuaian BBNKB daerah.</li>
            <li>Harga tertera adalah acuan sebelum dipotong diskon tunai, cashback spesial, dan paket subsidi DP.</li>
            <li>Harga kendaraan tidak mengikat dan dapat berubah sewaktu-waktu sesuai kebijakan resmi PT MMKSI.</li>
          </ul>
          <ul class="space-y-2 list-disc list-inside">
            <li>Melayani pembelian secara Cash, Kredit Fleet Perusahaan, COP Karyawan, maupun Tukar Tambah (Trade-In).</li>
            <li>Setiap pembelian mobil penumpang mendapatkan garansi resmi 3 Tahun / 100.000 KM dan Paket SMART servis berkala.</li>
            <li>Data dan berkas kredit dibantu sampai approval oleh sales konsultan Kanhadi.</li>
            <li>Kanhadi siap membawakan unit test drive langsung ke rumah atau kantor Anda di seluruh wilayah Jabodetabek.</li>
          </ul>
        </div>

        <div class="mt-6 pt-5 border-t border-[#E3E5E6] flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-xs text-[#2B2E30] font-medium">
            Ingin berkonsultasi langsung tentang diskon maksimal dan paket kredit?
          </div>
          <div class="flex items-center gap-3">
            <a
              href={`tel:${salesData.phone}`}
              class="px-4 py-2 text-xs font-bold uppercase tracking-wider text-[#2B2E30] border border-[#2B2E30] hover:bg-[#2B2E30] hover:text-white transition-colors"
            >
              Telepon: {salesData.whatsappDisplay}
            </a>
            <a
              href={waGeneral}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 text-xs font-bold uppercase tracking-wider bg-[#E60012] hover:bg-[#B3000E] text-white transition-colors"
            >
              Chat WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Model Switcher Script -->
  <script is:inline>
    const segButtons = document.querySelectorAll('.seg-btn');
    const modelTabButtons = document.querySelectorAll('.model-tab-btn');
    const modelPanels = document.querySelectorAll('.model-panel');

    function setActiveModel(slug) {
      // Update tab buttons
      modelTabButtons.forEach((btn) => {
        const isTarget = btn.getAttribute('data-slug') === slug;
        if (isTarget) {
          btn.classList.add('active', 'bg-[#1F2421]', 'text-white', 'border-[#1F2421]', 'shadow-sm');
          btn.classList.remove('bg-[#F6F6F6]', 'text-[#2B2E30]', 'border-[#E3E5E6]');
          const badge = btn.querySelector('span:last-child');
          if (badge && badge !== btn.querySelector('span:first-child')) {
            badge.classList.remove('bg-[#E3E5E6]', 'text-[#2B2E30]');
            badge.classList.add('bg-[#E60012]', 'text-white');
          }
          btn.scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });
        } else {
          btn.classList.remove('active', 'bg-[#1F2421]', 'text-white', 'border-[#1F2421]', 'shadow-sm');
          btn.classList.add('bg-[#F6F6F6]', 'text-[#2B2E30]', 'border-[#E3E5E6]');
          const badge = btn.querySelector('span:last-child');
          if (badge && badge !== btn.querySelector('span:first-child')) {
            badge.classList.remove('bg-[#E60012]', 'text-white');
            badge.classList.add('bg-[#E3E5E6]', 'text-[#2B2E30]');
          }
        }
      });

      // Update visible panel
      modelPanels.forEach((panel) => {
        if (panel.getAttribute('data-slug') === slug) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    }

    function setActiveSegment(segment) {
      // Update segment tab buttons
      segButtons.forEach((btn) => {
        const isTarget = btn.getAttribute('data-segment') === segment;
        if (isTarget) {
          btn.classList.add('active', 'bg-[#E60012]', 'text-white');
          btn.classList.remove('bg-[#2B2E30]', 'text-[#A6A9AB]');
        } else {
          btn.classList.remove('active', 'bg-[#E60012]', 'text-white');
          btn.classList.add('bg-[#2B2E30]', 'text-[#A6A9AB]');
        }
      });

      // Filter visible model buttons
      let firstVisibleSlug = null;
      modelTabButtons.forEach((btn) => {
        const seg = btn.getAttribute('data-segment');
        if (seg === segment) {
          btn.classList.remove('hidden');
          if (!firstVisibleSlug) {
            firstVisibleSlug = btn.getAttribute('data-slug');
          }
        } else {
          btn.classList.add('hidden');
        }
      });

      // Activate first visible model in this segment
      if (firstVisibleSlug) {
        setActiveModel(firstVisibleSlug);
      }
    }

    // Segment button clicks
    segButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const seg = btn.getAttribute('data-segment');
        setActiveSegment(seg);
      });
    });

    // Model button clicks
    modelTabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-slug');
        setActiveModel(slug);
      });
    });

    // Check URL hash on initial load
    window.addEventListener('DOMContentLoaded', () => {
      const hash = window.location.hash.replace('#', '').replace('model-', '');
      if (hash) {
        const targetBtn = Array.from(modelTabButtons).find((b) => b.getAttribute('data-slug') === hash);
        if (targetBtn) {
          const seg = targetBtn.getAttribute('data-segment');
          setActiveSegment(seg);
          setActiveModel(hash);
        }
      }
    });
  </script>
</Layout>
