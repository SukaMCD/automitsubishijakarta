---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { promoList } from '../data/promos';
import { salesData, getWhatsAppLink } from '../data/sales';

const passengerPromos = promoList.filter((p) => p.category === 'passenger');
const lcvPromos = promoList.filter((p) => p.category === 'lcv');
const tradeInPromos = promoList.filter((p) => p.category === 'trade-in');

const waGeneral = getWhatsAppLink('Halo Kanhadi, saya ingin konsultasi promo dan diskon Mitsubishi terbaru bulan ini.');
---

<Layout
  title="Promo Mobil Mitsubishi Jakarta 2026 | DP Ringan, Bunga 0% & Diskon - Kanhadi"
  description="Promo resmi mobil Mitsubishi Jakarta 2026. Diskon cashback puluhan juta, DP mulai 15 jt, bunga 0%, dan subsidi trade-in semua merk. Hubungi Kanhadi sekarang."
  currentPath="/promo"
>
  <!-- Hero Section -->
  <section class="bg-[#1A1C1E] text-white py-14 md:py-20 border-b border-white/10">
    <div class="max-w-[1440px] mx-auto px-6">
      
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-wider text-[#A6A9AB] mb-4">
        <a href="/" class="hover:text-white transition-colors">Beranda</a>
        <span>/</span>
        <span class="text-[#E60012]">Promo</span>
      </nav>

      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="max-w-3xl">
          <span class="text-[10px] font-black uppercase tracking-[0.2em] text-[#E60012] block mb-2">
            Penawaran Resmi Bulan Ini
          </span>
          <h1 class="text-3xl md:text-5xl font-black tracking-tight leading-tight">
            Promo Spesial Mitsubishi Jakarta
          </h1>
          <p class="text-[#A6A9AB] text-sm md:text-base leading-relaxed mt-4">
            Dapatkan penawaran terbaik untuk pembelian mobil baru Mitsubishi di wilayah Jakarta dan Jabodetabek. Pilihan program bunga 0%, paket DP super ringan, cashback puluhan juta rupiah, hingga bonus aksesoris dan paket servis resmi.
          </p>
        </div>

        <!-- Quick CTAs -->
        <div class="flex items-center gap-3 flex-shrink-0">
          <a
            href={waGeneral}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 bg-[#E60012] hover:bg-[#B3000E] text-white font-bold text-xs uppercase tracking-wider px-6 py-3.5 transition-colors"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            Konsultasi Promo
          </a>
          <a
            href="/#simulasi-kredit"
            class="inline-flex items-center gap-2 border border-white/30 hover:border-white text-white font-bold text-xs uppercase tracking-wider px-6 py-3.5 transition-colors"
          >
            Simulasi Kredit
          </a>
        </div>
      </div>

      <!-- Filter Tabs -->
      <div class="mt-10 flex flex-wrap gap-2">
        <button
          type="button"
          class="promo-tab-btn active px-5 py-2.5 text-[12px] font-bold uppercase tracking-wider transition-all bg-[#E60012] text-white cursor-pointer"
          data-category="all"
        >
          Semua Promo ({promoList.length})
        </button>
        <button
          type="button"
          class="promo-tab-btn px-5 py-2.5 text-[12px] font-bold uppercase tracking-wider transition-all bg-[#2B2E30] text-[#A6A9AB] hover:text-white cursor-pointer"
          data-category="passenger"
        >
          Mobil Penumpang ({passengerPromos.length})
        </button>
        <button
          type="button"
          class="promo-tab-btn px-5 py-2.5 text-[12px] font-bold uppercase tracking-wider transition-all bg-[#2B2E30] text-[#A6A9AB] hover:text-white cursor-pointer"
          data-category="lcv"
        >
          Niaga Ringan ({lcvPromos.length})
        </button>
        <button
          type="button"
          class="promo-tab-btn px-5 py-2.5 text-[12px] font-bold uppercase tracking-wider transition-all bg-[#2B2E30] text-[#A6A9AB] hover:text-white cursor-pointer"
          data-category="trade-in"
        >
          Tukar Tambah ({tradeInPromos.length})
        </button>
      </div>
    </div>
  </section>

  <!-- Promo Grid Section -->
  <main class="py-14 md:py-20 bg-[#F6F6F6]">
    <div class="max-w-[1440px] mx-auto px-6">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="promo-cards-container">
        {promoList.map((p) => {
          const promoWaUrl = getWhatsAppLink(`Halo Kanhadi, saya tertarik dengan promo: ${p.title}. Boleh info rincian dan cara klaimnya?`);

          return (
            <article
              class="promo-card bg-white border border-[#E3E5E6] hover:border-[#E60012] transition-all duration-300 flex flex-col justify-between overflow-hidden shadow-sm hover:shadow-md"
              data-category={p.category}
            >
              <!-- Card Top Image & Badges -->
              <div>
                <div class="p-6 pb-2 flex items-center justify-between border-b border-[#F0F0F0]">
                  <span class="text-[10px] font-black uppercase tracking-wider bg-[#E60012] text-white px-2.5 py-1">
                    {p.badge}
                  </span>
                  <span class="text-[11px] font-bold text-[#686D71] truncate max-w-[180px]">
                    {p.targetCar}
                  </span>
                </div>

                <div class="px-6 py-6 bg-[#FAFAFA] flex items-center justify-center border-b border-[#F0F0F0]">
                  <div class="h-36 w-full flex items-center justify-center">
                    <Image
                      src={p.image}
                      alt={p.title}
                      width={380}
                      height={200}
                      loading="lazy"
                      decoding="async"
                      class="max-h-full max-w-full object-contain hover:scale-105 transition-transform duration-300 pointer-events-none select-none"
                    />
                  </div>
                </div>

                <!-- Content Area -->
                <div class="p-6 space-y-4">
                  <div>
                    <h2 class="text-lg md:text-xl font-black text-[#1F2421] leading-snug tracking-tight">
                      {p.title}
                    </h2>
                    <p class="text-xs text-[#E60012] font-bold mt-1">
                      {p.subtitle}
                    </p>
                  </div>

                  <p class="text-xs text-[#686D71] leading-relaxed">
                    {p.description}
                  </p>

                  <!-- Highlight Pill -->
                  <div class="bg-[#F6F6F6] border-l-4 border-[#E60012] p-3 text-xs font-bold text-[#1F2421]">
                    {p.highlight}
                  </div>

                  <!-- Benefit List -->
                  <div class="space-y-2 pt-1">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-[#686D71] block">
                      Keuntungan &amp; Fasilitas:
                    </span>
                    <ul class="space-y-1.5 text-xs text-[#2B2E30]">
                      {p.benefits.map((b) => (
                        <li class="flex items-start gap-2">
                          <svg class="w-4 h-4 text-[#E60012] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                          </svg>
                          <span>{b}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>

              <!-- Card Footer -->
              <div class="p-6 pt-0 mt-4 border-t border-[#F0F0F0] pt-4 space-y-3">
                <div class="flex items-center justify-between text-[11px] text-[#686D71]">
                  <span>Masa Berlaku:</span>
                  <span class="font-bold text-[#1F2421]">{p.validPeriod}</span>
                </div>

                <div class="flex items-center gap-2">
                  <a
                    href={promoWaUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 text-center bg-[#E60012] hover:bg-[#B3000E] text-white text-xs font-bold py-3 uppercase tracking-wider transition-colors"
                  >
                    Klaim Promo Ini
                  </a>
                  <a
                    href={`/model/${p.carSlug}`}
                    class="px-3 py-3 border border-[#E3E5E6] hover:border-[#1F2421] text-[#2B2E30] text-xs font-bold uppercase tracking-wider transition-colors"
                    title="Lihat Spesifikasi Model"
                  >
                    Model
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

    </div>
  </main>

  <!-- Value Propositions Section -->
  <section class="bg-white border-y border-[#E3E5E6] py-14 md:py-20">
    <div class="max-w-[1440px] mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-[10px] font-black uppercase tracking-[0.2em] text-[#E60012] block mb-2">
          Jaminan Layanan Resmi
        </span>
        <h2 class="text-2xl md:text-3xl font-black text-[#1F2421] tracking-tight">
          Keuntungan Membeli Lewat Kanhadi
        </h2>
        <p class="text-xs md:text-sm text-[#686D71] mt-2">
          Setiap transaksi didukung langsung oleh dealer resmi 3S PT Lautan Berlian Utama Motor Jakarta.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="border border-[#E3E5E6] p-6 bg-[#FAFAFA] space-y-3">
          <div class="w-10 h-10 bg-[#E60012] text-white flex items-center justify-center font-bold text-sm">
            01
          </div>
          <h3 class="text-sm font-bold text-[#1F2421] uppercase tracking-wide">
            Garansi Resmi 3 Tahun
          </h3>
          <p class="text-xs text-[#686D71] leading-relaxed">
            Jaminan garansi mesin dan kelistrikan pabrik hingga 100.000 KM didukung bengkel resmi di seluruh Indonesia.
          </p>
        </div>

        <div class="border border-[#E3E5E6] p-6 bg-[#FAFAFA] space-y-3">
          <div class="w-10 h-10 bg-[#E60012] text-white flex items-center justify-center font-bold text-sm">
            02
          </div>
          <h3 class="text-sm font-bold text-[#1F2421] uppercase tracking-wide">
            Gratis Servis &amp; Oli
          </h3>
          <p class="text-xs text-[#686D71] leading-relaxed">
            Paket SMART Silver gratis jasa perawatan berkala dan suku cadang asli hingga 50.000 KM atau 4 tahun.
          </p>
        </div>

        <div class="border border-[#E3E5E6] p-6 bg-[#FAFAFA] space-y-3">
          <div class="w-10 h-10 bg-[#E60012] text-white flex items-center justify-center font-bold text-sm">
            03
          </div>
          <h3 class="text-sm font-bold text-[#1F2421] uppercase tracking-wide">
            Data Dibantu Approve
          </h3>
          <p class="text-xs text-[#686D71] leading-relaxed">
            Konsultasi BI Checking / SLIK OJK gratis, proses berkas dijemput langsung ke rumah, approval kilat 1-3 hari kerja.
          </p>
        </div>

        <div class="border border-[#E3E5E6] p-6 bg-[#FAFAFA] space-y-3">
          <div class="w-10 h-10 bg-[#E60012] text-white flex items-center justify-center font-bold text-sm">
            04
          </div>
          <h3 class="text-sm font-bold text-[#1F2421] uppercase tracking-wide">
            Test Drive ke Rumah
          </h3>
          <p class="text-xs text-[#686D71] leading-relaxed">
            Ingin mencoba mobil bersama keluarga sebelum membeli? Kanhadi siap antar unit test drive langsung ke alamat Anda.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Terms & Policy Section -->
  <section class="bg-[#F6F6F6] py-12">
    <div class="max-w-[1440px] mx-auto px-6">
      <div class="border border-[#E3E5E6] p-6 md:p-8 bg-white">
        <span class="text-[10px] font-black uppercase tracking-[0.2em] text-[#E60012] block mb-1">
          Ketentuan Program Promo
        </span>
        <h3 class="text-lg md:text-xl font-black text-[#1F2421] tracking-tight mb-3">
          Syarat &amp; Ketentuan Promo Mitsubishi
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-[#686D71] leading-relaxed">
          <ul class="space-y-2 list-disc list-inside">
            <li>Program promo berlaku untuk pemesanan Surat Pesanan Kendaraan (SPK) di bulan berjalan.</li>
            <li>Paket pembiayaan bunga 0% dan DP minim berlaku melalui perusahaan pembiayaan rekanan resmi terdaftar OJK.</li>
            <li>Cashback dan subsidi diskon dapat disesuaikan dengan skema pembayaran tunai atau kredit yang dipilih.</li>
          </ul>
          <ul class="space-y-2 list-disc list-inside">
            <li>Bonus aksesoris (kaca film, karpet, dll.) merupakan paket resmi bergaransi yang langsung terpasang pada saat serah terima unit.</li>
            <li>Program Tukar Tambah (Trade-In) berlaku untuk semua merk, tipe, dan tahun kendaraan lama.</li>
            <li>Unit promo memiliki alokasi kuota tertentu dan dapat berubah sewaktu-waktu sesuai ketentuan PT MMKSI.</li>
          </ul>
        </div>

        <div class="mt-6 pt-5 border-t border-[#E3E5E6] flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-xs text-[#2B2E30] font-medium">
            Ingin mengetahui promo terbaik yang paling cocok untuk budget Anda?
          </div>
          <div class="flex items-center gap-3">
            <a
              href={`tel:${salesData.phone}`}
              class="px-4 py-2 text-xs font-bold uppercase tracking-wider text-[#2B2E30] border border-[#2B2E30] hover:bg-[#2B2E30] hover:text-white transition-colors"
            >
              Telepon: {salesData.whatsappDisplay}
            </a>
            <a
              href={waGeneral}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 text-xs font-bold uppercase tracking-wider bg-[#E60012] hover:bg-[#B3000E] text-white transition-colors"
            >
              Chat WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Client-side Category Filtering Script -->
  <script is:inline>
    const tabButtons = document.querySelectorAll('.promo-tab-btn');
    const promoCards = document.querySelectorAll('.promo-card');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabButtons.forEach((b) => {
          b.classList.remove('active', 'bg-[#E60012]', 'text-white');
          b.classList.add('bg-[#2B2E30]', 'text-[#A6A9AB]');
        });
        btn.classList.add('active', 'bg-[#E60012]', 'text-white');
        btn.classList.remove('bg-[#2B2E30]', 'text-[#A6A9AB]');

        const cat = btn.getAttribute('data-category');

        promoCards.forEach((card) => {
          const itemCat = card.getAttribute('data-category');
          if (cat === 'all' || itemCat === cat) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  </script>
</Layout>
