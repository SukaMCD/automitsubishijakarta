---
import Layout from '../layouts/Layout.astro';
import { salesData, getWhatsAppLink } from '../data/sales';
import { carsData } from '../data/cars';
import { promoList } from '../data/promos';
import { testimonialsData } from '../data/testimonials';

const waBase = getWhatsAppLink('Halo Om Hadi, saya ingin konsultasi promo dan kredit Mitsubishi terbaru.');

const heroSlides = [
  {
    key: 'pajero',
    badge: 'Flagship SUV',
    title: 'New Pajero Sport',
    desc: 'SUV 7-penumpang berkelas dengan mesin diesel 4D56, dominasi setiap medan.',
    price: 'Rp 578 Juta',
    cicilan: '9,8 Jt-an',
    link: '/model/pajero-sport',
    img: '/images/cars/new-pajero-sport-optimized.webp',
    pillLabel: 'Pajero Sport',
  },
  {
    key: 'xpander',
    badge: 'MPV Terlaris',
    title: 'New Mitsubishi Xpander',
    desc: 'MPV keluarga paling laris di Indonesia, kabin senyap, suspensi ternyaman di kelasnya.',
    price: 'Rp 270 Juta',
    cicilan: '4,2 Jt-an',
    link: '/model/xpander',
    img: '/images/cars/xpander-optimized.webp',
    pillLabel: 'Xpander',
  },
  {
    key: 'xforce',
    badge: 'Compact SUV',
    title: 'Mitsubishi XForce',
    desc: 'Crossover urban berkarakter tinggi dengan Dynamic Sound Yamaha Premium.',
    price: 'Rp 382 Juta',
    cicilan: '5,9 Jt-an',
    link: '/model/xforce',
    img: '/images/cars/new-xforce-optimized.webp',
    pillLabel: 'XForce',
  },
];
---

<Layout
  title="Dealer Resmi Mitsubishi Jakarta | Promo & Kredit - Om Hadi"
  description="Sales Konsultan Resmi Mitsubishi Motors Jakarta. DP mulai 20 jt, bunga 0%, data dibantu sampai approve. Hubungi Om Hadi sekarang."
  currentPath="/">


  <!-- ========================================================
       HERO - Full viewport with smooth cross-fade slides
  ======================================================== -->
  <section class="relative w-full bg-black overflow-hidden" style="height: min(90vh, 700px);">

    <!-- Stacked Slides for Clean Pure Opacity Crossfade -->
    {heroSlides.map((slide, i) => (
      <div 
        class="hero-slide absolute inset-0 transition-opacity duration-500 ease-in-out" 
        data-index={i}
        style={i === 0 ? "opacity: 1; z-index: 10; pointer-events: auto;" : "opacity: 0; z-index: 0; pointer-events: none;"}
      >
        <!-- Background car image layer -->
        <div class="absolute inset-0 overflow-hidden">
          <img 
            src={slide.img} 
            alt={slide.title}
            loading="eager"
            class="w-full h-full object-cover object-center opacity-75"
          />
          <div class="absolute inset-0 bg-black/40"></div>
          <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.3) 55%, transparent 100%);"></div>
        </div>

        <!-- Text Content -->
        <div class="relative z-10 max-w-[1440px] mx-auto px-6 h-full flex flex-col justify-end pb-16 md:pb-20">
          <div class="max-w-xl text-white space-y-4">
            <span class="inline-block bg-[#E60012] text-white text-[10px] font-black uppercase tracking-[0.15em] px-3 py-1.5">
              {slide.badge}
            </span>

            <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-[1.05]">
              {slide.title}
            </h1>

            <p class="text-[#BFC2C4] text-base leading-relaxed">
              {slide.desc}
            </p>

            <div class="flex items-center gap-4 pt-2">
              <div class="space-y-0.5">
                <div class="text-[11px] text-[#BFC2C4] uppercase tracking-wider">OTR Jakarta Mulai</div>
                <div class="text-2xl font-black">{slide.price}</div>
              </div>
              <div class="w-px h-10 bg-white/20"></div>
              <div class="space-y-0.5">
                <div class="text-[11px] text-[#BFC2C4] uppercase tracking-wider">Cicilan / Bulan</div>
                <div class="text-2xl font-black text-[#E60012]">{slide.cicilan}</div>
              </div>
            </div>

            <div class="flex items-center gap-3 pt-2">
              <a href={slide.link}
                class="inline-flex items-center gap-2 bg-[#E60012] hover:bg-white hover:text-black text-white text-[13px] font-bold px-6 py-3 transition-colors duration-200">
                Lihat Detail
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </a>
              <a href={waBase} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 border border-white/40 hover:border-white text-white text-[13px] font-semibold px-6 py-3 transition-colors backdrop-blur-sm">
                Tanya Harga WA
              </a>
            </div>
          </div>
        </div>
      </div>
    ))}

    <!-- Hero model nav pills - bottom right -->
    <div class="absolute bottom-6 right-6 z-20 flex gap-2">
      {heroSlides.map((item, i) => (
        <button 
          type="button" 
          class="hero-pill text-white text-[11px] font-bold px-3.5 py-2 border transition-all duration-300"
          data-slide-index={i}
          style={i === 0 ? "background: #E60012; border-color: #E60012;" : "background: rgba(0,0,0,0.55); border-color: rgba(255,255,255,0.2); backdrop-filter: blur(8px);"}
        >
          {item.pillLabel}
        </button>
      ))}
    </div>

    <!-- Scroll cue -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 hidden md:flex flex-col items-center gap-1.5">
      <span class="text-[10px] text-white/50 uppercase tracking-[0.15em]">Scroll</span>
      <div class="w-px h-8 bg-white/20"></div>
    </div>

  </section>


  <!-- ========================================================
       MODEL SHOWCASE CAROUSEL - 5-Item View with Edge Fade (MMKSI Style)
  ======================================================== -->
  <section class="bg-white border-b border-[#E3E5E6] py-12 md:py-16 overflow-hidden">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6">
      
      <!-- Carousel Track with edge fade mask -->
      <div class="relative w-full">
        <div 
          id="model-carousel" 
          class="flex gap-4 sm:gap-6 md:gap-8 overflow-x-auto scroll-smooth scrollbar-none snap-x snap-mandatory py-4 px-8 sm:px-14 md:px-20"
          style="scrollbar-width: none; -ms-overflow-style: none; mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);"
        >
          {carsData.map((car) => (
            <a 
              href={`/model/${car.slug}`}
              class="model-carousel-card flex-shrink-0 w-[240px] sm:w-[260px] md:w-[280px] lg:w-[300px] snap-center group flex flex-col justify-between p-3 sm:p-4 bg-transparent transition-all duration-300 rounded-none"
            >
              <!-- Badge Container -->
              <div class="h-6 flex items-center justify-end px-1">
                {car.badge ? (
                  <span class="bg-[#E60012] text-white text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5">
                    {car.badge}
                  </span>
                ) : (
                  <span class="invisible text-[10px] px-2.5 py-0.5">BADGE</span>
                )}
              </div>

              <!-- Car Image -->
              <div class="h-28 sm:h-32 md:h-36 w-full flex items-center justify-center my-3 overflow-hidden">
                <img 
                  src={car.image} 
                  alt={car.name}
                  loading="lazy"
                  class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300 drop-shadow-sm"
                />
              </div>

              <!-- Car Info -->
              <div class="text-center pt-2 pb-1">
                <h3 class="text-xs sm:text-sm md:text-base font-black text-black group-hover:text-[#E60012] transition-colors uppercase tracking-wider leading-tight">
                  {car.name}
                </h3>
                <p class="text-[11px] sm:text-xs md:text-[13px] text-[#555] font-normal mt-1">
                  Mulai dari {car.startingPrice}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Navigation & Compare Bar (MMKSI Style) -->
      <div class="mt-8 pt-4 flex items-center justify-between max-w-3xl mx-auto px-4">
        <!-- Prev Arrow -->
        <button 
          id="model-prev-btn" 
          type="button" 
          aria-label="Sebelumnya"
          class="group p-2 text-black hover:text-[#E60012] transition-colors"
        >
          <svg class="w-8 sm:w-10 h-8 sm:h-10 transition-transform group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m7-7l-7 7 7 7"/>
          </svg>
        </button>

        <!-- Center Link -->
        <a 
          href="/model" 
          class="text-xs sm:text-sm font-black uppercase tracking-[0.2em] text-black border-b-2 border-black hover:text-[#E60012] hover:border-[#E60012] pb-1 transition-colors"
        >
          BANDINGKAN KENDARAAN
        </a>

        <!-- Next Arrow -->
        <button 
          id="model-next-btn" 
          type="button" 
          aria-label="Selanjutnya"
          class="group p-2 text-black hover:text-[#E60012] transition-colors"
        >
          <svg class="w-8 sm:w-10 h-8 sm:h-10 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7l7 7-7 7"/>
          </svg>
        </button>
      </div>

    </div>
  </section>


  <!-- ========================================================
       PROMO SECTION - Editorial press-release style
  ======================================================== -->
  <section class="bg-[#111111] text-white">
    <div class="max-w-[1440px] mx-auto">

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr]">

        <!-- Left: Headline column -->
        <div class="px-6 sm:px-8 md:px-14 py-12 md:py-20 border-b lg:border-b-0 lg:border-r border-[#222] flex flex-col justify-between">
          <div>
            <div class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#E60012] mb-4">Penawaran Aktif</div>
            <h2 class="text-3xl md:text-[2.8rem] font-black leading-[1.08] tracking-tight mb-6">
              Promo<br class="hidden sm:inline"/> Bulan Ini
            </h2>
            <p class="text-[13px] text-[#888] leading-relaxed max-w-[280px]">
              Program kredit subsidi, bunga 0%, cashback puluhan juta, dan paket servis resmi untuk unit pilihan. Kuota terbatas setiap bulannya.
            </p>
          </div>

          <div class="mt-10 flex flex-col sm:flex-row lg:flex-col gap-3">
            <a href="/promo"
              class="inline-flex items-center justify-center gap-2 bg-[#E60012] hover:bg-white hover:text-black text-white text-[13px] font-bold px-6 py-3.5 transition-colors duration-200">
              Lihat Semua Promo
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href={waBase} target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center text-[12px] text-[#888] hover:text-white transition-colors underline underline-offset-4 py-1">
              Konsultasi promo via WhatsApp
            </a>
          </div>
        </div>

        <!-- Right: Promo list editorial table -->
        <div class="divide-y divide-[#1E1E1E]">
          {promoList.map((p, i) => (
            <a 
              href="/promo" 
              class="group flex items-stretch gap-0 hover:bg-[#181818] transition-colors duration-200 cursor-pointer block"
            >
              <!-- Index number -->
              <div class="w-12 sm:w-16 flex-shrink-0 flex items-center justify-center border-r border-[#1E1E1E] py-6 sm:py-8">
                <span class="text-[11px] font-mono font-bold text-[#666] group-hover:text-[#E60012] transition-colors">0{i + 1}</span>
              </div>

              <!-- Main content -->
              <div class="flex-1 px-5 sm:px-8 py-6 sm:py-8 flex flex-col md:flex-row md:items-center md:justify-between gap-3 sm:gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="text-[10px] font-black uppercase tracking-widest text-[#E60012]">{p.badge}</span>
                    <span class="text-[#333]">·</span>
                    <span class="text-[11px] text-[#888]">{p.targetCar}</span>
                  </div>
                  <h3 class="text-[15px] sm:text-[16px] font-bold text-white group-hover:text-[#E60012] transition-colors leading-snug">
                    {p.title}
                  </h3>
                </div>

                <div class="flex-shrink-0 md:text-right flex md:flex-col flex-row items-baseline md:items-end justify-between md:justify-center gap-2 pt-2 md:pt-0">
                  <span class="text-[13px] font-bold text-white group-hover:text-[#E60012] transition-colors">{p.highlight}</span>
                  <span class="text-[10px] font-medium text-[#777] uppercase tracking-wider">{p.validPeriod}</span>
                </div>
              </div>

              <!-- Arrow action -->
              <div class="w-12 sm:w-16 flex-shrink-0 flex items-center justify-center border-l border-[#1E1E1E] text-[#555] group-hover:text-white group-hover:bg-[#E60012] transition-colors">
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </a>
          ))}
        </div>

      </div>

      <!-- Bottom terms bar (full-width centered) -->
      <div class="py-4 border-t border-[#1E1E1E] text-center">
        <span class="text-[11px] text-[#777]">Pembaruan berkala · Syarat & ketentuan berlaku</span>
      </div>
    </div>
  </section>


  <!-- ========================================================
       FLAGSHIP FEATURE - Big editorial split (MMKSI style)
  ======================================================== -->
  <section class="bg-white">
    <div class="max-w-[1440px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2">

        <!-- Left: Image -->
        <div class="relative bg-white h-80 lg:h-[560px] overflow-hidden flex items-center justify-center p-4 lg:p-8">
          <img src="/images/cars/new-pajero-sport-optimized.webp" alt="Pajero Sport"
            class="w-full h-full object-contain object-center hover:scale-105 transition-transform duration-500" />
          <div class="absolute top-6 left-6">
            <span class="bg-[#E60012] text-white text-[10px] font-black uppercase tracking-[0.15em] px-3 py-1.5">Bestseller</span>
          </div>
        </div>

        <!-- Right: Content -->
        <div class="px-8 md:px-16 py-12 lg:py-20 flex flex-col justify-center space-y-6">
          <div class="space-y-2">
            <div class="text-[10px] font-black uppercase tracking-[0.15em] text-[#686D71]">Model Unggulan</div>
            <h2 class="text-3xl md:text-4xl font-black tracking-tight text-[#2B2E30] leading-tight">
              New Pajero Sport
            </h2>
            <p class="text-[#686D71] text-[14px] leading-relaxed">
              SUV premium 7-penumpang dengan mesin diesel 4D56 2.4L, all-wheel drive Super Select 4WD-II, dan kabin mewah setara kelas premium Eropa.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-3">
            {[
              { label: 'Kapasitas', val: '7 Penumpang' },
              { label: 'Mesin', val: '4D56 2.4L Diesel' },
              { label: 'Tenaga', val: '181 PS / 430 Nm' },
              { label: 'Garansi', val: '5 Thn / 150.000 km' },
            ].map((s) => (
              <div class="border border-[#E3E5E6] p-3.5">
                <div class="text-[10px] text-[#686D71] uppercase tracking-wider">{s.label}</div>
                <div class="text-[13px] font-bold text-[#2B2E30] mt-0.5">{s.val}</div>
              </div>
            ))}
          </div>

          <div class="pt-2 space-y-2">
            <div class="flex items-baseline gap-2">
              <span class="text-[11px] text-[#686D71]">OTR Jakarta Mulai</span>
              <span class="text-2xl font-black text-[#E60012]">Rp 578 Juta</span>
            </div>
            <div class="flex gap-3">
              <a href="/model/pajero-sport"
                class="inline-flex items-center gap-2 bg-black hover:bg-[#E60012] text-white text-[13px] font-bold px-6 py-3 transition-colors duration-200">
                Detail & Varian
              </a>
              <a href={getWhatsAppLink('Halo Om Hadi, saya tertarik dengan New Pajero Sport. Bisa minta penawaran terbaik?')}
                target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 border border-[#2B2E30] hover:bg-[#2B2E30] hover:text-white text-[#2B2E30] text-[13px] font-bold px-6 py-3 transition-colors">
                Tanya WA
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ========================================================
       SIMULASI KREDIT - Clean calculator section
  ======================================================== -->
  <section class="bg-[#F6F6F6] py-16 md:py-24 border-y border-[#E3E5E6]">
    <div class="max-w-[1440px] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

        <!-- Left -->
        <div class="lg:col-span-4 space-y-4">
          <div>
            <div class="text-[10px] font-black uppercase tracking-[0.15em] text-[#E60012] mb-2">Kalkulator Instan</div>
            <h2 class="text-3xl font-black tracking-tight text-[#2B2E30]">Simulasi Kredit</h2>
          </div>
          <p class="text-[13px] text-[#686D71] leading-relaxed">
            Hitung estimasi cicilan bulanan sesuai model, uang muka, dan tenor yang Anda inginkan. Hasilnya bisa langsung dikirim ke WhatsApp Om Hadi.
          </p>
          <div class="space-y-3 pt-2">
            {[
              'Pilih model & varian',
              'Tentukan DP dan tenor',
              'Estimasi cicilan muncul otomatis',
              'Kirim ke Om Hadi untuk penawaran final',
            ].map((s, i) => (
              <div class="flex items-center gap-3 text-[13px] text-[#2B2E30]">
                <span class="w-6 h-6 flex-shrink-0 bg-[#E60012] text-white text-[10px] font-black flex items-center justify-center">{i+1}</span>
                {s}
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Calculator -->
        <div class="lg:col-span-8">
          <div class="bg-white border border-[#E3E5E6] p-7 md:p-10 space-y-7">

            <!-- Model select (Custom Editorial Dropdown) -->
            <div>
              <label id="cc-car-label" class="block text-[11px] font-bold uppercase tracking-[0.12em] text-[#686D71] mb-2">Pilih Model</label>
              
              <!-- Hidden select for form/data backing -->
              <select id="cc-car" class="sr-only" tabindex="-1" aria-hidden="true">
                {carsData.map((car) => (
                  <option value={car.slug} data-price={car.startingPriceNum} data-name={car.name}>
                    {car.name} - Mulai {car.startingPrice}
                  </option>
                ))}
              </select>

              <!-- Custom Dropdown Component -->
              <div class="relative" id="cc-dropdown">
                <button
                  type="button"
                  id="cc-dropdown-trigger"
                  class="w-full flex items-center justify-between border border-[#E3E5E6] hover:border-[#686D71] focus:border-[#E60012] focus:ring-1 focus:ring-[#E60012] focus:outline-none bg-white px-4 py-3.5 text-left transition-all cursor-pointer"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-labelledby="cc-car-label cc-dropdown-trigger"
                >
                  <div class="flex items-center justify-between w-full pr-3 min-w-0">
                    <span id="cc-selected-name" class="text-[14px] font-bold text-[#1F2421] truncate">
                      {carsData[0].name}
                    </span>
                    <span id="cc-selected-price" class="text-[12px] font-semibold text-[#686D71] whitespace-nowrap ml-2">
                      Mulai {carsData[0].startingPrice}
                    </span>
                  </div>
                  <svg id="cc-dropdown-chevron" class="w-4 h-4 text-[#686D71] transition-transform duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>

                <!-- Dropdown Menu List -->
                <div
                  id="cc-dropdown-menu"
                  class="hidden absolute left-0 right-0 top-full mt-1.5 bg-white border border-[#E3E5E6] shadow-xl z-40 max-h-72 overflow-y-auto divide-y divide-[#F0F2F3]"
                  role="listbox"
                  tabindex="-1"
                >
                  {carsData.map((car, idx) => (
                    <button
                      type="button"
                      class={`cc-dropdown-option w-full flex items-center justify-between px-4 py-3 text-left transition-colors cursor-pointer hover:bg-[#F6F6F6] ${idx === 0 ? 'bg-[#FAFAFA] font-semibold' : ''}`}
                      data-index={idx}
                      data-slug={car.slug}
                      role="option"
                      aria-selected={idx === 0 ? 'true' : 'false'}
                    >
                      <div class="flex items-center gap-2.5 min-w-0 pr-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#E60012] flex-shrink-0 transition-opacity" style={idx === 0 ? 'opacity: 1;' : 'opacity: 0;'}></span>
                        <span class="text-[14px] text-[#1F2421] truncate">{car.name}</span>
                      </div>
                      <div class="flex items-center gap-3 flex-shrink-0">
                        <span class="text-[12px] text-[#686D71] font-medium">Mulai {car.startingPrice}</span>
                        <svg class="w-4 h-4 text-[#E60012] transition-opacity" style={idx === 0 ? 'opacity: 1;' : 'opacity: 0;'} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                      </div>
                    </button>
                  ))}
                </div>
              </div>
            </div>

            <!-- DP Slider -->
            <div>
              <div class="flex justify-between items-center mb-3">
                <label for="cc-dp" class="text-[11px] font-bold uppercase tracking-[0.12em] text-[#686D71]">Uang Muka (DP)</label>
                <div class="flex items-center gap-2">
                  <span id="cc-dp-pct" class="text-[15px] font-black text-[#2B2E30]">20%</span>
                  <span class="text-[#BFC2C4]">/</span>
                  <span id="cc-dp-nom" class="text-[13px] text-[#686D71] font-medium">Rp 115 Jt</span>
                </div>
              </div>
              <input type="range" id="cc-dp" min="15" max="50" step="1" value="20" class="w-full cursor-pointer" />
              <div class="flex justify-between text-[10px] text-[#BFC2C4] mt-2 font-medium">
                <span>15%</span><span>25%</span><span>35%</span><span>45%</span><span>50%</span>
              </div>
            </div>

            <!-- Tenor -->
