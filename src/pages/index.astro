</Layout>


<script is:inline>
/* === Smooth Hero Slide Switcher === */
const heroSlides = document.querySelectorAll('.hero-slide');
const heroPills = document.querySelectorAll('.hero-pill');
let currentHeroIndex = 0;
let heroAutoTimer = null;

function setHeroSlide(index) {
  currentHeroIndex = index;
  heroSlides.forEach((slide, i) => {
    if (i === index) {
      slide.style.opacity = '1';
      slide.style.zIndex = '10';
      slide.style.pointerEvents = 'auto';
    } else {
      slide.style.opacity = '0';
      slide.style.zIndex = '0';
      slide.style.pointerEvents = 'none';
    }
  });

  heroPills.forEach((pill, i) => {
    if (i === index) {
      pill.style.background = '#E60012';
      pill.style.borderColor = '#E60012';
      pill.style.color = '#ffffff';
    } else {
      pill.style.background = 'rgba(0,0,0,0.55)';
      pill.style.borderColor = 'rgba(255,255,255,0.2)';
      pill.style.color = '#ffffff';
    }
  });
}

heroPills.forEach((pill) => {
  pill.addEventListener('click', () => {
    const idx = parseInt(pill.getAttribute('data-slide-index'));
    if (!isNaN(idx)) {
      setHeroSlide(idx);
      resetAutoHero();
    }
  });
});

function resetAutoHero() {
  if (heroAutoTimer) clearInterval(heroAutoTimer);
  heroAutoTimer = setInterval(() => {
    if (heroSlides.length > 0) {
      const nextIdx = (currentHeroIndex + 1) % heroSlides.length;
      setHeroSlide(nextIdx);
    }
  }, 6000);
}

resetAutoHero();

/* === Model Carousel Navigation & Edge Fade === */
const modelCarousel = document.getElementById('model-carousel');
const prevBtn = document.getElementById('model-prev-btn');
const nextBtn = document.getElementById('model-next-btn');

/* === Model Carousel Segment Filter === */
const filterBtns = document.querySelectorAll('.carousel-filter-btn');
const carouselCards = document.querySelectorAll('.model-carousel-card');

filterBtns.forEach((btn) => {
  btn.addEventListener('click', () => {
    const filter = btn.getAttribute('data-filter');
    filterBtns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    carouselCards.forEach((card) => {
      const seg = card.getAttribute('data-segment');
      if (seg === filter) {
        card.style.display = 'flex';
        card.style.opacity = '1';
      } else {
        card.style.display = 'none';
      }
    });

    if (modelCarousel) {
      if (filter === 'commercial' || filter === 'lcv') {
        modelCarousel.classList.add('justify-center');
      } else {
        modelCarousel.classList.remove('justify-center');
      }
      modelCarousel.scrollTo({ left: 0, behavior: 'smooth' });
    }
  });
});

if (modelCarousel && prevBtn && nextBtn) {
  const getScrollDistance = () => {
    const card = modelCarousel.querySelector('.model-carousel-card');
    return card ? card.offsetWidth + 24 : 300;
  };

  prevBtn.addEventListener('click', () => {
    modelCarousel.scrollBy({ left: -getScrollDistance(), behavior: 'smooth' });
  });

  nextBtn.addEventListener('click', () => {
    modelCarousel.scrollBy({ left: getScrollDistance(), behavior: 'smooth' });
  });

  // Pastikan semua kartu selalu 100% solid & terang
  carouselCards.forEach((card) => {
    card.style.opacity = '1';
  });
}

/* === Credit Calculator === */
const WA_NUM = '6287808097263';
let calcTenor = 5;

function formatRp(n) {
  if (n >= 1e9) return 'Rp ' + (n/1e9).toFixed(2).replace('.',',') + ' M';
  if (n >= 1e6) return 'Rp ' + Math.round(n/1e6) + ' Jt';
  return 'Rp ' + Math.round(n).toLocaleString('id-ID');
}

function calcUpdate() {
  const sel = document.getElementById('cc-car');
  const slider = document.getElementById('cc-dp');
  if (!sel || !slider) return;

  const opt = sel.options[sel.selectedIndex];
  const price = parseFloat(opt.getAttribute('data-price'));
  const carName = opt.getAttribute('data-name') || opt.text.split(' - ')[0].trim();
  const dpPct = parseInt(slider.value);
  const min = parseFloat(slider.min) || 15;
  const max = parseFloat(slider.max) || 50;
  const fillPct = Math.min(100, Math.max(0, ((dpPct - min) / (max - min)) * 100));
  slider.style.background = `linear-gradient(to right, #E60012 0%, #E60012 ${fillPct}%, #E3E5E6 ${fillPct}%, #E3E5E6 100%)`;

  const dp = price * dpPct / 100;
  const loan = price - dp;
  const months = calcTenor * 12;
  const monthly = (loan + loan * 0.048 * calcTenor) / months;

  document.getElementById('cc-dp-pct').textContent = dpPct + '%';
  document.getElementById('cc-dp-nom').textContent = formatRp(dp);
  document.getElementById('cc-dp-result').textContent = formatRp(dp);
  document.getElementById('cc-cicilan-result').textContent = formatRp(monthly) + ' / bln';

  const msg = `Halo Kanhadi, ini hasil simulasi kredit saya:\n• Mobil: ${carName}\n• DP: ${dpPct}% = ${formatRp(dp)}\n• Tenor: ${calcTenor} tahun\n• Estimasi cicilan: ${formatRp(monthly)}/bln\n\nBisa tolong info promo & bunga terbaiknya?`;
  const btn = document.getElementById('cc-wa-link');
  if (btn) btn.href = 'https://wa.me/' + WA_NUM + '?text=' + encodeURIComponent(msg);
}

document.querySelectorAll('.cc-tenor').forEach(btn => {
  btn.addEventListener('click', () => {
    calcTenor = parseInt(btn.getAttribute('data-years'));
    document.querySelectorAll('.cc-tenor').forEach(b => {
      b.style.background = '#fff'; b.style.color = '#2B2E30'; b.style.borderColor = '#E3E5E6';
    });
    btn.style.background = '#E60012'; btn.style.color = '#fff'; btn.style.borderColor = '#E60012';
    calcUpdate();
  });
});

document.getElementById('cc-car')?.addEventListener('change', calcUpdate);
document.getElementById('cc-dp')?.addEventListener('input', calcUpdate);

/* === Custom Dropdown Controls === */
const ddWrapper = document.getElementById('cc-dropdown');
const ddTrigger = document.getElementById('cc-dropdown-trigger');
const ddMenu = document.getElementById('cc-dropdown-menu');
const ddChevron = document.getElementById('cc-dropdown-chevron');
const ddName = document.getElementById('cc-selected-name');
const ddPrice = document.getElementById('cc-selected-price');
const ddOptions = document.querySelectorAll('.cc-dropdown-option');

function openDropdown() {
  closeFeatDropdown();
  if (!ddMenu || !ddTrigger) return;
  const rect = ddTrigger.getBoundingClientRect();
  const spaceBelow = window.innerHeight - rect.bottom;
  const spaceAbove = rect.top;

  if (spaceBelow < 280 && spaceAbove > spaceBelow) {
    ddMenu.classList.remove('top-full', 'mt-1.5');
    ddMenu.classList.add('bottom-full', 'mb-1.5');
  } else {
    ddMenu.classList.remove('bottom-full', 'mb-1.5');
    ddMenu.classList.add('top-full', 'mt-1.5');
  }

  ddMenu.classList.remove('hidden');
  ddTrigger.setAttribute('aria-expanded', 'true');
  ddChevron?.classList.add('rotate-180');
}

function closeDropdown() {
  if (!ddMenu) return;
  ddMenu.classList.add('hidden');
  ddTrigger?.setAttribute('aria-expanded', 'false');
  ddChevron?.classList.remove('rotate-180');
}

function toggleDropdown() {
  if (ddMenu?.classList.contains('hidden')) {
    openDropdown();
  } else {
    closeDropdown();
  }
}

function selectDropdownOption(index) {
  const sel = document.getElementById('cc-car');
  if (!sel || !sel.options[index]) return;
  sel.selectedIndex = index;
  const opt = sel.options[index];
  const name = opt.getAttribute('data-name') || opt.text.split(' - ')[0].trim();
  const priceMatch = opt.text.match(/Mulai\s+Rp\s+[\d.]+/i);
  const priceText = priceMatch ? priceMatch[0] : '';

  if (ddName) ddName.textContent = name;
  if (ddPrice) ddPrice.textContent = priceText;

  ddOptions.forEach((btn, i) => {
    const isSelected = i === index;
    btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
    btn.classList.toggle('bg-[#FAFAFA]', isSelected);
    btn.classList.toggle('font-semibold', isSelected);

    const dot = btn.querySelector('span.rounded-full');
    if (dot) dot.style.opacity = isSelected ? '1' : '0';

    const check = btn.querySelector('svg');
    if (check) check.style.opacity = isSelected ? '1' : '0';
  });

  closeDropdown();
  calcUpdate();
}

ddTrigger?.addEventListener('click', (e) => {
  e.stopPropagation();
  toggleDropdown();
});

ddTrigger?.addEventListener('keydown', (e) => {
  if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
    e.preventDefault();
    openDropdown();
  }
});

ddOptions.forEach((btn) => {
  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
    selectDropdownOption(idx);
  });
});

// Featured model custom dropdown interactivity
const featDropdown = document.getElementById('featured-dropdown');
const featTrigger = document.getElementById('featured-dropdown-trigger');
const featMenu = document.getElementById('featured-dropdown-menu');
const featChevron = document.getElementById('featured-dropdown-chevron');
const featSelectedName = document.getElementById('featured-selected-name');
const featOptions = document.querySelectorAll('.featured-dropdown-option');
const featuredDataEl = document.getElementById('featured-cars-data');

function openFeatDropdown() {
  closeDropdown();
  if (!featMenu || !featTrigger) return;
  const rect = featTrigger.getBoundingClientRect();
  const spaceBelow = window.innerHeight - rect.bottom;
  const spaceAbove = rect.top;

  if (spaceBelow < 280 && spaceAbove > spaceBelow) {
    featMenu.classList.remove('top-full', 'mt-2');
    featMenu.classList.add('bottom-full', 'mb-2');
  } else {
    featMenu.classList.remove('bottom-full', 'mb-2');
    featMenu.classList.add('top-full', 'mt-2');
  }

  featMenu.classList.remove('hidden');
  featTrigger.setAttribute('aria-expanded', 'true');
  featChevron?.classList.add('rotate-180');
}

function closeFeatDropdown() {
  if (!featMenu) return;
  featMenu.classList.add('hidden');
  featTrigger?.setAttribute('aria-expanded', 'false');
  featChevron?.classList.remove('rotate-180');
}

function toggleFeatDropdown() {
  if (featMenu?.classList.contains('hidden')) {
    openFeatDropdown();
  } else {
    closeFeatDropdown();
  }
}

if (featTrigger) {
  featTrigger.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleFeatDropdown();
  });

  featTrigger.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      openFeatDropdown();
    }
  });
}

document.addEventListener('click', (e) => {
  const target = e.target;
  if (ddWrapper && !ddWrapper.contains(target)) {
    closeDropdown();
  }
  if (featDropdown && !featDropdown.contains(target)) {
    closeFeatDropdown();
  }
});

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    closeDropdown();
    closeFeatDropdown();
  }
});

calcUpdate();

if (featuredDataEl) {
  try {
    const carsList = JSON.parse(featuredDataEl.textContent || '[]');
    const carMap = new Map(carsList.map((c) => [c.slug, c]));

    const img = document.getElementById('featured-img');
    const badge = document.getElementById('featured-badge');
    const title = document.getElementById('featured-title');
    const desc = document.getElementById('featured-desc');
    const spec0 = document.getElementById('featured-spec-0');
    const spec1 = document.getElementById('featured-spec-1');
    const spec2 = document.getElementById('featured-spec-2');
    const spec3 = document.getElementById('featured-spec-3');
    const price = document.getElementById('featured-price');
    const detailBtn = document.getElementById('featured-detail-btn');
    const compareBtn = document.getElementById('featured-compare-btn');

    function selectFeaturedOption(slug) {
      const data = carMap.get(slug);
      if (!data) return;

      if (featSelectedName) featSelectedName.textContent = data.name;

      featOptions.forEach((btn) => {
        const isSelected = btn.getAttribute('data-slug') === slug;
        btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        btn.classList.toggle('bg-[#FAFAFA]', isSelected);
        btn.classList.toggle('font-semibold', isSelected);

        const dot = btn.querySelector('span.rounded-full');
        if (dot) dot.style.opacity = isSelected ? '1' : '0';

        const check = btn.querySelector('svg');
        if (check) check.style.opacity = isSelected ? '1' : '0';
      });

      closeFeatDropdown();

      if (img) {
        img.style.opacity = '0.2';
        img.style.transform = 'scale(0.97)';
        setTimeout(() => {
          img.src = data.image;
          img.alt = data.name;
          img.style.opacity = '1';
          img.style.transform = 'scale(1)';
        }, 150);
      }

      if (badge) badge.textContent = data.badge;
      if (title) title.textContent = data.name;
      if (desc) desc.textContent = data.tagline;
      if (spec0) spec0.textContent = (data.specs && data.specs[0] && data.specs[0].val) || '-';
      if (spec1) spec1.textContent = (data.specs && data.specs[1] && data.specs[1].val) || '-';
      if (spec2) spec2.textContent = (data.specs && data.specs[2] && data.specs[2].val) || '-';
      if (spec3) spec3.textContent = (data.specs && data.specs[3] && data.specs[3].val) || '-';
      if (price) price.textContent = data.price;
      if (detailBtn) detailBtn.href = '/model/' + data.slug;
      if (compareBtn) compareBtn.href = '/model';
    }

    featOptions.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const slug = btn.getAttribute('data-slug') || '';
        selectFeaturedOption(slug);
      });
    });
  } catch (e) {
    console.error('Featured model update error:', e);
  }
}
</script>

