---
import Layout from '../layouts/Layout.astro';
import { salesData, getWhatsAppLink } from '../data/sales';
import { carsData } from '../data/cars';
import { promoList } from '../data/promos';
import { testimonialsData } from '../data/testimonials';

const waBase = getWhatsAppLink('Halo Kanhadi, saya ingin konsultasi promo dan kredit Mitsubishi terbaru.');

const passengerCars = carsData.filter(c => c.segment === 'passenger');
const lcvCars = carsData.filter(c => c.segment === 'lcv');
const commercialCars = carsData.filter(c => c.segment === 'commercial');

const defaultFeaturedCar = carsData.find(c => c.slug === 'pajero-sport') || carsData[0];
const featuredCarsJson = JSON.stringify(carsData.map(c => ({
  slug: c.slug,
  name: c.name,
  badge: c.badge || (c.segment === 'passenger' ? 'Bestseller' : c.category),
  image: c.image,
  tagline: c.tagline || c.description,
  price: c.startingPrice,
  specs: [
    { label: 'Kapasitas', val: c.keySpecs.seating },
    { label: 'Mesin', val: c.keySpecs.engine },
    { label: 'Tenaga', val: c.keySpecs.power },
    { label: 'Transmisi', val: c.keySpecs.transmission },
  ]
})));

const heroSlides = [
  {
    key: 'pajero',
    badge: 'Flagship SUV',
    title: 'Pajero Sport',
    desc: 'SUV 7-penumpang berkelas dengan mesin diesel 4D56, dominasi setiap medan.',
    price: 'Rp 577 Juta',
    cicilan: '9,8 Jt-an',
    link: '/model/pajero-sport',
    img: '/images/cars/pajero-sport/new-pajero-sport-optimized.webp',
    pillLabel: 'Pajero Sport',
  },
  {
    key: 'xpander',
    badge: 'MPV Terlaris',
    title: 'Xpander',
    desc: 'MPV keluarga paling laris di Indonesia, kabin senyap, suspensi ternyaman di kelasnya.',
    price: 'Rp 270 Juta',
    cicilan: '4,2 Jt-an',
    link: '/model/xpander',
    img: '/images/cars/xpander/xpander-optimized.webp',
    pillLabel: 'Xpander',
  },
  {
    key: 'xforce',
    badge: 'BARU',
    title: 'New Xforce',
    desc: 'Crossover urban berkarakter tinggi dengan Dynamic Sound Yamaha Premium.',
    price: 'Rp 382 Juta',
    cicilan: '5,9 Jt-an',
    link: '/model/xforce',
    img: '/images/cars/xforce/new-xforce-optimized.webp',
    pillLabel: 'New Xforce',
  },
];
---

<Layout
  title="Dealer Resmi Mitsubishi Jakarta | Promo & Kredit - Kanhadi"
  description="Sales Konsultan Resmi Mitsubishi Motors Jakarta. DP mulai 20 jt, bunga 0%, data dibantu sampai approve. Hubungi Kanhadi sekarang."
  currentPath="/">


  <!-- ========================================================
       HERO - Full viewport with smooth cross-fade slides
  ======================================================== -->
  <section class="relative w-full bg-black overflow-hidden" style="height: min(90vh, 700px);">

    <!-- Stacked Slides for Clean Pure Opacity Crossfade -->
    {heroSlides.map((slide, i) => (
      <div 
        class="hero-slide absolute inset-0 transition-opacity duration-500 ease-in-out" 
        data-index={i}
        style={i === 0 ? "opacity: 1; z-index: 10; pointer-events: auto;" : "opacity: 0; z-index: 0; pointer-events: none;"}
      >
        <!-- Background car image layer -->
        <div class="absolute inset-0 overflow-hidden">
          <img 
            src={slide.img} 
            alt={slide.title}
            loading="eager"
            class="w-full h-full object-cover object-center opacity-75"
          />
          <div class="absolute inset-0 bg-black/40"></div>
          <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.3) 55%, transparent 100%);"></div>
        </div>

        <!-- Text Content -->
        <div class="relative z-10 max-w-[1440px] mx-auto px-6 h-full flex flex-col justify-end pb-16 md:pb-20">
          <div class="max-w-xl text-white space-y-4">
            <span class="inline-block bg-[#E60012] text-white text-[10px] font-black uppercase tracking-[0.15em] px-3 py-1.5">
              {slide.badge}
            </span>

            <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-[1.05]">
              {slide.title}
            </h1>

            <p class="text-[#BFC2C4] text-base leading-relaxed">
              {slide.desc}
            </p>

            <div class="flex items-center gap-4 pt-2">
              <div class="space-y-0.5">
                <div class="text-[11px] text-[#BFC2C4] uppercase tracking-wider">OTR Jakarta Mulai</div>
                <div class="text-2xl font-black">{slide.price}</div>
              </div>
              <div class="w-px h-10 bg-white/20"></div>
              <div class="space-y-0.5">
                <div class="text-[11px] text-[#BFC2C4] uppercase tracking-wider">Cicilan / Bulan</div>
                <div class="text-2xl font-black text-[#E60012]">{slide.cicilan}</div>
              </div>
            </div>

            <div class="flex items-center gap-3 pt-2">
              <a href={slide.link}
                class="inline-flex items-center gap-2 bg-[#E60012] hover:bg-white hover:text-black text-white text-[13px] font-bold px-6 py-3 transition-colors duration-200">
                Lihat Detail
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </a>
              <a href={waBase} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 border border-white/40 hover:border-white text-white text-[13px] font-semibold px-6 py-3 transition-colors backdrop-blur-sm">
                Tanya Harga WA
              </a>
            </div>
          </div>
        </div>
      </div>
    ))}

    <!-- Hero model nav pills - bottom right -->
    <div class="absolute bottom-6 right-6 z-20 flex gap-2">
      {heroSlides.map((item, i) => (
        <button 
          type="button" 
          class="hero-pill text-white text-[11px] font-bold px-3.5 py-2 border transition-all duration-300"
          data-slide-index={i}
          style={i === 0 ? "background: #E60012; border-color: #E60012;" : "background: rgba(0,0,0,0.55); border-color: rgba(255,255,255,0.2); backdrop-filter: blur(8px);"}
        >
          {item.pillLabel}
        </button>
      ))}
    </div>

    <!-- Scroll cue -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 hidden md:flex flex-col items-center gap-1.5">
      <span class="text-[10px] text-white/50 uppercase tracking-[0.15em]">Scroll</span>
      <div class="w-px h-8 bg-white/20"></div>
    </div>

  </section>


  <!-- ========================================================
       MODEL SHOWCASE CAROUSEL - 5-Item View with Edge Fade (MMKSI Style)
  ======================================================== -->
  <section class="bg-white border-b border-[#E3E5E6] py-12 md:py-16 overflow-hidden">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6">
      
      <!-- Section Header & Filter Tabs -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6 px-4">
        <div>
          <span class="text-[10px] font-black uppercase tracking-[0.16em] text-[#E60012] block mb-1">Pilihan Unit Resmi</span>
          <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-[#2B2E30]">Lineup Kendaraan Mitsubishi</h2>
        </div>
        
        <!-- Filter Buttons -->
        <div class="flex items-center gap-1.5 bg-[#F6F6F6] p-1 border border-[#E3E5E6]">
          <button 
            type="button" 
            class="carousel-filter-btn active text-[12px] font-bold px-3.5 py-1.5 cursor-pointer"
            data-filter="passenger"
          >
            Mobil Penumpang ({passengerCars.length})
          </button>
          <button 
            type="button" 
            class="carousel-filter-btn text-[12px] font-bold px-3.5 py-1.5 cursor-pointer"
            data-filter="lcv"
          >
            Niaga Ringan ({lcvCars.length})
          </button>
          <button 
            type="button" 
            class="carousel-filter-btn text-[12px] font-bold px-3.5 py-1.5 cursor-pointer"
            data-filter="commercial"
          >
            Truk &amp; Bus Fuso ({commercialCars.length})
          </button>
        </div>
      </div>

      <!-- Carousel Track with edge fade mask (MMKSI Style) -->
      <div class="relative w-full">
        <div 
          id="model-carousel" 
          class="flex gap-4 sm:gap-6 md:gap-8 overflow-x-auto scroll-smooth scrollbar-none snap-x snap-mandatory py-4 px-8 sm:px-14 md:px-20"
          style="scrollbar-width: none; -ms-overflow-style: none; mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);"
        >
          {carsData.map((car) => (
            <a 
              href={`/model/${car.slug}`}
              draggable="false"
              data-segment={car.segment}
              style={car.segment !== 'passenger' ? 'display: none;' : ''}
              class="model-carousel-card flex-shrink-0 w-[240px] sm:w-[260px] md:w-[280px] lg:w-[300px] snap-center group flex flex-col justify-between p-3 sm:p-4 bg-transparent transition-all duration-300 rounded-none select-none"
            >
              <!-- Badge Container -->
              <div class="h-6 flex items-center justify-end px-1">
                {car.badge ? (
                  <span class={`text-white text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 ${car.segment === 'commercial' ? 'bg-[#2B2E30]' : 'bg-[#E60012]'}`}>
                    {car.badge}
                  </span>
                ) : (
                  <span class="invisible text-[10px] px-2.5 py-0.5">BADGE</span>
                )}
              </div>

              <!-- Car Image -->
              <div class="h-28 sm:h-32 md:h-36 w-full flex items-center justify-center my-2 p-1 overflow-visible">
                <img 
                  src={car.image} 
                  alt={car.name}
                  draggable="false"
                  loading="lazy"
                  class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300 drop-shadow-sm pointer-events-none select-none"
                />
              </div>

              <!-- Car Info -->
              <div class="text-center pt-2 pb-1">
                <h3 class="text-xs sm:text-sm md:text-base font-black text-black group-hover:text-[#E60012] transition-colors uppercase tracking-wider leading-tight">
                  {car.name}
                </h3>
                <p class="text-[11px] sm:text-xs md:text-[13px] text-[#555] font-normal mt-1">
                  Mulai dari {car.startingPrice}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Navigation & Compare Bar (MMKSI Style) -->
      <div class="mt-8 pt-4 flex items-center justify-between max-w-3xl mx-auto px-4">
        <!-- Prev Arrow -->
        <button 
          id="model-prev-btn" 
          type="button" 
          aria-label="Sebelumnya"
          class="group p-2 text-black hover:text-[#E60012] transition-colors"
        >
          <svg class="w-8 sm:w-10 h-8 sm:h-10 transition-transform group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m7-7l-7 7 7 7"/>
          </svg>
        </button>

        <!-- Center Link -->
        <a 
          href="/model" 
          class="text-xs sm:text-sm font-black uppercase tracking-[0.2em] text-black border-b-2 border-black hover:text-[#E60012] hover:border-[#E60012] pb-1 transition-colors"
        >
          BANDINGKAN KENDARAAN
        </a>

        <!-- Next Arrow -->
        <button 
          id="model-next-btn" 
          type="button" 
          aria-label="Selanjutnya"
          class="group p-2 text-black hover:text-[#E60012] transition-colors"
        >
          <svg class="w-8 sm:w-10 h-8 sm:h-10 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7l7 7-7 7"/>
          </svg>
        </button>
      </div>

    </div>
  </section>


  <!-- ========================================================
       PROMO SECTION - Editorial press-release style
  ======================================================== -->
  <section class="bg-[#111111] text-white">
    <div class="max-w-[1440px] mx-auto">

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr]">

        <!-- Left: Headline column -->
        <div class="px-6 sm:px-8 md:px-14 py-12 md:py-20 border-b lg:border-b-0 lg:border-r border-[#222] flex flex-col justify-between">
          <div>
            <div class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#E60012] mb-4">Penawaran Aktif</div>
            <h2 class="text-3xl md:text-[2.8rem] font-black leading-[1.08] tracking-tight mb-6">
              Promo<br class="hidden sm:inline"/> Bulan Ini
            </h2>
            <p class="text-[13px] text-[#888] leading-relaxed max-w-[280px]">
              Program kredit subsidi, bunga 0%, cashback puluhan juta, dan paket servis resmi untuk unit pilihan. Kuota terbatas setiap bulannya.
            </p>
          </div>

          <div class="mt-10 flex flex-col sm:flex-row lg:flex-col gap-3">
            <a href="/promo"
              class="inline-flex items-center justify-center gap-2 bg-[#E60012] hover:bg-white hover:text-black text-white text-[13px] font-bold px-6 py-3.5 transition-colors duration-200">
              Lihat Semua Promo
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href={waBase} target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center text-[12px] text-[#888] hover:text-white transition-colors underline underline-offset-4 py-1">
              Konsultasi promo via WhatsApp
            </a>
          </div>
        </div>

        <!-- Right: Promo list editorial table -->
        <div class="divide-y divide-[#1E1E1E]">
          {promoList.map((p, i) => (
            <a 
              href="/promo" 
              class="group flex items-stretch gap-0 hover:bg-[#181818] transition-colors duration-200 cursor-pointer block"
            >
              <!-- Index number -->
              <div class="w-12 sm:w-16 flex-shrink-0 flex items-center justify-center border-r border-[#1E1E1E] py-6 sm:py-8">
                <span class="text-[11px] font-mono font-bold text-[#666] group-hover:text-[#E60012] transition-colors">0{i + 1}</span>
              </div>

              <!-- Main content -->
              <div class="flex-1 px-5 sm:px-8 py-6 sm:py-8 flex flex-col md:flex-row md:items-center md:justify-between gap-3 sm:gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="text-[10px] font-black uppercase tracking-widest text-[#E60012]">{p.badge}</span>
                    <span class="text-[#333]">·</span>
                    <span class="text-[11px] text-[#888]">{p.targetCar}</span>
                  </div>
                  <h3 class="text-[15px] sm:text-[16px] font-bold text-white group-hover:text-[#E60012] transition-colors leading-snug">
                    {p.title}
                  </h3>
                </div>

                <div class="flex-shrink-0 md:text-right flex md:flex-col flex-row items-baseline md:items-end justify-between md:justify-center gap-2 pt-2 md:pt-0">
                  <span class="text-[13px] font-bold text-white group-hover:text-[#E60012] transition-colors">{p.highlight}</span>
                  <span class="text-[10px] font-medium text-[#777] uppercase tracking-wider">{p.validPeriod}</span>
                </div>
              </div>

              <!-- Arrow action -->
              <div class="w-12 sm:w-16 flex-shrink-0 flex items-center justify-center border-l border-[#1E1E1E] text-[#555] group-hover:text-white group-hover:bg-[#E60012] transition-colors">
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </a>
          ))}
        </div>

      </div>

      <!-- Bottom terms bar (full-width centered) -->
      <div class="py-4 border-t border-[#1E1E1E] text-center">
        <span class="text-[11px] text-[#777]">Pembaruan berkala · Syarat & ketentuan berlaku</span>
      </div>
    </div>
  </section>


  <!-- ========================================================
       FLAGSHIP FEATURE - Big editorial split (MMKSI style)
  ======================================================== -->
  <section class="bg-white">
    <div class="max-w-[1440px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2">

        <!-- Left: Image & Vehicle Selector -->
        <div class="relative bg-white flex flex-col justify-between p-6 md:p-8 lg:p-12 border-b lg:border-b-0 lg:border-r border-[#E3E5E6]">
          <!-- Car Image Container -->
          <div class="relative w-full h-72 md:h-80 lg:h-[380px] flex items-center justify-center">
            <img
              id="featured-img"
              src={defaultFeaturedCar.image}
              alt={defaultFeaturedCar.name}
              class="w-full h-full object-contain object-center hover:scale-105 transition-all duration-300"
            />
            <div class="absolute top-0 left-0">
              <span id="featured-badge" class="bg-[#E60012] text-white text-[10px] font-black uppercase tracking-[0.15em] px-3 py-1.5">
                {defaultFeaturedCar.badge || 'Bestseller'}
              </span>
            </div>
          </div>

          <!-- Custom Dropdown Di Bawah Gambar Mobil (Sesuai Desain & Dropdown Simulasi Kredit) -->
          <div class="mt-4 pt-4 border-t border-[#F0F0F0]">
            <label id="featured-car-label" class="block text-[11px] font-bold text-[#686D71] tracking-[0.22em] uppercase mb-2">
              Pilih Kendaraan Favoritmu
            </label>
            <div class="relative z-30" id="featured-dropdown">
              <button
                type="button"
                id="featured-dropdown-trigger"
                class="w-full flex items-center justify-between border-b-2 border-black pb-2 pt-1 text-left bg-transparent cursor-pointer focus:outline-none transition-colors"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-labelledby="featured-car-label featured-dropdown-trigger"
              >
                <span id="featured-selected-name" class="text-[18px] md:text-[20px] font-black tracking-tight text-black truncate pr-4">
                  {defaultFeaturedCar.name}
                </span>
                <svg id="featured-dropdown-chevron" class="w-4 h-4 text-black transition-transform duration-200 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>

              <!-- Dropdown Menu List -->
              <div
                id="featured-dropdown-menu"
                class="hidden absolute left-0 right-0 top-full mt-2 bg-white border border-[#E3E5E6] shadow-2xl z-50 max-h-72 overflow-y-auto divide-y divide-[#F0F2F3]"
                role="listbox"
                tabindex="-1"
              >
                {carsData.map((car) => {
                  const isSelected = car.slug === defaultFeaturedCar.slug;
                  return (
                    <button
                      type="button"
                      class={`featured-dropdown-option w-full flex items-center justify-between px-4 py-3 text-left transition-colors cursor-pointer hover:bg-[#F6F6F6] ${isSelected ? 'bg-[#FAFAFA] font-semibold' : ''}`}
                      data-slug={car.slug}
                      role="option"
                      aria-selected={isSelected ? 'true' : 'false'}
                    >
                      <div class="flex items-center gap-2.5 min-w-0 pr-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#E60012] flex-shrink-0 transition-opacity" style={isSelected ? 'opacity: 1;' : 'opacity: 0;'}></span>
                        <span class="text-[14px] text-[#1F2421] truncate">{car.name}</span>
                      </div>
                      <div class="flex items-center gap-3 flex-shrink-0">
                        <span class="text-[12px] text-[#686D71] font-medium">Mulai {car.startingPrice}</span>
                        <svg class="w-4 h-4 text-[#E60012] transition-opacity" style={isSelected ? 'opacity: 1;' : 'opacity: 0;'} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                      </div>
                    </button>
                  );
                })}
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Content -->
        <div class="px-8 md:px-16 py-10 lg:py-16 flex flex-col justify-center space-y-6">
          <div class="space-y-2">
            <div class="text-[10px] font-black uppercase tracking-[0.2em] text-[#E60012]">Model Unggulan</div>
            <h2 id="featured-title" class="text-3xl md:text-4xl font-black tracking-tight text-[#2B2E30] leading-tight">
              {defaultFeaturedCar.name}
            </h2>
            <p id="featured-desc" class="text-[#686D71] text-[14px] leading-relaxed line-clamp-3">
              {defaultFeaturedCar.tagline || defaultFeaturedCar.description}
            </p>
          </div>

          <div class="grid grid-cols-2 gap-3" id="featured-specs-grid">
            <div class="border border-[#E3E5E6] p-3.5">
              <div class="text-[10px] text-[#686D71] uppercase tracking-wider">Kapasitas</div>
              <div id="featured-spec-0" class="text-[13px] font-bold text-[#2B2E30] mt-0.5">{defaultFeaturedCar.keySpecs.seating}</div>
            </div>
            <div class="border border-[#E3E5E6] p-3.5">
              <div class="text-[10px] text-[#686D71] uppercase tracking-wider">Mesin</div>
              <div id="featured-spec-1" class="text-[13px] font-bold text-[#2B2E30] mt-0.5">{defaultFeaturedCar.keySpecs.engine}</div>
            </div>
            <div class="border border-[#E3E5E6] p-3.5">
              <div class="text-[10px] text-[#686D71] uppercase tracking-wider">Tenaga</div>
              <div id="featured-spec-2" class="text-[13px] font-bold text-[#2B2E30] mt-0.5">{defaultFeaturedCar.keySpecs.power}</div>
            </div>
            <div class="border border-[#E3E5E6] p-3.5">
              <div class="text-[10px] text-[#686D71] uppercase tracking-wider">Transmisi</div>
              <div id="featured-spec-3" class="text-[13px] font-bold text-[#2B2E30] mt-0.5">{defaultFeaturedCar.keySpecs.transmission}</div>
            </div>
          </div>

          <div class="pt-2 space-y-4">
            <div class="flex items-baseline gap-2">
              <span class="text-[11px] text-[#686D71]">OTR Jakarta Mulai</span>
              <span id="featured-price" class="text-2xl font-black text-[#E60012]">{defaultFeaturedCar.startingPrice}</span>
            </div>
            <!-- Action Buttons (Sesuai Desain Gambar 3) -->
            <div class="flex flex-wrap items-center gap-3">
              <a
                id="featured-detail-btn"
                href={`/model/${defaultFeaturedCar.slug}`}
