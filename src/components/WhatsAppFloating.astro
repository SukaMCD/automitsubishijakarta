---
import { salesData, getWhatsAppLink } from '../data/sales';
const { customMessage } = Astro.props;
const waUrl = getWhatsAppLink(customMessage);
---

<div class="fixed bottom-6 right-6 z-50">
  <!-- Perfect Circular FAB button that expands on hover -->
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="animate-wa-ring group flex items-center bg-[#25D366] hover:bg-[#20ba5a] text-white rounded-full shadow-2xl transition-all duration-300 p-0 overflow-hidden"
    aria-label="Chat WhatsApp"
  >
    <!-- Circle container: strictly 56px by 56px for 100% roundness -->
    <div class="w-14 h-14 flex items-center justify-center flex-shrink-0">
      <!-- White WA / phone icon -->
      <svg class="w-7 h-7 fill-current text-white" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.288.043.088.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z"/>
      </svg>
    </div>

    <!-- Expandable text label on hover -->
    <span class="max-w-0 overflow-hidden whitespace-nowrap opacity-0 group-hover:max-w-[200px] group-hover:opacity-100 group-hover:pr-5 text-sm font-bold text-white transition-all duration-300 ease-in-out">
      Tanya Promo WA
    </span>
  </a>
</div>
