---
import { Image } from 'astro:assets';
import { salesData, getWhatsAppLink } from '../data/sales';
import { carsData } from '../data/cars';

interface Props { currentPath?: string; }
const { currentPath = '/' } = Astro.props;

const waUrl = getWhatsAppLink('Halo Kanhadi, saya ingin konsultasi promo Mitsubishi terbaru.');

const passengerCars = carsData.filter(c => c.segment === 'passenger');
const lcvCars = carsData.filter(c => c.segment === 'lcv');
const truckCars = carsData.filter(c => c.segment === 'commercial' && c.category === 'Truk');
const busCars = carsData.filter(c => c.segment === 'commercial' && (c.category === 'Bus' || c.category === 'Bus Chassis'));

const navLinks = [
  { label: 'Model', href: '/model', dropdown: true },
  { label: 'Promo', href: '/promo' },
  { label: 'Daftar Harga', href: '/pricelist' },
  { label: 'Simulasi Kredit', href: '/#simulasi-kredit' },
];
---



<header id="site-header" class="relative sticky top-0 z-50 bg-white border-b border-[#E3E5E6] transition-shadow duration-300">
  <nav class="max-w-[1440px] mx-auto px-4 sm:px-6 h-[62px] sm:h-[68px] flex items-center justify-between gap-4 sm:gap-8">

    <a href="/" class="flex items-center gap-2.5 sm:gap-3 flex-shrink-0 group">
      <div class="h-8 sm:h-9 w-auto flex items-center justify-center flex-shrink-0">
        <svg viewBox="26 1 122 105" class="h-8 sm:h-9 w-auto aspect-[122/105]" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polygon points="87 70.9 107.2 36 87 1.2 66.9 36" fill="#E60012"/>
          <polygon points="87 70.9 107.2 105.7 147.4 105.7 127.3 70.9" fill="#E60012"/>
          <polygon points="87 70.9 66.9 105.7 26.7 105.7 46.8 70.9" fill="#E60012"/>
        </svg>
      </div>
      <div>
        <span class="block font-black text-[15px] sm:text-[16px] leading-none text-black tracking-tight uppercase">MITSUBISHI</span>
        <span class="block font-black text-[10px] sm:text-[11px] text-black tracking-[0.2em] uppercase mt-1">JAKARTA</span>
      </div>
    </a>

    <div class="hidden lg:flex items-center gap-0">
      {navLinks.map((link) =>
        link.dropdown ? (
          <div class="group/dd h-[68px] flex items-center">
            <button class={`flex items-center gap-1 px-4 h-[68px] text-[13px] font-semibold tracking-wide transition-colors border-b-2 ${currentPath.startsWith('/model') ? 'text-[#E60012] border-[#E60012]' : 'text-[#2B2E30] hover:text-[#E60012] border-transparent hover:border-[#E60012]'}`}>
              {link.label}
              <svg class="w-3 h-3 mt-0.5 transition-transform duration-200 group-hover/dd:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="absolute top-full left-1/2 -translate-x-1/2 hidden group-hover/dd:block w-[880px] max-w-[calc(100vw-32px)] shadow-2xl border border-[#E3E5E6] bg-white z-50">
              <div class="px-6 py-3 border-b border-[#E3E5E6] flex items-center justify-between bg-[#FAFAFA]">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <button
                    type="button"
                    id="tab-btn-passenger"
                    class="nav-tab-btn active px-3 py-1.5 text-[11px] font-bold uppercase tracking-wider transition-all duration-200 bg-[#E60012] text-white cursor-pointer"
                  >
                    Mobil Penumpang ({passengerCars.length})
                  </button>
                  <button
                    type="button"
                    id="tab-btn-lcv"
                    class="nav-tab-btn px-3 py-1.5 text-[11px] font-bold uppercase tracking-wider transition-all duration-200 bg-[#EBEBEB] text-[#2B2E30] hover:bg-[#2B2E30] hover:text-white cursor-pointer"
                  >
                    Niaga Ringan ({lcvCars.length})
                  </button>
                  <button
                    type="button"
                    id="tab-btn-truck"
                    class="nav-tab-btn px-3 py-1.5 text-[11px] font-bold uppercase tracking-wider transition-all duration-200 bg-[#EBEBEB] text-[#2B2E30] hover:bg-[#2B2E30] hover:text-white cursor-pointer"
                  >
                    Truk Canter ({truckCars.length})
                  </button>
                  <button
                    type="button"
                    id="tab-btn-bus"
                    class="nav-tab-btn px-3 py-1.5 text-[11px] font-bold uppercase tracking-wider transition-all duration-200 bg-[#EBEBEB] text-[#2B2E30] hover:bg-[#2B2E30] hover:text-white cursor-pointer"
                  >
                    Bus &amp; Sasis ({busCars.length})
                  </button>
                </div>
                <a href="/model" class="text-[12px] font-bold text-[#E60012] hover:text-black transition-colors flex items-center gap-1 group/all">
                  Lihat Semua
                  <svg class="w-3.5 h-3.5 transition-transform group-hover/all:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </a>
              </div>

              <div id="nav-panel-passenger" class="grid grid-cols-3 gap-3 p-5">
                {passengerCars.map((car) => (
                  <a
                    href={`/model/${car.slug}`}
                    draggable="false"
                    class="group/card flex flex-col justify-between p-3 border border-[#EBEBEB] hover:border-[#E60012] bg-white hover:bg-[#FAFAFA] transition-all duration-200 select-none"
                  >
                    <div class="flex items-center justify-between gap-1 mb-1">
                      <span class="text-[9px] font-black uppercase tracking-wider text-[#686D71]">{car.category}</span>
                      {car.badge && (
                        <span class={`text-[9px] font-bold px-1.5 py-0.5 leading-none ${car.badge === 'BARU' || car.badge === 'BEST SELLER' || car.badge === 'FLAGSHIP SUV' ? 'bg-[#E60012] text-white' : 'bg-[#2B2E30] text-white'}`}>
                          {car.badge}
                        </span>
                      )}
                    </div>
                    <div class="h-20 w-full flex items-center justify-center py-1 overflow-hidden">
                      <Image
                        src={car.image}
                        alt={car.name}
                        width={240}
                        height={140}
                        draggable="false"
                        class="max-h-full max-w-full object-contain group-hover/card:scale-105 transition-transform duration-300 pointer-events-none select-none"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="mt-2 pt-2 border-t border-[#F0F0F0]">
                      <div class="text-[12px] font-bold text-[#2B2E30] group-hover/card:text-[#E60012] transition-colors leading-tight truncate">
                        {car.name.replace('Mitsubishi ', '')}
                      </div>
                      <div class="text-[11px] font-semibold text-[#686D71] mt-0.5">
                        Mulai {car.startingPrice}
                      </div>
                    </div>
                  </a>
                ))}

                <div class="flex flex-col justify-between p-3 border border-[#2B2E30] bg-[#1F2421] text-white">
                  <div>
                    <div class="text-[9px] font-black uppercase tracking-widest text-[#E60012] mb-1">KONSULTASI RESMI</div>
                    <div class="text-[13px] font-bold leading-snug">Bingung Pilih Tipe?</div>
                    <p class="text-[11px] text-[#A6A9AB] leading-relaxed mt-1.5">
                      Konsultasi diskon, hitung simulasi kredit, &amp; test drive gratis dengan sales konsultan resmi kami.
                    </p>
                  </div>
                  <a
                    href={waUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-3 flex items-center justify-center gap-2 bg-[#E60012] hover:bg-white hover:text-black text-white text-[12px] font-bold py-2 px-3 transition-colors duration-200"
                  >
                    Chat WhatsApp
                  </a>
                </div>
              </div>

              <div id="nav-panel-lcv" class="hidden grid grid-cols-3 gap-3 p-5">
                {lcvCars.map((car) => (
                  <a
                    href={`/model/${car.slug}`}
                    draggable="false"
                    class="group/card flex flex-col justify-between p-3 border border-[#EBEBEB] hover:border-[#E60012] bg-white hover:bg-[#FAFAFA] transition-all duration-200 select-none"
                  >
                    <div class="flex items-center justify-between gap-1 mb-1">
                      <span class="text-[9px] font-black uppercase tracking-wider text-[#686D71]">{car.category}</span>
                      {car.badge && (
                        <span class="text-[9px] font-bold px-1.5 py-0.5 leading-none bg-[#E60012] text-white">
                          {car.badge}
                        </span>
                      )}
                    </div>
                    <div class="h-20 w-full flex items-center justify-center py-1 overflow-hidden">
                      <Image
                        src={car.image}
                        alt={car.name}
                        width={240}
                        height={140}
                        draggable="false"
                        class="max-h-full max-w-full object-contain group-hover/card:scale-105 transition-transform duration-300 pointer-events-none select-none"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="mt-2 pt-2 border-t border-[#F0F0F0]">
                      <div class="text-[12px] font-bold text-[#2B2E30] group-hover/card:text-[#E60012] transition-colors leading-tight truncate">
                        {car.name.replace('Mitsubishi ', '')}
                      </div>
                      <div class="text-[11px] font-semibold text-[#686D71] mt-0.5">
                        Mulai {car.startingPrice}
                      </div>
                    </div>
                  </a>
                ))}

                <div class="flex flex-col justify-between p-3 border border-[#2B2E30] bg-[#1F2421] text-white">
                  <div>
                    <div class="text-[9px] font-black uppercase tracking-widest text-[#E60012] mb-1">PROMO USAHA &amp; UMKM</div>
                    <div class="text-[13px] font-bold leading-snug">Paket Kredit Usaha</div>
                    <p class="text-[11px] text-[#A6A9AB] leading-relaxed mt-1.5">
                      DP Ringan mulai 15 Jt-an, angsuran fleksibel, proses berkas dibantu sampai serah terima unit.
                    </p>
                  </div>
                  <a
                    href={getWhatsAppLink('Halo Kanhadi, saya ingin info promo DP dan angsuran mobil pick-up L300 / Triton untuk usaha.')}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-3 flex items-center justify-center gap-2 bg-[#E60012] hover:bg-white hover:text-black text-white text-[12px] font-bold py-2 px-3 transition-colors duration-200"
                  >
                    Konsultasi Pick-Up
                  </a>
                </div>
              </div>

              <div id="nav-panel-truck" class="hidden grid grid-cols-3 gap-3 p-5">
                {truckCars.map((car) => (
                  <a
                    href={`/model/${car.slug}`}
                    draggable="false"
                    class="group/card flex flex-col justify-between p-3 border border-[#EBEBEB] hover:border-[#E60012] bg-white hover:bg-[#FAFAFA] transition-all duration-200 select-none"
                  >
                    <div class="flex items-center justify-between gap-1 mb-1">
                      <span class="text-[9px] font-black uppercase tracking-wider text-[#686D71]">{car.category}</span>
                      {car.badge && (
                        <span class="text-[9px] font-bold px-1.5 py-0.5 leading-none bg-[#2B2E30] text-white">
                          {car.badge}
                        </span>
                      )}
                    </div>
                    <div class="h-20 w-full flex items-center justify-center py-1 overflow-hidden">
                      <Image
                        src={car.image}
                        alt={car.name}
                        width={240}
                        height={140}
                        draggable="false"
                        class="max-h-full max-w-full object-contain group-hover/card:scale-105 transition-transform duration-300 pointer-events-none select-none"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="mt-2 pt-2 border-t border-[#F0F0F0]">
                      <div class="text-[12px] font-bold text-[#2B2E30] group-hover/card:text-[#E60012] transition-colors leading-tight truncate">
                        {car.name}
                      </div>
                    </div>
                  </a>
                ))}
              </div>

              <div id="nav-panel-bus" class="hidden grid grid-cols-3 gap-3 p-5">
                {busCars.map((car) => (
                  <a
                    href={`/model/${car.slug}`}
                    draggable="false"
                    class="group/card flex flex-col justify-between p-3 border border-[#EBEBEB] hover:border-[#E60012] bg-white hover:bg-[#FAFAFA] transition-all duration-200 select-none"
                  >
                    <div class="flex items-center justify-between gap-1 mb-1">
                      <span class="text-[9px] font-black uppercase tracking-wider text-[#686D71]">{car.category}</span>
                      {car.badge && (
                        <span class="text-[9px] font-bold px-1.5 py-0.5 leading-none bg-[#2B2E30] text-white">
                          {car.badge}
                        </span>
                      )}
                    </div>
                    <div class="h-20 w-full flex items-center justify-center py-1 overflow-hidden">
                      <Image
                        src={car.image}
                        alt={car.name}
                        width={240}
                        height={140}
                        draggable="false"
                        class="max-h-full max-w-full object-contain group-hover/card:scale-105 transition-transform duration-300 pointer-events-none select-none"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="mt-2 pt-2 border-t border-[#F0F0F0]">
                      <div class="text-[12px] font-bold text-[#2B2E30] group-hover/card:text-[#E60012] transition-colors leading-tight truncate">
                        {car.name}
                      </div>
                    </div>
                  </a>
                ))}

                <div class="flex flex-col justify-between p-3 border border-[#2B2E30] bg-[#1F2421] text-white">
                  <div>
                    <div class="text-[9px] font-black uppercase tracking-widest text-[#E60012] mb-1">PENGADAAN ARMADA</div>
                    <div class="text-[13px] font-bold leading-snug">Konsultasi Fleet &amp; Bisnis</div>
                    <p class="text-[11px] text-[#A6A9AB] leading-relaxed mt-1.5">
                      Penawaran khusus pengadaan unit bus &amp; sasis instansi, pariwisata, atau perusahaan.
                    </p>
                  </div>
                  <a
                    href={getWhatsAppLink('Halo Kanhadi, saya ingin konsultasi penawaran harga pengadaan unit armada bus/chassis Mitsubishi Fuso.')}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-3 flex items-center justify-center gap-2 bg-[#E60012] hover:bg-white hover:text-black text-white text-[12px] font-bold py-2 px-3 transition-colors duration-200"
                  >
                    Hubungi Fleet Sales
                  </a>
                </div>

                <div class="flex flex-col justify-between p-3 border border-[#EBEBEB] bg-[#FAFAFA]">
                  <div>
                    <div class="text-[9px] font-black uppercase tracking-widest text-[#686D71] mb-1">REKOMENDASI RESMI</div>
                    <div class="text-[13px] font-bold text-[#2B2E30] leading-snug">Pilihan Bodi Karoseri</div>
                    <p class="text-[11px] text-[#686D71] leading-relaxed mt-1.5">
                      Didukung mitra karoseri terpercaya berizin resmi SKRB untuk bodi pariwisata, ambulans, maupun shuttle.
                    </p>
                  </div>
                  <a
                    href={getWhatsAppLink('Halo Kanhadi, saya ingin informasi mengenai pilihan pembuatan karoseri bus resmi.')}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-3 flex items-center justify-center gap-2 bg-[#2B2E30] hover:bg-[#E60012] text-white text-[12px] font-bold py-2 px-3 transition-colors duration-200"
                  >
                    Tanya Karoseri
                  </a>
                </div>
              </div>

              <div class="px-6 py-2.5 bg-[#F6F6F6] border-t border-[#E3E5E6] flex items-center justify-between text-[11px] text-[#686D71]">
                <div id="footer-text-passenger" class="flex items-center gap-4">
                  <span class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-[#E60012] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Garansi Pabrik 3 Th / 100.000 KM</span>
                  <span class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-[#E60012] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Gratis Paket SMART Servis</span>
                  <span class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-[#E60012] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Jaminan Unit Resmi PT MMKSI</span>
                </div>
                <div id="footer-text-lcv" class="hidden flex items-center gap-4 text-[#2B2E30] font-medium">
                  <span class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-[#E60012] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Mesin Euro 4 Tangguh &amp; Irit BBM</span>
                  <span class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-[#E60012] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>DP Ringan Mulai 15 Jt-an</span>
                  <span class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-[#E60012] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Jaminan Servis &amp; Sparepart Mudah</span>
                </div>
                <div id="footer-text-truck" class="hidden flex items-center gap-4 text-[#2B2E30] font-medium">
                  <span class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-[#E60012] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Jaringan 222 Dealer &amp; 19 Bengkel Siaga 24 Jam</span>
                  <span class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-[#E60012] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Gratis Servis s/d 40.000 KM / 2 Th</span>
                  <span class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-[#E60012] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Telematika Runner Fuso</span>
                </div>
                <div id="footer-text-bus" class="hidden flex items-center gap-4 text-[#2B2E30] font-medium">
                  <span class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-[#E60012] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Chasis Bus Kuat &amp; Suspensi Nyaman</span>
                  <span class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-[#E60012] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Siap Berbagai Jenis Karoseri SKRB</span>
                  <span class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-[#E60012] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Layanan Purna Jual Resmi Fuso</span>
                </div>
                <div class="font-bold text-[#2B2E30]">
                  Wilayah Jakarta &amp; Jabodetabek
                </div>
              </div>
            </div>
          </div>
        ) : (
          <a href={link.href}
            class={`flex items-center px-4 h-[68px] text-[13px] font-semibold tracking-wide border-b-2 transition-colors ${currentPath === link.href ? 'text-[#E60012] border-[#E60012]' : 'text-[#2B2E30] hover:text-[#E60012] border-transparent hover:border-[#E60012]'}`}>
            {link.label}
          </a>
        )
      )}
    </div>

    <div class="hidden lg:flex items-center gap-3">
      <a href={waUrl} target="_blank" rel="noopener noreferrer"
        class="flex items-center gap-2 bg-[#E60012] hover:bg-black text-white text-[13px] font-bold px-5 py-2.5 transition-colors duration-200">
        <svg class="w-4.5 h-4.5 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Hubungi Sales
      </a>
    </div>

    <button id="mobile-menu-btn" class="lg:hidden p-2.5 text-[#2B2E30] hover:text-[#E60012] hover:bg-[#F6F6F6] rounded transition-colors focus:outline-none" aria-label="Menu" aria-expanded="false">
      <span class="hamburger-box block relative w-[22px] h-[18px]">
        <span class="hamburger-line line-1 absolute left-0 top-0 w-[22px] h-[2px] bg-current rounded-full"></span>
        <span class="hamburger-line line-2 absolute left-0 top-[8px] w-[22px] h-[2px] bg-current rounded-full"></span>
        <span class="hamburger-line line-3 absolute left-0 bottom-0 w-[22px] h-[2px] bg-current rounded-full"></span>
      </span>
    </button>
  </nav>

  <div id="mobile-menu" class="mobile-menu-wrapper lg:hidden bg-white shadow-xl">
    <div class="mobile-menu-inner">
      <div class="mobile-menu-content px-5 py-3 space-y-1">
      {navLinks.map((link) => (
        <a href={link.href}
          class={`mobile-nav-link flex items-center justify-between py-3.5 border-b border-[#F0F0F0] text-[14px] font-semibold transition-colors ${currentPath === link.href ? 'text-[#E60012]' : 'text-[#2B2E30] hover:text-[#E60012]'}`}>
          {link.label}
          <svg class="w-4 h-4 text-[#BFC2C4]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      ))}
      <div class="pt-3 pb-2">
        <a href={waUrl} target="_blank" rel="noopener noreferrer"
          class="mobile-nav-link flex items-center justify-center gap-2.5 w-full bg-[#E60012] hover:bg-black text-white text-[13px] font-bold py-3.5 px-4 transition-colors">
          <svg class="w-4.5 h-4.5 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Hubungi via WhatsApp
        </a>
      </div>
    </div>
  </div>
</div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  function closeMobileMenu() {
    menu?.classList.remove('is-open');
    btn?.classList.remove('is-active');
    btn?.setAttribute('aria-expanded', 'false');
  }

  function toggleMobileMenu() {
    const isOpen = menu?.classList.toggle('is-open');
    btn?.classList.toggle('is-active', !!isOpen);
    btn?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  }

  btn?.addEventListener('click', toggleMobileMenu);

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      closeMobileMenu();
    });
  });

  document.addEventListener('click', (e) => {
    if (menu?.classList.contains('is-open')) {
      const target = e.target as HTMLElement;
      if (!menu.contains(target) && !btn?.contains(target)) {
        closeMobileMenu();
      }
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('is-open')) {
      closeMobileMenu();
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024 && menu?.classList.contains('is-open')) {
      closeMobileMenu();
    }
  });
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('shadow-lg', window.scrollY > 10);
  });

  const tabPassenger = document.getElementById('tab-btn-passenger');
  const tabLcv = document.getElementById('tab-btn-lcv');
  const tabTruck = document.getElementById('tab-btn-truck');
  const tabBus = document.getElementById('tab-btn-bus');

  const panelPassenger = document.getElementById('nav-panel-passenger');
  const panelLcv = document.getElementById('nav-panel-lcv');
  const panelTruck = document.getElementById('nav-panel-truck');
  const panelBus = document.getElementById('nav-panel-bus');

  const footerPassenger = document.getElementById('footer-text-passenger');
  const footerLcv = document.getElementById('footer-text-lcv');
  const footerTruck = document.getElementById('footer-text-truck');
  const footerBus = document.getElementById('footer-text-bus');

  function resetNavTabs() {
    [panelPassenger, panelLcv, panelTruck, panelBus].forEach(p => p?.classList.add('hidden'));
    [footerPassenger, footerLcv, footerTruck, footerBus].forEach(f => f?.classList.add('hidden'));
    [tabPassenger, tabLcv, tabTruck, tabBus].forEach(t => {
      t?.classList.remove('bg-[#E60012]', 'bg-[#2B2E30]', 'text-white');
      t?.classList.add('bg-[#EBEBEB]', 'text-[#2B2E30]');
    });
  }

  function showPassenger() {
    resetNavTabs();
    panelPassenger?.classList.remove('hidden');
    footerPassenger?.classList.remove('hidden');
    tabPassenger?.classList.add('bg-[#E60012]', 'text-white');
    tabPassenger?.classList.remove('bg-[#EBEBEB]', 'text-[#2B2E30]');
  }

  function showLcv() {
    resetNavTabs();
    panelLcv?.classList.remove('hidden');
    footerLcv?.classList.remove('hidden');
    tabLcv?.classList.add('bg-[#E60012]', 'text-white');
    tabLcv?.classList.remove('bg-[#EBEBEB]', 'text-[#2B2E30]');
  }

  function showTruck() {
    resetNavTabs();
    panelTruck?.classList.remove('hidden');
    footerTruck?.classList.remove('hidden');
    tabTruck?.classList.add('bg-[#E60012]', 'text-white');
    tabTruck?.classList.remove('bg-[#EBEBEB]', 'text-[#2B2E30]');
  }

  function showBus() {
    resetNavTabs();
    panelBus?.classList.remove('hidden');
    footerBus?.classList.remove('hidden');
    tabBus?.classList.add('bg-[#E60012]', 'text-white');
    tabBus?.classList.remove('bg-[#EBEBEB]', 'text-[#2B2E30]');
  }

  tabPassenger?.addEventListener('click', showPassenger);
  tabLcv?.addEventListener('click', showLcv);
  tabTruck?.addEventListener('click', showTruck);
  tabBus?.addEventListener('click', showBus);
</script>

<style>
  .hamburger-line {
    transform-origin: center;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease;
  }

  #mobile-menu-btn.is-active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }

  #mobile-menu-btn.is-active .line-2 {
    opacity: 0;
    transform: scaleX(0);
  }

  #mobile-menu-btn.is-active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }

  .mobile-menu-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, border-color 0.25s ease;
    opacity: 0;
    pointer-events: none;
    border-top: 1px solid transparent;
  }

  .mobile-menu-wrapper.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
    pointer-events: auto;
    border-top-color: #E3E5E6;
  }

  .mobile-menu-inner {
    overflow: hidden;
  }

  .mobile-menu-content {
    max-height: calc(100vh - 65px);
    overflow-y: auto;
    transform: translateY(-16px);
    opacity: 0.5;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }

  .mobile-menu-wrapper.is-open .mobile-menu-content {
    transform: translateY(0);
    opacity: 1;
  }

  @media (min-width: 1024px) {
    .mobile-menu-wrapper {
      display: none !important;
    }
  }
</style>
