---
import { Image } from 'astro:assets';
import { salesData, getWhatsAppLink } from '../data/sales';
import { carsData } from '../data/cars';

const currentYear = new Date().getFullYear();
const waUrl = getWhatsAppLink();

const navLinks = [
  { name: 'Beranda', href: '/' },
  { name: 'Katalog Model', href: '/model' },
  { name: 'Promo & Diskon', href: '/promo' },
  { name: 'Daftar Harga OTR', href: '/pricelist' },
  { name: 'Unduh Brosur', href: '/brosur' },
  { name: 'Berita & Tips', href: '/berita' },
  // { name: 'Simulasi Kredit', href: '/#simulasi-kredit' },
  { name: 'Testimoni', href: '/#testimoni' },
];
---

<footer id="kontak" class="ft">
  <div class="ft-body">

    <div class="ft-left">
      <div class="ft-logo">
        <div class="ft-logo-mark">
          <Image src="/images/logo/mitsubishi-logo.svg" alt="Mitsubishi" width={28} height={28} />
        </div>
        <div>
          <div class="ft-logo-name">MITSUBISHI <span>JAKARTA</span></div>
          <div class="ft-logo-tag">Authorized Sales</div>
        </div>
      </div>

      <p class="ft-tagline">
        Sales resmi Mitsubishi Motors wilayah Jakarta &amp; Jabodetabek.<br />
        Cash · Kredit · Tukar Tambah · Test Drive ke Rumah.
      </p>

      <div class="ft-contact">
        <a href={waUrl} target="_blank" rel="noopener noreferrer" class="ft-wa">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {salesData.whatsappDisplay}
        </a>
        <div class="ft-meta">
          <span>{salesData.nickname}</span>
          <span class="ft-dot"></span>
          <span>{salesData.role}</span>
        </div>
        <div class="ft-hours">Senin – Minggu &nbsp;08.00 – 21.00 WIB</div>
      </div>
    </div>

    <div class="ft-section">
      <div class="ft-section-title">Halaman</div>
      <ul class="ft-links">
        {navLinks.map(item => (
          <li><a href={item.href}>{item.name}</a></li>
        ))}
      </ul>
    </div>

    <div class="ft-section">
      <div class="ft-section-title">Lineup</div>
      <ul class="ft-links">
        {carsData.filter(car => car.segment !== 'commercial').map(car => (
          <li>
            <a href={`/model/${car.slug}`}>{car.name}</a>
          </li>
        ))}
        <li class="ft-more-item">
          <a href="/model" class="ft-more-link">
            <span>Lihat Semua Model</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ft-chevron">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </a>
        </li>
      </ul>
    </div>

    <div class="ft-section ft-section--map">
      <div class="ft-section-title">Lokasi Dealer</div>
      <div class="ft-dealer-card">
        <div class="ft-dealer-name">{salesData.dealer}</div>
        <div class="ft-dealer-addr">Jl. Panjang No. 8, Kebon Jeruk, Jakarta Barat 11530</div>
        <div class="ft-map-wrap">
          <iframe
            src="https://maps.google.com/maps?q=PT.+Lautan+Berlian+Kebon+Jeruk,+Jl.+Panjang+No.8,+Jakarta+Barat&t=&z=15&ie=UTF8&iwloc=&output=embed"
            width="100%"
            height="195"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Lokasi PT Lautan Berlian Kebon Jeruk"
          ></iframe>
        </div>
        <a href={salesData.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="ft-map-link">
          <span>Petunjuk Arah Google Maps</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ft-chevron">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </a>
      </div>
    </div>

  </div>

  <div class="ft-disclaimer-band">
    <div class="ft-disclaimer-inner">
      <p class="ft-disclaimer-text">
        <strong>Disclaimer Hukum Sales Independen:</strong> Website ini dikelola secara independen oleh <strong>{salesData.name}</strong> ({salesData.role}) pada dealer resmi <strong>{salesData.dealer}</strong>. Website ini bukan website korporat resmi PT Mitsubishi Motors Krama Yudha Sales Indonesia (PT MMKSI) maupun PT Krama Yudha Tiga Berlian Motors (PT KTB). Segala transaksi pembayaran pemesanan kendaraan (Booking Fee, DP, Pelunasan) hanya sah apabila ditransfer langsung ke rekening resmi perusahaan <strong>PT Lautan Berlian Utama Motor</strong>.
      </p>
      <div class="ft-bottom-bar">
        <div class="ft-copyright">
          &copy; {currentYear} Auto Mitsubishi Jakarta - {salesData.name} ({salesData.dealer.replace(/^PT\.\s*/i, '')}). All rights reserved. <span class="ft-author-sep">·</span> Dibuat oleh <a href="https://sukamcd.tech" target="_blank" rel="noopener noreferrer" class="ft-author">sukamcd.tech</a>
        </div>
        <div class="ft-legal-bar-links">
          <a href="/disclaimer">Disclaimer Sales</a>
          <span class="ft-legal-sep">·</span>
          <a href="/kebijakan-privasi">Kebijakan Privasi</a>
          <span class="ft-legal-sep">·</span>
          <a href="/syarat-ketentuan">Syarat &amp; Ketentuan</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .ft {
    background: #0d0d0d;
    border-top: 1px solid #1c1c1c;
    color: #fff;
  }

  .ft-body {
    max-width: 1240px;
    margin: 0 auto;
    padding: 64px 32px 56px;
    display: grid;
    grid-template-columns: 1.3fr 0.8fr 1.1fr 1.5fr;
    gap: 40px;
  }

  @media (max-width: 1024px) {
    .ft-body {
      grid-template-columns: 1fr 1fr;
      gap: 40px 32px;
    }
  }

  @media (max-width: 640px) {
    .ft-body {
      grid-template-columns: 1fr 1fr;
      padding: 40px 16px 36px;
      gap: 32px 16px;
    }

    .ft-left,
    .ft-section--map {
      grid-column: span 2;
    }

    .ft-links li a {
      font-size: 12px;
      padding: 6px 0;
    }

    .ft-tagline {
      margin-bottom: 20px;
    }
  }

  .ft-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    margin-bottom: 20px;
    cursor: default;
    user-select: none;
  }

  .ft-logo-mark {
    width: 38px;
    height: 38px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 7px;
    flex-shrink: 0;
  }

  .ft-logo-mark img { width: 100%; height: 100%; object-fit: contain; }

  .ft-logo-name {
    font-size: 14px;
    font-weight: 900;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1.2;
  }

  .ft-logo-name span { color: #E60012; }

  .ft-logo-tag {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #484848;
    margin-top: 2px;
  }

  .ft-tagline {
    font-size: 13px;
    color: #5a5a5a;
    line-height: 1.8;
    margin-bottom: 28px;
    max-width: 340px;
  }

  .ft-contact {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ft-wa {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #22c55e;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    padding: 10px 18px;
    width: fit-content;
    transition: background 0.18s;
  }

  .ft-wa:hover { background: #16a34a; }

  .ft-wa svg { width: 18px; height: 18px; flex-shrink: 0; }

  .ft-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #4a4a4a;
    flex-wrap: wrap;
  }

  .ft-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #333;
    flex-shrink: 0;
  }

  .ft-hours {
    font-size: 12px;
    color: #3a3a3a;
  }

  .ft-section-title {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #E60012;
    margin-bottom: 18px;
  }

  .ft-section {
    display: flex;
    flex-direction: column;
  }

  .ft-section .ft-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .ft-links li a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: #5a5a5a;
    text-decoration: none;
    padding: 7px 0;
    border-bottom: 1px solid #161616;
    transition: color 0.15s;
  }

  .ft-links li a:hover { color: #fff; }

  .ft-more-item {
    margin-top: auto;
  }

  .ft-links li a.ft-more-link {
    display: inline-flex;
    justify-content: flex-start;
    align-items: center;
    gap: 6px;
    width: fit-content;
    color: #888;
    font-size: 12px;
    font-weight: 500;
    border-bottom: none;
    padding-top: 12px;
    transition: color 0.15s;
  }

  .ft-links li a.ft-more-link:hover {
    color: #fff;
  }

  .ft-chevron {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .ft-links li a.ft-more-link:hover .ft-chevron,
  .ft-map-link:hover .ft-chevron {
    transform: translateX(3px);
  }

  .ft-section--map {
    display: flex;
    flex-direction: column;
  }

  .ft-dealer-card {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 6px;
  }

  .ft-dealer-name {
    font-size: 13px;
    font-weight: 700;
    color: #e5e5e5;
    line-height: 1.4;
  }

  .ft-dealer-addr {
    font-size: 12px;
    color: #6a6a6a;
    line-height: 1.5;
  }

  .ft-map-wrap {
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid #1c1c1c;
    background: #141414;
    margin-top: 4px;
    line-height: 0;
  }

  .ft-map-wrap iframe {
    display: block;
    width: 100%;
    height: 195px;
    border: 0;
  }

  .ft-map-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 500;
    color: #888;
    text-decoration: none;
    margin-top: auto;
    padding-top: 12px;
    transition: color 0.15s;
    width: fit-content;
  }

  .ft-map-link:hover {
    color: #fff;
  }

  /* Disclaimer Band & Bottom Bar */
  .ft-disclaimer-band {
    border-top: 1px solid #1c1c1c;
    background: #080808;
    padding: 24px 32px 32px;
  }

  .ft-disclaimer-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ft-disclaimer-text {
    font-size: 11.5px;
    color: #666;
    line-height: 1.7;
    margin: 0;
  }

  .ft-disclaimer-text strong {
    color: #999;
  }

  .ft-bottom-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 16px;
    border-top: 1px solid #161616;
  }

  .ft-copyright {
    font-size: 11.5px;
    color: #555;
    line-height: 1.6;
  }

  .ft-author-sep {
    color: #333;
    margin: 0 4px;
  }

  .ft-author {
    color: #777;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s;
  }

  .ft-author:hover {
    color: #fff;
  }

  .ft-legal-bar-links {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 11.5px;
    font-weight: 500;
  }

  .ft-legal-bar-links a {
    color: #777;
    text-decoration: none;
    transition: color 0.15s;
  }

  .ft-legal-bar-links a:hover {
    color: #E60012;
    text-decoration: underline;
  }

  .ft-legal-sep {
    color: #333;
  }

  @media (max-width: 640px) {
    .ft-disclaimer-band {
      padding: 20px 16px 84px;
    }

    .ft-bottom-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>

