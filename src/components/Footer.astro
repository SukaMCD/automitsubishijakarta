---
import { salesData, getWhatsAppLink } from '../data/sales';
import { carsData } from '../data/cars';

const currentYear = new Date().getFullYear();
const waUrl = getWhatsAppLink();

const navLinks = [
  { name: 'Beranda', href: '/' },
  { name: 'Katalog Model', href: '/model' },
  { name: 'Promo & Diskon', href: '/promo' },
  { name: 'Daftar Harga OTR', href: '/pricelist' },
  { name: 'Simulasi Kredit', href: '/simulasi-kredit' },
  { name: 'Testimoni', href: '/testimoni' },
  { name: 'Kontak & Lokasi', href: '/kontak' },
];
---

<footer class="ft">
  <div class="ft-body">

    <!-- Kiri: brand + kontak -->
    <div class="ft-left">
      <div class="ft-logo">
        <div class="ft-logo-mark">
          <img src="/images/logo/mitsubishi-logo.svg" alt="Mitsubishi" />
        </div>
        <div>
          <div class="ft-logo-name">MITSUBISHI <span>JAKARTA</span></div>
          <div class="ft-logo-tag">Authorized Sales</div>
        </div>
      </div>

      <p class="ft-tagline">
        Sales resmi Mitsubishi Motors wilayah Jakarta &amp; Jabodetabek.<br />
        Cash · Kredit · Tukar Tambah · Test Drive ke Rumah.
      </p>

      <div class="ft-contact">
        <a href={waUrl} target="_blank" rel="noopener noreferrer" class="ft-wa">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {salesData.whatsappDisplay}
        </a>
        <div class="ft-meta">
          <span>{salesData.nickname}</span>
          <span class="ft-dot"></span>
          <span>{salesData.role}</span>
        </div>
        <div class="ft-hours">Senin – Minggu &nbsp;08.00 – 21.00 WIB</div>
      </div>
    </div>

    <!-- Tengah: navigasi -->
    <div class="ft-section">
      <div class="ft-section-title">Halaman</div>
      <ul class="ft-links">
        {navLinks.map(item => (
          <li><a href={item.href}>{item.name}</a></li>
        ))}
      </ul>
    </div>

    <!-- Kanan: lineup produk -->
    <div class="ft-section">
      <div class="ft-section-title">Lineup</div>
      <ul class="ft-links ft-links--model">
        {carsData.map(car => (
          <li>
            <a href={`/model/${car.slug}`}>
              <span>{car.name}</span>
              <span class="ft-price">{car.cicilanStart}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

  </div>

  <!-- Bottom -->
  <div class="ft-bottom">
    <span>&copy; {currentYear} {salesData.dealer} · Website oleh <a href="https://sukamcd.tech" target="_blank" rel="noopener noreferrer" class="ft-author">sukamcd.tech</a></span>
    <span>Website independen · Logo &amp; merek milik PT MMKSI</span>
  </div>
</footer>

<style>
  .ft {
    background: #0d0d0d;
    border-top: 1px solid #1c1c1c;
    color: #fff;
  }

  .ft-body {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 40px 56px;
    display: grid;
    grid-template-columns: 2fr 1fr 1.4fr;
    gap: 64px;
  }

  @media (max-width: 1024px) {
    .ft-body { grid-template-columns: 1fr 1fr; gap: 48px; }
    .ft-left { grid-column: 1 / -1; }
  }

  @media (max-width: 600px) {
    .ft-body { grid-template-columns: 1fr; padding: 48px 24px 40px; gap: 40px; }
    .ft-left { grid-column: auto; }
  }

  /* Logo */
  .ft-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    margin-bottom: 20px;
    cursor: default;
    user-select: none;
  }

  .ft-logo-mark {
    width: 38px;
    height: 38px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 7px;
    flex-shrink: 0;
  }

  .ft-logo-mark img { width: 100%; height: 100%; object-fit: contain; }

  .ft-logo-name {
    font-size: 14px;
    font-weight: 900;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1.2;
  }

  .ft-logo-name span { color: #E60012; }

  .ft-logo-tag {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #484848;
    margin-top: 2px;
  }

  /* Tagline */
  .ft-tagline {
    font-size: 13px;
    color: #5a5a5a;
    line-height: 1.8;
    margin-bottom: 28px;
    max-width: 340px;
  }

  /* Contact area */
  .ft-contact {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ft-wa {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #22c55e;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    padding: 10px 18px;
    width: fit-content;
    transition: background 0.18s;
  }

  .ft-wa:hover { background: #16a34a; }

  .ft-wa svg { width: 18px; height: 18px; flex-shrink: 0; }

  .ft-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #4a4a4a;
    flex-wrap: wrap;
  }

  .ft-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #333;
    flex-shrink: 0;
  }

  .ft-hours {
    font-size: 12px;
    color: #3a3a3a;
  }

  /* Sections */
  .ft-section-title {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #E60012;
    margin-bottom: 18px;
  }

  .ft-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .ft-links li a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: #5a5a5a;
    text-decoration: none;
    padding: 7px 0;
    border-bottom: 1px solid #161616;
    transition: color 0.15s;
  }

  .ft-links li a:hover { color: #fff; }

  .ft-price {
    font-size: 11px;
    font-weight: 600;
    color: #E60012;
    flex-shrink: 0;
  }

  /* Bottom bar */
  .ft-bottom {
    border-top: 1px solid #161616;
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 11px;
    color: #444;
  }

  .ft-author {
    color: #666;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.18s;
  }

  .ft-author:hover {
    color: #E60012;
  }

  @media (max-width: 600px) {
    .ft-bottom { padding: 14px 24px; flex-direction: column; align-items: flex-start; }
  }
</style>

