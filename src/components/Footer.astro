---
import { salesData, getWhatsAppLink } from '../data/sales';
import { carsData } from '../data/cars';

const currentYear = new Date().getFullYear();
const waUrl = getWhatsAppLink();

const navLinks = [
  { name: 'Beranda', href: '/' },
  { name: 'Katalog Model', href: '/model' },
  { name: 'Promo & Diskon', href: '/promo' },
  { name: 'Daftar Harga OTR', href: '/pricelist' },
  { name: 'Simulasi Kredit', href: '/simulasi-kredit' },
  { name: 'Testimoni', href: '/testimoni' },
  { name: 'Kontak & Lokasi', href: '/kontak' },
];
---

<footer class="ft">
  <div class="ft-body">

    <!-- Kiri: brand + kontak -->
    <div class="ft-left">
      <a href="/" class="ft-logo">
        <div class="ft-logo-mark">
          <img src="/images/logo/mitsubishi-logo.svg" alt="Mitsubishi" />
        </div>
        <div>
          <div class="ft-logo-name">MITSUBISHI <span>JAKARTA</span></div>
          <div class="ft-logo-tag">Authorized Sales</div>
        </div>
      </a>

      <p class="ft-tagline">
        Sales resmi Mitsubishi Motors wilayah Jakarta &amp; Jabodetabek.<br />
        Cash · Kredit · Tukar Tambah · Test Drive ke Rumah.
      </p>

      <div class="ft-contact">
        <a href={waUrl} target="_blank" rel="noopener noreferrer" class="ft-wa">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.288.043.088.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z"/></svg>
          {salesData.whatsappDisplay}
        </a>
        <div class="ft-meta">
          <span>{salesData.nickname}</span>
          <span class="ft-dot"></span>
          <span>{salesData.role}</span>
        </div>
        <div class="ft-hours">Senin – Minggu &nbsp;08.00 – 21.00 WIB</div>
      </div>
    </div>

    <!-- Tengah: navigasi -->
    <div class="ft-section">
      <div class="ft-section-title">Halaman</div>
      <ul class="ft-links">
        {navLinks.map(item => (
          <li><a href={item.href}>{item.name}</a></li>
        ))}
      </ul>
    </div>

    <!-- Kanan: lineup produk -->
    <div class="ft-section">
      <div class="ft-section-title">Lineup</div>
      <ul class="ft-links ft-links--model">
        {carsData.map(car => (
          <li>
            <a href={`/model/${car.slug}`}>
              <span>{car.name}</span>
              <span class="ft-price">{car.cicilanStart}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

  </div>

  <!-- Bottom -->
  <div class="ft-bottom">
    <span>&copy; {currentYear} {salesData.dealer} · Website oleh <a href="https://sukamcd.tech" target="_blank" rel="noopener noreferrer" class="ft-author">sukamcd.tech</a></span>
    <span>Website independen · Logo &amp; merek milik PT MMKSI</span>
  </div>
</footer>

<style>
  .ft {
    background: #0d0d0d;
    border-top: 1px solid #1c1c1c;
    color: #fff;
  }

  .ft-body {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 40px 56px;
    display: grid;
    grid-template-columns: 2fr 1fr 1.4fr;
    gap: 64px;
  }

  @media (max-width: 1024px) {
    .ft-body { grid-template-columns: 1fr 1fr; gap: 48px; }
    .ft-left { grid-column: 1 / -1; }
  }

  @media (max-width: 600px) {
    .ft-body { grid-template-columns: 1fr; padding: 48px 24px 40px; gap: 40px; }
    .ft-left { grid-column: auto; }
  }

  /* Logo */
  .ft-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    margin-bottom: 20px;
  }

  .ft-logo-mark {
    width: 38px;
    height: 38px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 7px;
    flex-shrink: 0;
    transition: background 0.18s;
  }

  .ft-logo:hover .ft-logo-mark { background: #E60012; }
  .ft-logo-mark img { width: 100%; height: 100%; object-fit: contain; }

  .ft-logo-name {
    font-size: 14px;
    font-weight: 900;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1.2;
  }

  .ft-logo-name span { color: #E60012; }

  .ft-logo-tag {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #484848;
    margin-top: 2px;
  }

  /* Tagline */
  .ft-tagline {
    font-size: 13px;
    color: #5a5a5a;
    line-height: 1.8;
    margin-bottom: 28px;
    max-width: 340px;
  }

  /* Contact area */
  .ft-contact {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ft-wa {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #22c55e;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    padding: 10px 18px;
    width: fit-content;
    transition: background 0.18s;
  }

  .ft-wa:hover { background: #16a34a; }

  .ft-wa svg { width: 15px; height: 15px; flex-shrink: 0; }

  .ft-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #4a4a4a;
    flex-wrap: wrap;
  }

  .ft-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #333;
    flex-shrink: 0;
  }

  .ft-hours {
    font-size: 12px;
    color: #3a3a3a;
  }

  /* Sections */
  .ft-section-title {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #E60012;
    margin-bottom: 18px;
  }

  .ft-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .ft-links li a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: #5a5a5a;
    text-decoration: none;
    padding: 7px 0;
    border-bottom: 1px solid #161616;
    transition: color 0.15s;
  }

  .ft-links li a:hover { color: #fff; }

  .ft-price {
    font-size: 11px;
    font-weight: 600;
    color: #E60012;
    flex-shrink: 0;
  }

  /* Bottom bar */
  .ft-bottom {
    border-top: 1px solid #161616;
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 11px;
    color: #444;
  }

  .ft-author {
    color: #666;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.18s;
  }

  .ft-author:hover {
    color: #E60012;
  }

  @media (max-width: 600px) {
    .ft-bottom { padding: 14px 24px; flex-direction: column; align-items: flex-start; }
  }
</style>

