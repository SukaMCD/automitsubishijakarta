---
import { Image } from 'astro:assets';
import { salesData, getWhatsAppLink } from '../../data/sales';

const waBase = getWhatsAppLink('Halo Kanhadi, saya ingin konsultasi promo dan kredit Mitsubishi terbaru.');
---

<section class="bg-[#1A1C1E] text-white">
  <div class="max-w-360 mx-auto">

    <div class="border-b border-white/10 px-4 sm:px-6 md:px-12 py-4 sm:py-6">
      <h2 class="text-[11px] sm:text-xs font-black uppercase tracking-[0.18em] text-brand-red">Tentang Sales Kami</h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12">

      <div class="lg:col-span-4 border-b lg:border-b-0 lg:border-r border-white/10 px-4 sm:px-6 md:px-12 py-8 sm:py-10 lg:py-14 flex flex-col gap-6 sm:gap-8">

        <div class="flex items-center gap-4 sm:gap-5">
          <div class="relative w-18 sm:w-20 h-22 sm:h-24 shrink-0 rounded-xl overflow-hidden border-2 border-brand-red/80 shadow-xl bg-[#222426]">
            <Image 
              src="/images/kanhadi-profile.webp" 
              alt="Kanhadi - Senior Sales Consultant Mitsubishi Lautan Berlian" 
              width={160}
              height={192}
              class="w-full h-full object-cover object-top"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 right-0 w-5 h-5 bg-brand-red rounded-tl-md flex items-center justify-center p-0.5 shadow-sm" title="Dealer Resmi PT Lautan Berlian">
              <Image src="/images/logo/mitsubishi-logo.svg" alt="Mitsubishi" width={14} height={14} class="w-3.5 h-3.5 object-contain brightness-0 invert" />
            </div>
          </div>
          <div class="space-y-0.5">
            <div class="text-lg sm:text-xl font-black text-white leading-tight">{salesData.name}</div>
            <div class="text-[11.5px] text-[#A6A9AB] font-medium leading-snug">{salesData.role}</div>
            {salesData.nip && (
              <div class="text-[10px] text-brand-red font-mono font-bold pt-0.5 tracking-wider">NIP: {salesData.nip}</div>
            )}
          </div>
        </div>

        <p class="text-[13px] sm:text-[14px] text-cold-grey leading-relaxed">
          "Siap membantu pengadaan unit kendaraan Anda. DP 0%, bunga rendah, diskon maksimal, dan unit ready stock dengan proses mudah dan cepat."
        </p>

        <div class="grid grid-cols-3 divide-x divide-white/10 border border-white/10 rounded-xl bg-white/2 overflow-hidden shadow-inner">
          <div class="px-1.5 sm:px-3 py-3 sm:py-4 flex flex-col items-center justify-center text-center">
            <div class="text-[13px] sm:text-[15px] md:text-[16px] font-black text-white leading-snug">Resmi 3S</div>
            <div class="text-[9.5px] sm:text-[10.5px] text-[#8C9094] mt-0.5 uppercase tracking-wide">Dealer MMKSI</div>
          </div>
          <div class="px-1 sm:px-2 py-3 sm:py-4 flex flex-col items-center justify-center text-center">
            <div class="text-[11.5px] sm:text-[13.5px] md:text-[14.5px] font-black text-white leading-snug tracking-tight">Jabodetabek</div>
            <div class="text-[9.5px] sm:text-[10.5px] text-[#8C9094] mt-0.5 uppercase tracking-wide">Area Layanan</div>
          </div>
          <div class="px-1.5 sm:px-3 py-3 sm:py-4 flex flex-col items-center justify-center text-center">
            <div class="text-[13px] sm:text-[15px] md:text-[16px] font-black text-white leading-snug">7 Hari</div>
            <div class="text-[9.5px] sm:text-[10.5px] text-[#8C9094] mt-0.5 uppercase tracking-wide">Konsultasi Aktif</div>
          </div>
        </div>

        <div class="space-y-2 text-[12px] sm:text-[13px]">
          <div class="flex gap-3">
            <span class="text-[#686D71] w-20 shrink-0">WhatsApp</span>
            <span class="font-semibold">{salesData.whatsappDisplay}</span>
          </div>
          <div class="flex gap-3">
            <span class="text-[#686D71] w-20 shrink-0">Wilayah</span>
            <span class="font-semibold">Jakarta &amp; Jabodetabek</span>
          </div>
          <div class="flex gap-3">
            <span class="text-[#686D71] w-20 shrink-0">Dealer</span>
            <span class="font-semibold">Resmi 3S PT MMKSI</span>
          </div>
        </div>

        <a href={waBase} target="_blank" rel="noopener noreferrer"
          class="group flex items-center justify-between bg-brand-red hover:bg-white hover:text-black text-white text-[13px] font-bold pl-5 pr-2.5 py-3 transition-all duration-300 ease-spring active:scale-[0.98] shadow-lg shadow-red-950/20">
          <span>Hubungi via WhatsApp</span>
          <span class="w-7 h-7 rounded-full bg-white/20 flex items-center justify-center transition-all duration-300 group-hover:translate-x-0.5 group-hover:bg-black group-hover:text-white">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </span>
        </a>
      </div>

      <div class="lg:col-span-8 px-4 sm:px-6 md:px-12 py-5 sm:py-10 lg:py-14">
        <div class="text-[10px] font-black uppercase tracking-[0.18em] text-[#686D71] mb-3 sm:mb-7">Fasilitas &amp; Layanan Resmi</div>
        <div class="grid grid-cols-2 gap-2 sm:gap-x-10 sm:gap-y-0">
          {salesData.perks.map((perk, i) => (
            <div class="p-2.5 sm:py-5 sm:px-0 bg-[#222426] sm:bg-transparent border border-white/10 sm:border-0 sm:border-b sm:border-white/8 last:border-0 flex flex-col justify-between">
              <div class="flex items-center justify-between gap-1 mb-1">
                <span class="text-[9.5px] font-mono font-bold text-brand-red sm:hidden">0{i+1}</span>
                <span class="sm:hidden text-[8.5px] text-[#686D71] uppercase tracking-wider font-semibold">Resmi</span>
              </div>
              <div class="text-[11.5px] sm:text-[13px] font-bold text-white leading-tight">{perk.title}</div>
              <div class="sm:hidden text-[9.5px] text-[#8C9094] mt-1 line-clamp-1">{perk.shortDesc || perk.description}</div>
              <div class="hidden sm:block text-[12px] text-[#686D71] leading-relaxed mt-1">{perk.description}</div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
