---
import { Image } from 'astro:assets';
import { testimonialsData } from '../../data/testimonials';
import { getWhatsAppLink } from '../../data/sales';

const waTesti = getWhatsAppLink('Halo Kanhadi, saya ingin konsultasi promo dan ulasan kepuasan konsumen Mitsubishi Jakarta.');
---

<section id="testimoni" class="bg-white py-8 sm:py-16 md:py-24 border-b border-concrete scroll-mt-20 overflow-hidden">
  <div class="max-w-360 mx-auto px-4 sm:px-6">

    <div class="flex flex-col sm:flex-row justify-between sm:items-end gap-3 sm:gap-4 mb-6 sm:mb-10">
      <div>
        <div class="text-[10px] font-black uppercase tracking-[0.18em] text-brand-red mb-1 sm:mb-2">Dokumentasi Resmi &amp; Ulasan</div>
        <h2 class="text-xl sm:text-3xl font-black tracking-tight text-anthracite">Serah Terima Unit Konsumen</h2>
        <p class="text-[12px] sm:text-[13px] text-cold-grey mt-1 max-w-xl">
          Dokumentasi penyerahan unit Mitsubishi langsung oleh Kanhadi bersama tim dealer resmi PT Lautan Berlian Kebon Jeruk.
        </p>
      </div>
      <a 
        href={waTesti} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-1.5 text-[12px] sm:text-[13px] font-bold text-brand-red hover:text-black transition-colors whitespace-nowrap w-fit group"
      >
        <span class="hover:underline underline-offset-4">Tanya Pengalaman Konsumen</span>
        <svg class="w-4 h-4 shrink-0 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div 
      id="testi-carousel"
      class="flex md:grid md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 overflow-x-auto md:overflow-x-visible pb-3 md:pb-0 scroll-smooth snap-x snap-mandatory scrollbar-none -mx-4 px-4 sm:mx-0 sm:px-0"
      style="scrollbar-width: none; -ms-overflow-style: none;"
    >
      {testimonialsData.map((t) => (
        <div class="shrink-0 w-[86vw] max-w-90 md:w-auto snap-center md:snap-align-none border border-concrete hover:border-anthracite flex flex-col justify-between group transition-all duration-300 bg-white overflow-hidden shadow-xs hover:shadow-lg">
          
          {t.image && (
            <div class="relative w-full aspect-16/11 bg-neutral-100 overflow-hidden">
              <Image 
                src={t.image} 
                alt={`${t.customerName} - ${t.carPurchased}`}
                width={720}
                height={495}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>
              <span class="absolute top-3 left-3 bg-brand-red text-white text-[9px] font-black uppercase tracking-wider px-2.5 py-0.5 shadow-sm">
                Dokumentasi Resmi
              </span>
              <span class="absolute bottom-2.5 left-3 right-3 text-white text-[12px] font-bold truncate drop-shadow-md">
                {t.carPurchased}
              </span>
            </div>
          )}

          <div class="p-4 sm:p-6 flex flex-col justify-between flex-1">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <div class="flex gap-0.5">
                  {Array.from({length:t.rating}).map(() => (
                    <svg class="w-3.5 h-3.5 text-brand-red" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  ))}
                </div>
                <span class="text-[9.5px] text-[#A6A9AB] font-mono">{t.deliveryDate}</span>
              </div>
              <p class="text-[12px] sm:text-[13px] text-anthracite leading-relaxed">"{t.comment}"</p>
            </div>
            
            <div class="mt-4 pt-3.5 border-t border-concrete">
              <div class="text-[13px] font-bold text-anthracite group-hover:text-brand-red transition-colors">{t.customerName}</div>
              <div class="text-[11px] text-[#686D71] mt-0.5">{t.occupation} · {t.location}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="flex md:hidden items-center justify-center gap-1.5 mt-3">
      {testimonialsData.map((_, i) => (
        <span 
          class="testi-dot h-1 rounded-full transition-all duration-300"
          data-index={i}
          style={i === 0 ? "width: 16px; background: #E60012;" : "width: 6px; background: #D1D5DB;"}
        ></span>
      ))}
    </div>

  </div>
</section>

<script is:inline>
const testiCarousel = document.getElementById('testi-carousel');
const testiDots = document.querySelectorAll('.testi-dot');

if (testiCarousel && testiDots.length > 0) {
  testiCarousel.addEventListener('scroll', () => {
    const card = testiCarousel.querySelector('div');
    const cardWidth = card ? card.offsetWidth + 12 : 300;
    const index = Math.min(Math.round(testiCarousel.scrollLeft / cardWidth), testiDots.length - 1);
    testiDots.forEach((dot, i) => {
      if (i === index) {
        dot.style.width = '16px';
        dot.style.background = '#E60012';
      } else {
        dot.style.width = '6px';
        dot.style.background = '#D1D5DB';
      }
    });
  }, { passive: true });
}
</script>
