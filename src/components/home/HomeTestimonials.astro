---
import { testimonialsData } from '../../data/testimonials';
---

<!-- Testimoni -->
<section class="bg-white py-16 md:py-24 border-b border-[#E3E5E6]">
  <div class="max-w-[1440px] mx-auto px-6">

    <div class="flex justify-between items-end mb-10">
      <div>
        <div class="text-[10px] font-black uppercase tracking-[0.15em] text-[#E60012] mb-2">Apa Kata Mereka</div>
        <h2 class="text-3xl font-black tracking-tight text-[#2B2E30]">Testimoni Konsumen</h2>
      </div>
      <a href="/testimoni" class="text-[13px] font-bold text-[#E60012] hover:text-black flex items-center gap-1 transition-colors hover-line">
        Lihat Semua
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      {testimonialsData.map((t) => (
        <div class="border border-[#E3E5E6] hover:border-[#2B2E30] p-6 flex flex-col justify-between group transition-colors">
          <div class="space-y-4">
            <div class="flex gap-0.5">
              {Array.from({length:t.rating}).map(() => (
                <svg class="w-3.5 h-3.5 text-[#E60012]" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <p class="text-[13px] text-[#686D71] leading-relaxed">"{t.comment}"</p>
          </div>
          <div class="mt-5 pt-4 border-t border-[#F0F0F0]">
            <div class="text-[13px] font-bold text-[#2B2E30] group-hover:text-[#E60012] transition-colors">{t.customerName}</div>
            <div class="text-[11px] text-[#686D71] mt-0.5">{t.occupation} · {t.location}</div>
            <div class="text-[11px] font-semibold text-[#E60012] mt-1">{t.carPurchased}</div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
