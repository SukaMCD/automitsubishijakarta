---
import { Image } from 'astro:assets';
import { getWhatsAppLink } from '../../data/sales';

const heroSlides = [
  {
    key: 'canter-fe71',
    badge: 'PROMO DP 0% • ENGKEL 4 BAN',
    title: 'Canter FE 71L',
    desc: 'Truk engkel 4 roda bertenaga 108 PS Euro 4 dengan aplikasi Box Aluminium. Volume muat maksimal untuk logistik perkotaan bebas batasan jam truk.',
    link: '/model/canter-fe71',
    img: '/images/cars/canter-fe-71/1-4.webp',
    pillLabel: 'Canter FE 71L (Box)',
    objectPos: 'object-[65%_center] sm:object-center',
    waText: 'Halo Kanhadi, saya ingin konsultasi promo DP 0% dan kredit Mitsubishi Canter FE 71L Box Aluminium.',
  },
  {
    key: 'canter-fe74',
    badge: 'PROMO DP 0% • DOUBLE 6 BAN',
    title: 'Canter FE 74',
    desc: 'Truk 6 roda serbaguna bertenaga 136 PS Euro 4 dengan aplikasi Bak Kayu Rangka Besi. Tangguh untuk ekspedisi antarkota dan angkutan muatan berat.',
    link: '/model/canter-fe74',
    img: '/images/cars/canter-fe-74/FE_74.webp',
    pillLabel: 'Canter FE 74 (Bak Kayu)',
    objectPos: 'object-[60%_center] sm:object-center',
    waText: 'Halo Kanhadi, saya ingin konsultasi promo DP 0% dan kredit Mitsubishi Canter FE 74 Bak Kayu.',
  },
];
---

<section id="hero-slider" class="relative w-full bg-black overflow-hidden h-65 sm:h-90 md:h-120 lg:h-145">
  {heroSlides.map((slide, i) => (
    <div 
      class="hero-slide absolute inset-0 transition-opacity duration-500 ease-in-out select-none" 
      data-index={i}
      style={i === 0 ? "opacity: 1; z-index: 10; pointer-events: auto;" : "opacity: 0; z-index: 0; pointer-events: none;"}
    >
      <div class="absolute inset-0 overflow-hidden">
        <Image 
          src={slide.img} 
          alt={slide.title}
          width={1920}
          height={784}
          loading="eager"
          decoding="async"
          class={`w-full h-full object-cover ${slide.objectPos} pointer-events-none`}
        />
        <div class="absolute inset-0 bg-black/40 sm:bg-black/35"></div>
        <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.6) 45%, rgba(0,0,0,0.15) 80%, transparent 100%);"></div>
        <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 55%);"></div>
      </div>

      <div class="relative z-10 max-w-360 mx-auto px-4 sm:px-6 h-full flex flex-col justify-end pb-3 sm:pb-5 md:pb-14 lg:pb-18">
        <div class="max-w-xl text-white space-y-1 sm:space-y-2 md:space-y-3.5">
          <span class="inline-block bg-brand-red text-white text-[8.5px] sm:text-[10px] font-black uppercase tracking-[0.15em] px-2 sm:px-3 py-0.5 sm:py-1">
            {slide.badge}
          </span>

          <div class="space-y-0.5">
            <h1 class="text-xl sm:text-3xl md:text-5xl lg:text-6xl font-black tracking-tight leading-[1.05]">
              {slide.title}
            </h1>

            <p class="hidden sm:block text-[#D1D5DB] text-xs sm:text-sm md:text-base leading-relaxed line-clamp-1 md:line-clamp-none max-w-lg">
              {slide.desc}
            </p>
          </div>

          <div class="flex items-center gap-2.5 sm:gap-3.5 pt-1 sm:pt-2">
            <a href={slide.link}
              class="group relative inline-flex items-center justify-between gap-2.5 bg-brand-red hover:bg-black text-white text-[11px] sm:text-[12px] md:text-[13px] font-bold pl-4 sm:pl-5 pr-2.5 sm:pr-3 py-1.5 sm:py-2.5 md:py-2.5 transition-all duration-300 ease-spring active:scale-[0.98] shadow-lg shadow-red-950/20">
              <span>Lihat Detail</span>
              <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-white/15 flex items-center justify-center transition-transform duration-300 group-hover:translate-x-0.5 group-hover:bg-white group-hover:text-black">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </span>
            </a>
            <a href={getWhatsAppLink(slide.waText)} target="_blank" rel="noopener noreferrer"
              class="group inline-flex items-center justify-center gap-2 border border-white/30 hover:border-white hover:bg-white/10 text-white text-[11px] sm:text-[12px] md:text-[13px] font-semibold px-4 sm:px-5 py-2 sm:py-2.5 md:py-3 transition-all duration-300 backdrop-blur-md active:scale-[0.98]">
              <span>Tanya Promo WA</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  ))}

  <div class="hidden md:flex absolute bottom-6 right-16 md:right-20 z-20 gap-2 p-1.5 bg-black/40 backdrop-blur-xl border border-white/10 rounded-full max-w-[calc(100vw-120px)] overflow-x-auto no-scrollbar shadow-2xl">
    {heroSlides.map((item, i) => (
      <button 
        type="button" 
        class="hero-pill text-white text-[11px] font-bold px-4 py-1.5 rounded-full border transition-all duration-300 shrink-0 cursor-pointer"
        data-slide-index={i}
        style={i === 0 ? "background: #E60012; border-color: #E60012; box-shadow: 0 2px 10px rgba(230,0,18,0.4);" : "background: transparent; border-color: transparent; opacity: 0.75;"}
      >
        {item.pillLabel}
      </button>
    ))}
  </div>

  <div class="flex md:hidden absolute bottom-3 right-4 z-20 items-center gap-1.5 pointer-events-none">
    {heroSlides.map((_, i) => (
      <span 
        class="mobile-hero-dot h-1 rounded-full transition-all duration-300"
        data-dot-index={i}
        style={i === 0 ? "width: 16px; background: #E60012;" : "width: 6px; background: rgba(255,255,255,0.4);"}
      ></span>
    ))}
  </div>

  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 hidden md:flex flex-col items-center gap-1.5">
    <span class="text-[10px] text-white/50 uppercase tracking-[0.15em]">Scroll</span>
    <div class="w-px h-8 bg-white/20"></div>
  </div>
</section>

<script is:inline>
const heroSlides = document.querySelectorAll('.hero-slide');
const heroPills = document.querySelectorAll('.hero-pill');
const mobileDots = document.querySelectorAll('.mobile-hero-dot');
let currentHeroIndex = 0;
let heroAutoTimer = null;

function setHeroSlide(index) {
  currentHeroIndex = index;
  heroSlides.forEach((slide, i) => {
    if (i === index) {
      slide.style.opacity = '1';
      slide.style.zIndex = '10';
      slide.style.pointerEvents = 'auto';
    } else {
      slide.style.opacity = '0';
      slide.style.zIndex = '0';
      slide.style.pointerEvents = 'none';
    }
  });

  heroPills.forEach((pill, i) => {
    if (i === index) {
      pill.style.background = '#E60012';
      pill.style.borderColor = '#E60012';
      pill.style.color = '#ffffff';
    } else {
      pill.style.background = 'rgba(0,0,0,0.55)';
      pill.style.borderColor = 'rgba(255,255,255,0.2)';
      pill.style.color = '#ffffff';
    }
  });

  mobileDots.forEach((dot, i) => {
    if (i === index) {
      dot.style.width = '16px';
      dot.style.background = '#E60012';
    } else {
      dot.style.width = '6px';
      dot.style.background = 'rgba(255,255,255,0.4)';
    }
  });
}

heroPills.forEach((pill) => {
  pill.addEventListener('click', () => {
    const idx = parseInt(pill.getAttribute('data-slide-index'));
    if (!isNaN(idx)) {
      setHeroSlide(idx);
      resetAutoHero();
    }
  });
});

function resetAutoHero() {
  if (heroAutoTimer) clearInterval(heroAutoTimer);
  heroAutoTimer = setInterval(() => {
    if (heroSlides.length > 0) {
      const nextIdx = (currentHeroIndex + 1) % heroSlides.length;
      setHeroSlide(nextIdx);
    }
  }, 6000);
}

let touchStartX = 0;
const heroSection = document.getElementById('hero-slider');
heroSection?.addEventListener('touchstart', (e) => {
  touchStartX = e.changedTouches[0].screenX;
}, { passive: true });
heroSection?.addEventListener('touchend', (e) => {
  const touchEndX = e.changedTouches[0].screenX;
  const diff = touchStartX - touchEndX;
  if (Math.abs(diff) > 40) {
    if (diff > 0) {
      setHeroSlide((currentHeroIndex + 1) % heroSlides.length);
    } else {
      setHeroSlide((currentHeroIndex - 1 + heroSlides.length) % heroSlides.length);
    }
    resetAutoHero();
  }
}, { passive: true });

resetAutoHero();
</script>
