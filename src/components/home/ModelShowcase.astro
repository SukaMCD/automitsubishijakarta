---
import { Image } from 'astro:assets';
import { carsData } from '../../data/cars';

const passengerCars = carsData.filter(c => c.segment === 'passenger');
const lcvCars = carsData.filter(c => c.segment === 'lcv');
const commercialCars = carsData.filter(c => c.segment === 'commercial');
---

<!-- Model Showcase -->
<section class="bg-white border-b border-[#E3E5E6] py-10 sm:py-12 md:py-16 overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6">
    
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 sm:gap-4 mb-5 sm:mb-6">
      <div>
        <span class="text-[10px] font-black uppercase tracking-[0.16em] text-[#E60012] block mb-1">Pilihan Unit Resmi</span>
        <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-[#2B2E30]">Lineup Kendaraan Mitsubishi</h2>
      </div>
      
      <div class="w-full sm:w-auto grid grid-cols-3 sm:flex items-center gap-1 bg-[#F6F6F6] p-1 border border-[#E3E5E6]">
        <button 
          type="button" 
          class="carousel-filter-btn active text-[10px] sm:text-[12px] font-bold py-2 sm:py-1.5 px-1 sm:px-3.5 cursor-pointer text-center truncate"
          data-filter="passenger"
        >
          <span class="hidden sm:inline">Mobil </span>Penumpang ({passengerCars.length})
        </button>
        <button 
          type="button" 
          class="carousel-filter-btn text-[10px] sm:text-[12px] font-bold py-2 sm:py-1.5 px-1 sm:px-3.5 cursor-pointer text-center truncate"
          data-filter="lcv"
        >
          Niaga<span class="hidden sm:inline"> Ringan</span> ({lcvCars.length})
        </button>
        <button 
          type="button" 
          class="carousel-filter-btn text-[10px] sm:text-[12px] font-bold py-2 sm:py-1.5 px-1 sm:px-3.5 cursor-pointer text-center truncate"
          data-filter="commercial"
        >
          Truk &amp; Bus<span class="hidden sm:inline"> Fuso</span> ({commercialCars.length})
        </button>
      </div>
    </div>

    <div class="relative w-full">
      <div 
        id="model-carousel" 
        class="flex gap-4 sm:gap-6 md:gap-8 overflow-x-auto scroll-smooth scrollbar-none snap-x snap-mandatory py-4 px-[calc(50%-120px)] sm:px-14 md:px-20"
        style="scrollbar-width: none; -ms-overflow-style: none; mask-image: linear-gradient(to right, transparent 0%, black 4%, black 96%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 4%, black 96%, transparent 100%);"
      >
        {carsData.map((car) => (
          <a 
            href={`/model/${car.slug}`}
            draggable="false"
            data-segment={car.segment}
            style={car.segment !== 'passenger' ? 'display: none;' : ''}
            class="model-carousel-card flex-shrink-0 w-[240px] sm:w-[260px] md:w-[280px] lg:w-[300px] snap-center sm:snap-start group flex flex-col justify-between p-3 sm:p-4 bg-transparent transition-all duration-300 rounded-none select-none"
          >
            <div class="h-6 flex items-center justify-end px-1">
              {car.badge ? (
                <span class={`text-white text-[9px] sm:text-[10px] font-black uppercase tracking-wider px-2 sm:px-2.5 py-0.5 ${car.segment === 'commercial' ? 'bg-[#2B2E30]' : 'bg-[#E60012]'}`}>
                  {car.badge}
                </span>
              ) : (
                <span class="invisible text-[10px] px-2.5 py-0.5">BADGE</span>
              )}
            </div>

            <div class="h-28 sm:h-32 md:h-36 w-full flex items-center justify-center my-2 p-1 overflow-visible">
              <Image 
                src={car.image} 
                alt={car.name}
                width={400}
                height={225}
                draggable="false"
                loading="lazy"
                decoding="async"
                class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300 drop-shadow-sm pointer-events-none select-none mx-auto"
              />
            </div>

            <div class="text-center pt-2 pb-1">
              <h3 class="text-xs sm:text-sm md:text-base font-black text-black group-hover:text-[#E60012] transition-colors uppercase tracking-wider leading-tight">
                {car.name}
              </h3>
              {car.segment !== 'commercial' && (
                <p class="text-[11px] sm:text-xs md:text-[13px] text-[#555] font-normal mt-1">
                  Mulai dari {car.startingPrice}
                </p>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-6 sm:mt-8 pt-2 sm:pt-4 flex items-center justify-between max-w-3xl mx-auto px-2 sm:px-4">
      <button 
        id="model-prev-btn" 
        type="button" 
        aria-label="Sebelumnya"
        class="group p-2 text-black hover:text-[#E60012] transition-colors"
      >
        <svg class="w-7 sm:w-10 h-7 sm:h-10 transition-transform group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m7-7l-7 7 7 7"/>
        </svg>
      </button>

      <a 
        href="/model" 
        class="text-[11px] sm:text-xs md:text-sm font-black uppercase tracking-[0.16em] sm:tracking-[0.2em] text-black border-b-2 border-black hover:text-[#E60012] hover:border-[#E60012] pb-1 transition-colors text-center"
      >
        BANDINGKAN KENDARAAN
      </a>

      <button 
        id="model-next-btn" 
        type="button" 
        aria-label="Selanjutnya"
        class="group p-2 text-black hover:text-[#E60012] transition-colors"
      >
        <svg class="w-7 sm:w-10 h-7 sm:h-10 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7l7 7-7 7"/>
        </svg>
      </button>
    </div>

  </div>
</section>

<script is:inline>
// Model carousel
const modelCarousel = document.getElementById('model-carousel');
const prevBtn = document.getElementById('model-prev-btn');
const nextBtn = document.getElementById('model-next-btn');

const filterBtns = document.querySelectorAll('.carousel-filter-btn');
const carouselCards = document.querySelectorAll('.model-carousel-card');

filterBtns.forEach((btn) => {
  btn.addEventListener('click', () => {
    const filter = btn.getAttribute('data-filter');
    filterBtns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    carouselCards.forEach((card) => {
      const seg = card.getAttribute('data-segment');
      if (seg === filter) {
        card.style.display = 'flex';
        card.style.opacity = '1';
      } else {
        card.style.display = 'none';
      }
    });

    if (modelCarousel) {
      modelCarousel.scrollTo({ left: 0, behavior: 'instant' });
    }
  });
});

if (modelCarousel && prevBtn && nextBtn) {
  const getScrollDistance = () => {
    const visibleCard = Array.from(carouselCards).find(c => c.style.display !== 'none');
    return visibleCard ? visibleCard.offsetWidth + 16 : 256;
  };

  prevBtn.addEventListener('click', () => {
    modelCarousel.scrollBy({ left: -getScrollDistance(), behavior: 'smooth' });
  });

  nextBtn.addEventListener('click', () => {
    modelCarousel.scrollBy({ left: getScrollDistance(), behavior: 'smooth' });
  });

  carouselCards.forEach((card) => {
    card.style.opacity = '1';
  });
}
</script>

<style>
  .carousel-filter-btn {
    color: #2B2E30;
    background-color: transparent;
    transition: all 0.2s ease;
  }
  .carousel-filter-btn:not(.active):hover {
    color: #E60012;
  }
  .carousel-filter-btn.active {
    background-color: #E60012 !important;
    color: #ffffff !important;
  }
  .carousel-filter-btn.active:hover {
    background-color: #d10010 !important;
    color: #ffffff !important;
  }
</style>
