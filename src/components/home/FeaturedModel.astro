---
import { Image } from 'astro:assets';
import { carsData } from '../../data/cars';

const defaultFeaturedCar = carsData.find(c => c.slug === 'pajero-sport') || carsData[0];
const featuredCarsJson = JSON.stringify(carsData.map(c => ({
  slug: c.slug,
  name: c.name,
  badge: c.badge || (c.segment === 'passenger' ? 'Bestseller' : c.category),
  image: c.image,
  tagline: c.tagline || c.description,
  price: c.startingPrice,
  isCommercial: c.segment === 'commercial',
  specs: [
    { label: 'Kapasitas', val: c.keySpecs.seating },
    { label: 'Mesin', val: c.keySpecs.engine },
    { label: 'Tenaga', val: c.keySpecs.power },
    { label: 'Transmisi', val: c.keySpecs.transmission },
  ]
})));
---

<!-- Featured Model -->
<section class="bg-white">
  <div class="max-w-[1440px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2">

      <div class="relative bg-white flex flex-col justify-between p-4 sm:p-6 md:p-8 lg:p-12 border-b lg:border-b-0 lg:border-r border-[#E3E5E6]">
        <div class="relative w-full h-56 sm:h-72 md:h-80 lg:h-[380px] flex items-center justify-center">
          <Image
            id="featured-img"
            src={defaultFeaturedCar.image}
            alt={defaultFeaturedCar.name}
            width={800}
            height={500}
            class="w-full h-full object-contain object-center hover:scale-105 transition-all duration-300"
            loading="eager"
            decoding="async"
          />
          <div class="absolute top-0 left-0">
            <span id="featured-badge" class="bg-[#E60012] text-white text-[9px] sm:text-[10px] font-black uppercase tracking-[0.15em] px-2.5 sm:px-3 py-1 sm:py-1.5">
              {defaultFeaturedCar.badge || 'Bestseller'}
            </span>
          </div>
        </div>

        <div class="mt-3 sm:mt-4 pt-3 sm:pt-4 border-t border-[#F0F0F0]">
          <span id="featured-car-label" class="block text-[10px] sm:text-[11px] font-bold text-[#686D71] tracking-[0.22em] uppercase mb-1.5 sm:mb-2">
            Pilih Kendaraan Favoritmu
          </span>
          <div class="relative z-30" id="featured-dropdown">
            <button
              type="button"
              id="featured-dropdown-trigger"
              class="w-full flex items-center justify-between border-b-2 border-black pb-2 pt-1 text-left bg-transparent cursor-pointer focus:outline-none transition-colors"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-labelledby="featured-car-label featured-dropdown-trigger"
            >
              <span id="featured-selected-name" class="text-[16px] sm:text-[18px] md:text-[20px] font-black tracking-tight text-black truncate pr-3">
                {defaultFeaturedCar.name}
              </span>
              <svg id="featured-dropdown-chevron" class="w-4 h-4 text-black transition-transform duration-200 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <div
              id="featured-dropdown-menu"
              class="hidden absolute left-0 right-0 top-full mt-2 bg-white border border-[#E3E5E6] shadow-2xl z-50 max-h-72 overflow-y-auto divide-y divide-[#F0F2F3]"
              role="listbox"
              tabindex="-1"
            >
              {carsData.map((car) => {
                const isSelected = car.slug === defaultFeaturedCar.slug;
                return (
                  <button
                    type="button"
                    class={`featured-dropdown-option w-full flex items-center justify-between px-3.5 sm:px-4 py-3 text-left transition-colors cursor-pointer hover:bg-[#F6F6F6] ${isSelected ? 'bg-[#FAFAFA] font-semibold' : ''}`}
                    data-slug={car.slug}
                    role="option"
                    aria-selected={isSelected ? 'true' : 'false'}
                  >
                    <div class="flex items-center gap-2 min-w-0 pr-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#E60012] flex-shrink-0 transition-opacity" style={isSelected ? 'opacity: 1;' : 'opacity: 0;'}></span>
                      <span class="text-[13px] sm:text-[14px] text-[#1F2421] truncate">{car.name}</span>
                    </div>
                    <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
                      {car.segment !== 'commercial' && (
                        <span class="text-[11px] sm:text-[12px] text-[#686D71] font-medium">Mulai {car.startingPrice}</span>
                      )}
                      <svg class="w-3.5 sm:w-4 h-3.5 sm:h-4 text-[#E60012] transition-opacity" style={isSelected ? 'opacity: 1;' : 'opacity: 0;'} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                  </button>
                );
              })}
            </div>
          </div>
        </div>
      </div>

      <div class="px-4 sm:px-8 md:px-16 py-8 sm:py-10 lg:py-16 flex flex-col justify-center space-y-5 sm:space-y-6">
        <div class="space-y-2">
          <div class="text-[10px] font-black uppercase tracking-[0.2em] text-[#E60012]">Model Unggulan</div>
          <h2 id="featured-title" class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-[#2B2E30] leading-tight">
            {defaultFeaturedCar.name}
          </h2>
          <p id="featured-desc" class="text-[#686D71] text-[13px] sm:text-[14px] leading-relaxed line-clamp-3">
            {defaultFeaturedCar.tagline || defaultFeaturedCar.description}
          </p>
        </div>

        <div class="grid grid-cols-2 gap-2 sm:gap-3" id="featured-specs-grid">
          <div class="border border-[#E3E5E6] p-2.5 sm:p-3.5">
            <div class="text-[9px] sm:text-[10px] text-[#686D71] uppercase tracking-wider">Kapasitas</div>
            <div id="featured-spec-0" class="text-[12px] sm:text-[13px] font-bold text-[#2B2E30] mt-0.5 truncate">{defaultFeaturedCar.keySpecs.seating}</div>
          </div>
          <div class="border border-[#E3E5E6] p-2.5 sm:p-3.5">
            <div class="text-[9px] sm:text-[10px] text-[#686D71] uppercase tracking-wider">Mesin</div>
            <div id="featured-spec-1" class="text-[12px] sm:text-[13px] font-bold text-[#2B2E30] mt-0.5 truncate">{defaultFeaturedCar.keySpecs.engine}</div>
          </div>
          <div class="border border-[#E3E5E6] p-2.5 sm:p-3.5">
            <div class="text-[9px] sm:text-[10px] text-[#686D71] uppercase tracking-wider">Tenaga</div>
            <div id="featured-spec-2" class="text-[12px] sm:text-[13px] font-bold text-[#2B2E30] mt-0.5 truncate">{defaultFeaturedCar.keySpecs.power}</div>
          </div>
          <div class="border border-[#E3E5E6] p-2.5 sm:p-3.5">
            <div class="text-[9px] sm:text-[10px] text-[#686D71] uppercase tracking-wider">Transmisi</div>
            <div id="featured-spec-3" class="text-[12px] sm:text-[13px] font-bold text-[#2B2E30] mt-0.5 truncate">{defaultFeaturedCar.keySpecs.transmission}</div>
          </div>
        </div>

        <div class="pt-1 sm:pt-2 space-y-3 sm:space-y-4">
          <div id="featured-price-row" class="flex items-baseline gap-2" style={defaultFeaturedCar.segment === 'commercial' ? 'display: none;' : ''}>
            <span class="text-[10px] sm:text-[11px] text-[#686D71]">OTR Jakarta Mulai</span>
            <span id="featured-price" class="text-xl sm:text-2xl font-black text-[#E60012]">{defaultFeaturedCar.startingPrice}</span>
          </div>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 sm:gap-3">
            <a
              id="featured-detail-btn"
              href={`/model/${defaultFeaturedCar.slug}`}
              class="inline-flex items-center justify-center border-2 border-black bg-white hover:bg-black text-black hover:text-white text-[12px] md:text-[13px] font-black uppercase tracking-[0.18em] px-6 sm:px-8 py-3 sm:py-3.5 transition-colors duration-200 text-center"
            >
              Selengkapnya
            </a>
            <a
              id="featured-compare-btn"
              href="/model"
              class="inline-flex items-center justify-center border-2 border-black bg-white hover:bg-black text-black hover:text-white text-[12px] md:text-[13px] font-black uppercase tracking-[0.18em] px-6 sm:px-8 py-3 sm:py-3.5 transition-colors duration-200 text-center"
            >
              Bandingkan Kendaraan
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
<script id="featured-cars-data" type="application/json" set:html={featuredCarsJson}></script>

<script is:inline>
const featDropdown = document.getElementById('featured-dropdown');
const featTrigger = document.getElementById('featured-dropdown-trigger');
const featMenu = document.getElementById('featured-dropdown-menu');
const featChevron = document.getElementById('featured-dropdown-chevron');
const featSelectedName = document.getElementById('featured-selected-name');
const featOptions = document.querySelectorAll('.featured-dropdown-option');
const featuredDataEl = document.getElementById('featured-cars-data');

function openFeatDropdown() {
  if (!featMenu || !featTrigger) return;
  const rect = featTrigger.getBoundingClientRect();
  const spaceBelow = window.innerHeight - rect.bottom;
  const spaceAbove = rect.top;

  if (spaceBelow < 280 && spaceAbove > spaceBelow) {
    featMenu.classList.remove('top-full', 'mt-2');
    featMenu.classList.add('bottom-full', 'mb-2');
  } else {
    featMenu.classList.remove('bottom-full', 'mb-2');
    featMenu.classList.add('top-full', 'mt-2');
  }

  featMenu.classList.remove('hidden');
  featTrigger.setAttribute('aria-expanded', 'true');
  featChevron?.classList.add('rotate-180');
}

function closeFeatDropdown() {
  if (!featMenu) return;
  featMenu.classList.add('hidden');
  featTrigger?.setAttribute('aria-expanded', 'false');
  featChevron?.classList.remove('rotate-180');
}

function toggleFeatDropdown() {
  if (featMenu?.classList.contains('hidden')) {
    openFeatDropdown();
  } else {
    closeFeatDropdown();
  }
}

if (featTrigger) {
  featTrigger.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleFeatDropdown();
  });

  featTrigger.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      openFeatDropdown();
    }
  });
}

document.addEventListener('click', (e) => {
  const target = e.target;
  if (featDropdown && !featDropdown.contains(target)) {
    closeFeatDropdown();
  }
});

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    closeFeatDropdown();
  }
});

if (featuredDataEl) {
  try {
    const carsList = JSON.parse(featuredDataEl.textContent || '[]');
    const carMap = new Map(carsList.map((c) => [c.slug, c]));

    const img = document.getElementById('featured-img');
    const badge = document.getElementById('featured-badge');
    const title = document.getElementById('featured-title');
    const desc = document.getElementById('featured-desc');
    const spec0 = document.getElementById('featured-spec-0');
    const spec1 = document.getElementById('featured-spec-1');
    const spec2 = document.getElementById('featured-spec-2');
    const spec3 = document.getElementById('featured-spec-3');
    const priceRow = document.getElementById('featured-price-row');
    const price = document.getElementById('featured-price');
    const detailBtn = document.getElementById('featured-detail-btn');
    const compareBtn = document.getElementById('featured-compare-btn');

    function selectFeaturedOption(slug) {
      const data = carMap.get(slug);
      if (!data) return;

      if (featSelectedName) featSelectedName.textContent = data.name;

      featOptions.forEach((btn) => {
        const isSelected = btn.getAttribute('data-slug') === slug;
        btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        btn.classList.toggle('bg-[#FAFAFA]', isSelected);
        btn.classList.toggle('font-semibold', isSelected);

        const dot = btn.querySelector('span.rounded-full');
        if (dot) dot.style.opacity = isSelected ? '1' : '0';

        const check = btn.querySelector('svg');
        if (check) check.style.opacity = isSelected ? '1' : '0';
      });

      closeFeatDropdown();

      if (img) {
        img.style.opacity = '0.2';
        img.style.transform = 'scale(0.97)';
        setTimeout(() => {
          img.src = data.image;
          img.alt = data.name;
          img.style.opacity = '1';
          img.style.transform = 'scale(1)';
        }, 150);
      }

      if (badge) badge.textContent = data.badge;
      if (title) title.textContent = data.name;
      if (desc) desc.textContent = data.tagline;
      if (spec0) spec0.textContent = (data.specs && data.specs[0] && data.specs[0].val) || '-';
      if (spec1) spec1.textContent = (data.specs && data.specs[1] && data.specs[1].val) || '-';
      if (spec2) spec2.textContent = (data.specs && data.specs[2] && data.specs[2].val) || '-';
      if (spec3) spec3.textContent = (data.specs && data.specs[3] && data.specs[3].val) || '-';
      if (priceRow) {
        if (data.isCommercial) {
          priceRow.style.display = 'none';
        } else {
          priceRow.style.display = 'flex';
          if (price) price.textContent = data.price;
        }
      }
      if (detailBtn) detailBtn.href = '/model/' + data.slug;
      if (compareBtn) compareBtn.href = '/model';
    }

    featOptions.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const slug = btn.getAttribute('data-slug') || '';
        selectFeaturedOption(slug);
      });
    });
  } catch (e) {
    console.error('Featured model update error:', e);
  }
}
</script>
